<div class="fr-p-2w dataservice-card fr-enlarge-link">
  <% if badge %>
    <div class="fr-grid-row fr-mt-n6v fr-mb-2w fr-ml-n1v">
      <p class="fr-badge fr-badge--sm fr-badge--no-icon <%= badge[:classe] %>">
        <span class="<%= badge[:icone] %> fr-icon--sm fr-mr-1v" aria-hidden="true"></span>
        <%= badge[:label] %>
      </p>
    </div>
  <% end %>
  <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--top">
    <% if datagouv_logo.present? %>
      <div class="fr-col-auto">
        <img src="<%= datagouv_logo %>" alt="" loading="lazy" class="dataservice-card__logo">
      </div>
    <% end %>
    <div class="fr-col">
      <%= content_tag @heading, class: "fr-text--md fr-mb-0" do %>
        <%= link_to titre, lien_datagouv, target: "_blank", rel: "noopener noreferrer",
              title: "#{titre} - ouvre une nouvelle fenêtre" %>
      <% end %>
      <% if producteur.present? %>
        <p class="fr-text--sm fr-mb-0 dataservice-card__org">
          <% if service_public? %><span class="fr-icon-bank-line fr-icon--sm" aria-hidden="true"></span><% end %>
          <%= producteur %>
          <% if certifiee? %><span class="fr-icon-checkbox-circle-line fr-icon--sm" title="Organisation certifiée par data.gouv.fr"></span><% end %>
        </p>
      <% end %>
    </div>
  </div>
  <div class="fr-grid-row fr-grid-row--right fr-mt-1w">
    <span class="fr-link fr-link--sm fr-icon-external-link-line fr-link--icon-right"><%= lien_label %></span>
  </div>
</div>
