<div class="demarche-card <%= content? ? 'demarche-card--liens' : 'fr-enlarge-link' %>">
  <div class="header-topic">
    <h3 class="title-topic fr-text--lead">
      <% if content? %>
        <%= helpers.avec_icone(@card[:icone], @card[:title]) %>
      <% else %>
        <%= link_to helpers.avec_icone(@card[:icone], @card[:title]), @card[:href], data: { matomo_action: "Ouvrir un cas d'usage", matomo_nom: @card[:nom] } %>
      <% end %>
    </h3>
    <% if @card[:description].present? %>
      <p class="fr-mb-1w"><%= @card[:description] %></p>
    <% end %>
  </div>
  <div class="description-topic">
    <%= render "application/public_vise", usagers: @card[:usagers], acteurs: @card[:acteurs],
                                          intro_usagers: "Démarche à destination des",
                                          intro_acteurs: { tous: "Gérée par", autres: "Gérée par les" } %>
    <% if content? %>
      <div class="demarche-card__liens"><%= content %></div>
    <% elsif @arrow %>
      <div class="card-arrow" aria-hidden="true"><span class="fr-icon-arrow-right-line"></span></div>
    <% end %>
  </div>
</div>
