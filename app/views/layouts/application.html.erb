<!DOCTYPE html>
<html lang="fr">
  <head>
    <% titre = content_for(:titre_seo).presence || safe_join([content_for(:title) || @article&.title, "Simplifions.data.gouv.fr"].compact, " | ")
       description = (CGI.unescapeHTML(content_for(:description).to_s).presence || @article&.description)&.truncate(155, separator: " ", omission: "…") ||
         "Simplifiez les démarches et services des citoyens, entreprises et associations en récupérant pour eux leurs informations administratives grâce aux API et aux données de l'État."
       canonical = response.not_found? ? request.original_url : url_for(only_path: false) %>
    <title><%= titre %></title>
    <meta name="description" content="<%= description %>">
    <% if content_for?(:robots) %>
      <meta name="robots" content="<%= content_for(:robots) %>">
    <% end %>
    <link rel="canonical" href="<%= canonical %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Simplifions.data.gouv.fr">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:title" content="<%= titre %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= canonical %>">
    <% if content_for?(:image) %>
      <meta property="og:image" content="<%= content_for(:image) %>">
    <% end %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Simplifions">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#000091">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.ico">

    <%= stylesheet_link_tag "dsfr", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "dsfr-utility", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "articles", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "demarches", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>

    <% if ENV["MATOMO_SITE_ID"].present? %>
      <script>
        var _paq = window._paq = window._paq || [];
        (function() {
          var urlPrecedente = document.referrer, rechercheMesuree, rechercheSoumise = true;
          addEventListener('submit', function(event) {
            if (event.target.matches('[data-matomo-catalogue]')) rechercheSoumise = true;
          }, true);
          function envoyerEvenement(element) {
            if (element.dataset.matomoAction) {
              _paq.push(['trackEvent', 'API et données', element.dataset.matomoAction, element.dataset.matomoNom]);
            }
          }
          addEventListener('click', function(event) {
            var bouton = event.target.closest && event.target.closest('button[data-matomo-action]');
            if (bouton && bouton.getAttribute('aria-expanded') !== 'true' && bouton.getAttribute('aria-pressed') !== 'true') {
              envoyerEvenement(bouton);
            }
          }, true);
          function mesurerClic(event) {
            var lien = event.target.closest && event.target.closest('a[href]');
            if (!lien || !/^https?:$/.test(lien.protocol)) return;
            envoyerEvenement(lien);
            if (/\.(pdf|csv|xlsx?|docx?|odt|ods|zip)$/i.test(lien.pathname)) {
              _paq.push(['trackLink', lien.href, 'download']);
            } else if (lien.host !== location.host) {
              _paq.push(['trackLink', lien.href, 'link']);
            }
          }
          addEventListener('click', mesurerClic, true);
          addEventListener('contextmenu', mesurerClic, true);
          addEventListener('auxclick', function(event) {
            if (event.button === 1) mesurerClic(event);
          }, true);
          addEventListener('turbo:load', function() {
            var catalogue = document.querySelector('[data-matomo-catalogue]');
            var motCle = ((catalogue && catalogue.dataset.matomoRecherche) || '').trim();
            if (urlPrecedente) _paq.push(['setReferrerUrl', urlPrecedente]);
            _paq.push(['setCustomUrl', location.origin + location.pathname]);
            var pageIntrouvable = document.querySelector('[data-matomo-erreur="404"]');
            _paq.push(['setDocumentTitle', pageIntrouvable ? '404/URL = ' + encodeURIComponent(location.pathname) + '/From = ' + encodeURIComponent(urlPrecedente) : document.title]);
            if (rechercheSoumise && motCle.length >= 2 && motCle !== rechercheMesuree) {
              rechercheMesuree = motCle;
              _paq.push(['trackSiteSearch', motCle, catalogue.dataset.matomoCatalogue, Number(catalogue.dataset.matomoResultats)]);
            } else {
              _paq.push(['trackPageView']);
            }
            urlPrecedente = location.href;
            rechercheSoumise = false;
          });
        })();
        (function() {
          var u = "https://stats.data.gouv.fr/";
          _paq.push(['setTrackerUrl', u + 'matomo.php']);
          _paq.push(['setSiteId', '<%= j ENV["MATOMO_SITE_ID"] %>']);
          var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
          g.async = true; g.src = u + 'matomo.js'; s.parentNode.insertBefore(g, s);
        })();
      </script>
    <% end %>
  </head>

  <body>
    <%= render "layouts/header" %>
    <main role="main" id="content">
      <% flash.each do |type, message| %>
        <div class="fr-container fr-mt-2w">
          <div class="fr-alert fr-alert--<%= type == "alert" ? "error" : "info" %> fr-alert--sm">
            <p><%= message %></p>
          </div>
        </div>
      <% end %>
      <%= yield %>
    </main>
    <%= render "layouts/footer" %>
  </body>
</html>
