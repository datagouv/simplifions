<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || @article&.title || "Simplifions" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Simplifions">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#000091">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% if (description = content_for(:description) || @article&.description) %>
      <meta name="description" content="<%= description %>">
    <% end %>
    <% if content_for?(:image) %>
      <meta property="og:image" content="<%= content_for(:image) %>">
    <% end %>
    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico">

    <%= stylesheet_link_tag "dsfr", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "dsfr-utility", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "articles", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "demarches", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "layouts/header" %>
    <main role="main" id="content">
      <%= yield %>
    </main>
    <%= render "layouts/footer" %>
  </body>
</html>
