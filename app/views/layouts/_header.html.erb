<header role="banner" class="fr-header">
  <div class="fr-header__body">
    <div class="fr-container">
      <div class="fr-header__body-row">
        <div class="fr-header__brand fr-enlarge-link">
          <div class="fr-header__brand-top">
            <div class="fr-header__logo">
              <p class="fr-logo">
                République
                <br>Française
              </p>
            </div>
            <div class="fr-header__navbar">
              <button type="button" class="fr-btn--menu fr-btn" data-fr-opened="false" aria-controls="modal-menu" aria-haspopup="menu" id="button-menu" title="Menu">
                Menu
              </button>
            </div>
          </div>
          <div class="fr-header__operator">
            <a href="/" title="Accueil — Simplifions.data.gouv.fr" style="display: flex; align-items: center; gap: 0.75rem;">
              <%= image_tag "simplifions/simplifions-logo.svg", class: "fr-responsive-img", style: "max-width: 12rem;", alt: "Simplifions.data" %>
              <span class="fr-badge fr-badge--sm fr-badge--green-emeraude">BETA</span>
            </a>
          </div>
        </div>
        <div class="fr-header__tools">
          <div class="fr-header__tools-links">
            <ul class="fr-btns-group">
              <li>
                <a class="fr-btn fr-btn--icon-right fr-icon-account-circle-line" href="#">Se connecter</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="fr-header__menu fr-modal" id="modal-menu" aria-labelledby="button-menu">
    <div class="fr-container">
      <button type="button" class="fr-btn--close fr-btn" aria-controls="modal-menu" title="Fermer">
        Fermer
      </button>
      <div class="fr-header__menu-links"></div>
      <nav class="fr-nav" role="navigation" aria-label="Menu principal">
        <ul class="fr-nav__list">
          <li class="fr-nav__item">
            <a class="fr-nav__link" href="/" target="_self" <%= 'aria-current="page"'.html_safe if current_page?(root_path) %>>Accueil</a>
          </li>
          <li class="fr-nav__item">
            <a class="fr-nav__link" href="#" target="_self">Cas d'usages</a>
          </li>
          <li class="fr-nav__item">
            <a class="fr-nav__link" href="<%= articles_path %>" target="_self" <%= 'aria-current="page"'.html_safe if request.path.start_with?("/articles") %>>Articles</a>
          </li>
          <li class="fr-nav__item">
            <a class="fr-nav__link" href="<%= about_path %>" target="_self" <%= 'aria-current="page"'.html_safe if current_page?(about_path) %>>À propos</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<div class="fr-notice fr-notice--info">
  <div class="fr-container">
    <div class="fr-notice__body">
      <p>
        <span class="fr-notice__title">Nouvelle version en construction.</span>
        <span class="fr-notice__desc">Ce site est la future version de simplifions.data.gouv.fr — les liens et boutons ne mènent nulle part pour le moment.</span>
      </p>
    </div>
  </div>
</div>
