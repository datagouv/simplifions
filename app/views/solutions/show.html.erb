<% fournisseurs = @solution.organisations.map(&:nom)
   operateur = fournisseurs.first
   usagers = @solution.vocabulaires.categorie_usager.map(&:nom)
   acteurs = @solution.types_acteurs.map(&:nom).sort
   utilisees = @solution.consommees.visibles.where.not(uid_datagouv: [nil, ''])
   fournies = @solution.exposees.visibles.where.not(uid_datagouv: [nil, ''])
   demarches = @solution.demarches_simplifiables.order(:nom)
   integratrices = @solution.integratrices_visibles.includes(:organisations, :vocabulaires)
   couvertures = @solution.couvertures
   nb_apis = Integration.consomme.en_production.where(integratrice: integratrices).group(:integratrice_id).count
   onglets = { 'logiciel_metier_cle_en_main' => 'Logiciels métiers',
               'brique_logicielle' => 'API, jeu de données ou brique logicielle',
               'site_de_consultation' => 'Sites de consultation' }
     .filter_map do |categorie, label|
       solutions = integratrices.select { |integratrice| integratrice.categorie == categorie }
       [categorie, label, solutions.sort_by { |sol| [-(nb_apis[sol.id] || 0), sol.nom] }] if solutions.any?
     end
   demarches_filtrables = couvertures.slice(*integratrices.map(&:id)).values.flat_map(&:keys).uniq.sort_by(&:nom)
   lien_datagouv = ->(donnee) {
     "https://www.data.gouv.fr/fr/#{donnee.categorie_base_de_donnees? ? 'datasets' : 'dataservices'}/#{donnee.uid_datagouv}"
   }
   sections = [['possibilites-simplification', 'Possibilités de simplification'],
               ['cas-usages-simplifiables', "Cas d'usages simplifiables"]]
   sections << ['donnees-api-utilisees', 'Données et API utilisées'] if utilisees.any?
   sections << (fournies.any? ? ['donnees-api-fournies', 'Données et API fournies'] : ['donnees-api', 'Données et API'])
   sections << ['solutions-integratices', 'Solutions intégratrices'] if integratrices.any? %>
<div class="fr-container fr-mt-1v">
  <nav role="navigation" class="fr-breadcrumb fr-mb-1v" aria-label="vous êtes ici :">
    <button class="fr-breadcrumb__button" aria-expanded="false" aria-controls="breadcrumb-solution">Voir le fil d'Ariane</button>
    <div class="fr-collapse" id="breadcrumb-solution">
      <ol class="fr-breadcrumb__list">
        <li><%= link_to "Accueil", root_path, class: "fr-breadcrumb__link" %></li>
        <li><a class="fr-breadcrumb__link" href="/solutions">Solutions</a></li>
        <li><a class="fr-breadcrumb__link" aria-current="page"><%= @solution.nom %></a></li>
      </ol>
    </div>
  </nav>
</div>

<div class="fr-container fr-mt-1w fr-mb-8w solution-page">
  <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--top">
    <div class="fr-col-12 fr-col-md-8">
      <div class="topic__header fr-mb-4v">
        <h1 class="fr-mb-1v fr-mr-2v"><%= @solution.nom %></h1>
        <% if operateur %>
          <p class="fr-badge fr-badge--sm fr-badge--no-icon <%= @solution.privee? ? 'fr-badge--green-tilleul-verveine' : 'fr-badge--blue-ecume' %>">
            <span class="font-weight-normal"><%= @solution.privee? ? 'Solution privée' : 'Solution publique' %> | <b><%= operateur %></b></span>
          </p>
        <% end %>
      </div>
      <p class="fr-text--lead"><%= @solution.description_courte %></p>

      <% if usagers.any? %>
        <div class="fr-card__detail">
          <p class="fr-mb-1w white-space-normal">Pour simplifier les démarches des <%= liste_humaine(usagers) %></p>
        </div>
      <% end %>
      <% if acteurs.any? %>
        <div class="fr-card__detail">
          <p class="fr-mb-1w white-space-normal">À destination <%= acteurs.first.start_with?("Tou") ? "de" : "des" %> <%= liste_humaine(acteurs) %></p>
        </div>
      <% end %>

      <ul class="fr-mt-4w">
        <li>
          <strong>Fournisseur : </strong>
          <%= fournisseurs.any? ? fournisseurs.to_sentence(two_words_connector: ' et ', last_word_connector: ' et ') : 'Non renseigné' %>
        </li>
      </ul>

      <ul class="solution-links fr-btns-group fr-btns-group--inline fr-my-4w">
        <% if @solution.site_internet %>
          <li><%= link_to "Site de la solution", @solution.site_internet, class: "fr-btn fr-btn--secondary", rel: "noopener noreferrer", target: "_blank" %></li>
        <% end %>
        <% if @solution.url_demande_acces %>
          <li><%= link_to "Demande d’accès", @solution.url_demande_acces, class: "fr-btn", rel: "noopener noreferrer", target: "_blank" %></li>
        <% end %>
      </ul>
      <% unless @solution.site_internet %>
        <p class="fr-text--sm"><i>Aucun lien vers un site officiel actuellement.</i></p>
      <% end %>
    </div>

    <div class="fr-col-12 fr-col-md-4">
      <nav role="navigation" aria-labelledby="fr-summary-title" class="fr-summary">
        <h2 id="fr-summary-title" class="fr-summary__title fr-text--md">Sommaire</h2>
        <ol>
          <% sections.each do |id, label| %>
            <li><a href="#<%= id %>" class="fr-summary__link"><%= label %></a></li>
          <% end %>
        </ol>
        <hr class="fr-hr fr-my-2w">
        <p class="fr-text--sm">
          <span class="subtitle">Contenu rédigé par :</span><br>
          <a href="https://www.data.gouv.fr/organizations/direction-interministerielle-du-numerique" rel="noopener external" target="_blank">Direction interministérielle du numérique</a>
          <% if @solution.cree_le %><br>le <time datetime="<%= @solution.cree_le.iso8601 %>"><%= l @solution.cree_le.to_date, format: :long %>.</time><% end %>
          <% if @solution.modifie_le %><br><span class="fr-text--xs">Modifié le <time datetime="<%= @solution.modifie_le.iso8601 %>"><%= l @solution.modifie_le.to_date, format: :long %>.</time></span><% end %>
        </p>
        <a href="#modification-contenu">✒️ Proposer une modification</a>
      </nav>
    </div>
  </div>

  <% if @solution.image.attached? %>
    <figure aria-label="© Légende de l'image" role="group" class="fr-content-media">
      <div class="example-image fr-content-media__img">
        <%= image_tag url_for(@solution.image), alt: @solution.legende_image.to_s, class: "fr-responsive-img fr-ratio-16x9" %>
      </div>
      <% if @solution.legende_image.present? %>
        <figcaption class="fr-content-media__caption"><%= @solution.legende_image %></figcaption>
      <% end %>
    </figure>
  <% else %>
    <hr class="fr-hr fr-my-2w">
  <% end %>

  <div class="fr-col-12 fr-col-md-8 fr-mb-4w">
    <h2 id="possibilites-simplification" class="colored-title fr-h2 fr-my-5w">Possibilités de simplification</h2>

    <h3 class="fr-text--lg fr-mt-2w"><span aria-hidden="true" class="fr-icon-success-fill icon-green"></span> Simplification par la donnée grâce à cette solution :</h3>
    <%= render 'contenu', texte: @solution.permet %>

    <h3 class="fr-text--lg fr-mt-2w"><span aria-hidden="true" class="fr-icon-stop-circle-fill icon-gray"></span> Périmètre de simplification non couvert :</h3>
    <%= render 'contenu', texte: @solution.ne_permet_pas %>

    <p class="fr-text--sm fr-mt-4w">
      <i>Une remarque concernant les possibilités de simplification de cette solution ? </i>
      <a href="#modification-contenu">✒️ Proposer un contenu</a>.
    </p>
  </div>

  <h2 id="cas-usages-simplifiables" class="colored-title fr-h2 fr-my-5w">Cas d'usages simplifiables</h2>
  <% if demarches.any? %>
    <div class="fr-grid-row fr-grid-row--gutters">
      <% demarches.each do |demarche| %>
        <div class="fr-col-12 fr-col-md-6 fr-col-lg-4 fr-mb-3w">
          <div class="fr-tile fr-tile--horizontal fr-enlarge-link">
            <div class="fr-tile__body">
              <div class="fr-tile__content">
                <h3 class="fr-tile__title"><%= link_to "#{demarche.icone} #{demarche.nom}".strip, demarche_path(demarche.slug) %></h3>
                <p class="fr-tile__detail"><%= demarche.description_courte %></p>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="fr-text--sm">
      <i>Aucun cas d'usage n'est référencé pour cette solution actuellement.</i>
      <a href="#modification-contenu">✒️ Proposer des cas d'usages</a>
    </p>
  <% end %>

  <% if utilisees.any? %>
    <div id="donnees-api-utilisees">
      <h2 class="colored-title fr-h2 fr-mt-8w">Données et API utilisées</h2>
      <ul class="fr-grid-row fr-grid-row--gutters list-none fr-pt-2w">
        <% utilisees.each do |donnee| %>
          <li class="fr-col-12 fr-py-0 fr-mb-2w"><%= render DataserviceCardComponent.new(api: { title: donnee.nom, url: lien_datagouv.call(donnee) }) %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if fournies.any? %>
    <div id="donnees-api-fournies">
      <h2 class="colored-title fr-h2 fr-mt-8w">Données et API fournies</h2>
      <ul class="fr-grid-row fr-grid-row--gutters list-none fr-pt-2w">
        <% fournies.each do |donnee| %>
          <li class="fr-col-12 fr-py-0 fr-mb-2w"><%= render DataserviceCardComponent.new(api: { title: donnee.nom, url: lien_datagouv.call(donnee) }) %></li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div id="donnees-api">
      <h2 class="colored-title fr-h2 fr-mt-8w">Données et API</h2>
      <p class="fr-text--sm">
        <i>Aucun jeu de données ou API utilisé ou fourni par cette solution actuellement.</i>
        <a href="#modification-contenu">✒️ Proposer un contenu</a>.
      </p>
    </div>
  <% end %>

  <% if integratrices.any? %>
    <div id="solutions-integratices" class="solutions-integratices-container fr-p-3w fr-mt-8w" data-controller="integratrices">
      <h2 class="colored-title fr-h2">Solutions intégrant "<%= @solution.nom %>"</h2>

      <% if integratrices.size > 1 %>
        <div class="fr-py-3w fr-mb-2w">
          <div class="fr-grid-row fr-grid-row--gutters">
            <div class="fr-col-12 fr-col-md-6">
              <div class="fr-select-group">
                <label for="filtre-cas-usage" class="fr-label">Cas d'usage :</label>
                <select id="filtre-cas-usage" class="fr-select" data-integratrices-target="casUsage" data-action="integratrices#filter">
                  <option value="">Tous les cas d'usages</option>
                  <% demarches_filtrables.each do |demarche| %>
                    <option value="<%= demarche.id %>"><%= demarche.nom %></option>
                  <% end %>
                </select>
              </div>
            </div>
            <div class="fr-col-12 fr-col-md-6">
              <div class="fr-select-group">
                <label for="filtre-nb-apis" class="fr-label">API ou jeux de données intégrés :</label>
                <select id="filtre-nb-apis" class="fr-select" data-integratrices-target="nbApis" data-action="integratrices#filter">
                  <option value="0">Tous</option>
                  <% (1..nb_apis.values.max.to_i).each do |nombre| %>
                    <option value="<%= nombre %>">Au moins <%= nombre %></option>
                  <% end %>
                </select>
              </div>
            </div>
          </div>
        </div>
        <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle">
          <div class="fr-col-12 fr-col-md-6">
            <p class="fr-text--bold fr-mb-0 fr-ml-2w" data-integratrices-target="compteur"><%= integratrices.size %> solutions disponibles</p>
          </div>
          <div class="fr-col-auto fr-grid-row fr-grid-row--middle fr-ml-auto">
            <div class="fr-select-group fr-grid-row fr-grid-row--middle">
              <label for="tri-integratrices" class="fr-label fr-col-auto fr-m-0 fr-mr-1w">Trier par :</label>
              <select id="tri-integratrices" class="fr-select fr-col" data-integratrices-target="tri" data-action="integratrices#filter">
                <option value="integration">Le plus de données intégrées</option>
                <option value="titre">Titre</option>
              </select>
            </div>
          </div>
        </div>
      <% end %>

      <p hidden class="fr-text--sm fr-text--center" data-integratrices-target="vide">
        <i>Aucune solution ne correspond aux filtres sélectionnés.</i>
      </p>

      <div class="fr-tabs fr-mt-4w">
        <ul class="fr-tabs__list" role="tablist" aria-label="Catégories de solutions intégratrices">
          <% onglets.each_with_index do |(categorie, label, solutions), index| %>
            <li role="presentation">
              <button type="button" id="tab-<%= categorie.dasherize %>" class="fr-tabs__tab" tabindex="<%= index.zero? ? 0 : -1 %>" role="tab"
                aria-selected="<%= index.zero? %>" aria-controls="tab-content-<%= categorie.dasherize %>"
                data-integratrices-target="onglet" data-libelle="<%= label %>"><%= label %> (<%= solutions.size %>)</button>
            </li>
          <% end %>
        </ul>
        <% onglets.each_with_index do |(categorie, _label, solutions), index| %>
          <div id="tab-content-<%= categorie.dasherize %>" class="fr-tabs__panel fr-tabs__panel--white <%= 'fr-tabs__panel--selected' if index.zero? %>"
            role="tabpanel" aria-labelledby="tab-<%= categorie.dasherize %>" tabindex="0">
            <ul class="fr-grid-row fr-grid-row--gutters list-none" data-integratrices-target="panneau">
              <% solutions.each do |integratrice| %>
                <li class="fr-col-12 fr-mb-2w" data-integratrices-target="carte"
                  data-demarches="<%= couvertures[integratrice.id].keys.map(&:id).join(' ') %>"
                  data-apis="<%= nb_apis[integratrice.id] || 0 %>" data-nom="<%= integratrice.nom %>">
                  <%= render 'solution_integratrice', solution: integratrice, couverture: couvertures[integratrice.id] %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div id="modification-contenu" class="bloc-modifications fr-mt-10w">
    <h2 class="fr-h6">✒️ Proposer une modification du contenu</h2>
    <p class="fr-mb-0">
      Pour proposer une modification du contenu de cette solution, vous pouvez compléter
      <a href="https://www.demarches-simplifiees.fr/commencer/proposer-un-contenu-pour-le-site-simplifions" rel="noopener external" target="_blank">ce formulaire</a>.
    </p>
  </div>
</div>
