<% content_for :titre_seo, @solution.titre_seo
   content_for :title, "Solution - #{@solution.nom}"
   content_for :description, @solution.chapo
   content_for :image, rails_blob_url(@solution.image) if @solution.image.attached?
   fournisseurs = @solution.organisations.map(&:nom)
   usagers = @solution.usagers
   acteurs = @solution.acteurs
   utilisees = @solution.consommees.visibles.sur_datagouv.load
   fournies = @solution.api_fournies_dans_l_ordre.visibles.sur_datagouv.load
   demarches = @solution.demarches_simplifiables
   couvertures = @solution.couvertures
   nb_apis = @solution.nb_donnees_integrees
   onglets = @solution.integratrices_par_categorie
   sections = [['possibilites-simplification', 'Possibilités de simplification'],
               ['cas-usages-simplifiables', "Cas d'usages simplifiables"]]
   sections << ['donnees-api-utilisees', 'Données et API utilisées'] if utilisees.any?
   sections << ['donnees-api-fournies', 'Données et API fournies'] if fournies.any?
   sections << ['donnees-api', 'Données et API'] if utilisees.empty? && fournies.empty?
   sections << ['solutions-integratices', 'Solutions intégratrices'] if onglets.any?
   lien_modification = contact_path("modifier-solution", solution: @solution.slug) %>
<div class="fr-container fr-mt-1v">
  <%= render "breadcrumb", id: "breadcrumb-solution",
        liens: [["Accueil", root_path], ["Solutions", solutions_path], [@solution.nom, nil]] %>
</div>

<div class="fr-container fr-mt-1w fr-mb-8w solution-page fiche-page" <%= tag.attributes(data: matomo_zone("Solution", @solution.nom)) %>>
  <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--top">
    <div class="fr-col-12 fr-col-md-8">
      <div class="topic__header">
        <h1 class="fr-mb-1v fr-mr-2v"><%= @solution.nom %></h1>
      </div>
      <div class="fr-mb-4v"><%= render "badge_operateur", solution: @solution %></div>
      <p class="fr-text--lead"><%= @solution.description_courte %></p>

      <%= render "public_vise", usagers:, acteurs: %>

      <ul class="fr-mt-4w">
        <li>
          <strong>Fournisseur : </strong>
          <%= fournisseurs.any? ? fournisseurs.to_sentence(two_words_connector: ' et ', last_word_connector: ' et ') : 'Non renseigné' %>
        </li>
      </ul>

      <ul class="solution-links fr-btns-group fr-btns-group--inline fr-my-4w" <%= tag.attributes(data: matomo_zone("Solution › En-tête")) %>>
        <% if @solution.site_internet %>
          <li><%= link_to "Site de la solution", @solution.site_internet, class: "fr-btn fr-btn--secondary", rel: "noopener noreferrer", target: "_blank",
                data: matomo_evenement("Ouvrir le site de la solution", @solution.nom, @solution) %></li>
        <% end %>
        <% if @solution.url_demande_acces %>
          <li><%= link_to "Demande d’accès", @solution.url_demande_acces, class: "fr-btn", rel: "noopener noreferrer", target: "_blank",
                data: matomo_evenement("Demander un accès", @solution.nom, @solution) %></li>
        <% end %>
      </ul>
      <% unless @solution.site_internet %>
        <p class="fr-text--sm"><i>Aucun lien vers un site officiel actuellement.</i></p>
      <% end %>
    </div>

    <div class="fr-col-12 fr-col-md-4">
      <%= render "sommaire", sections:, record: @solution %>
    </div>
  </div>

  <% if @solution.image.attached? %>
    <figure role="group" class="fr-content-media">
      <div class="example-image fr-content-media__img">
        <%= image_tag url_for(@solution.image), alt: @solution.legende_image.to_s, class: "fr-responsive-img fr-ratio-16x9" %>
      </div>
      <% if @solution.legende_image.present? %>
        <figcaption class="fr-content-media__caption"><%= @solution.legende_image %></figcaption>
      <% end %>
    </figure>
  <% else %>
    <hr class="fr-hr fr-my-2w">
  <% end %>

  <div class="fr-col-12 fr-col-md-8 fr-mb-4w">
    <%= render ArticleSectionComponent.new(id: 'possibilites-simplification', label: 'Possibilités de simplification') do %>
      <h3 class="fr-text--lg fr-mt-2w"><span aria-hidden="true" class="fr-icon-success-fill icon-green"></span> Simplification par la donnée grâce à cette solution :</h3>
      <%= render 'contenu', texte: @solution.permet %>

      <h3 class="fr-text--lg fr-mt-2w"><span aria-hidden="true" class="fr-icon-stop-circle-fill icon-gray"></span> Périmètre de simplification non couvert :</h3>
      <%= render 'contenu', texte: @solution.ne_permet_pas %>
    <% end %>
  </div>

  <%= render ArticleSectionComponent.new(id: 'cas-usages-simplifiables', label: "Cas d'usages simplifiables") do %>
    <% if demarches.any? %>
      <div class="fr-grid-row fr-grid-row--gutters" <%= tag.attributes(data: matomo_zone("Solution › Cas d'usages simplifiables")) %>>
        <% demarches.each do |demarche| %>
          <div class="fr-col-12 fr-col-md-6 fr-col-lg-4 fr-mb-3w">
            <div class="fr-tile fr-tile--horizontal fr-enlarge-link">
              <div class="fr-tile__body">
                <div class="fr-tile__content">
                  <h3 class="fr-tile__title"><%= link_to demarche.titre, demarche_path(demarche.slug),
                        data: { matomo_action: "Ouvrir un cas d'usage", matomo_nom: demarche.nom } %></h3>
                  <p class="fr-tile__detail"><%= demarche.description_courte %></p>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="fr-text--sm"><i>Aucun cas d'usage n'est référencé pour cette solution actuellement.</i></p>
    <% end %>
  <% end %>

  <% [['donnees-api-utilisees', 'Données et API utilisées', utilisees],
      ['donnees-api-fournies', 'Données et API fournies', fournies]].each do |id, titre, donnees| %>
    <% next if donnees.empty? %>
    <%= render ArticleSectionComponent.new(id:, label: titre) do %>
      <ul class="fr-grid-row fr-grid-row--gutters list-none fr-pt-2w" <%= tag.attributes(data: matomo_zone("Solution › #{titre}")) %>>
        <% donnees.each do |donnee| %>
          <li class="fr-col-12 fr-py-0 fr-mb-2w"><%= render DataserviceCardComponent.new(donnee) %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
  <% if utilisees.empty? && fournies.empty? %>
    <%= render ArticleSectionComponent.new(id: 'donnees-api', label: 'Données et API') do %>
      <p class="fr-text--sm"><i>Aucun jeu de données ou API utilisé ou fourni par cette solution actuellement.</i></p>
    <% end %>
  <% end %>

  <% if onglets.any? %>
    <div id="solutions-integratices" class="solutions-integratices-container fr-p-3w fr-mt-8w" data-controller="integratrices" data-matomo-section="Solutions intégratrices"
      <%= tag.attributes(data: matomo_zone("Solution › Intégratrices")) %>>
      <h2 class="fr-h2 article-section__title fr-mb-4w">Solutions intégrant "<%= @solution.nom %>"</h2>

      <% if @solution.integratrices_visibles.many? %>
        <div class="fr-py-3w fr-mb-2w">
          <div class="fr-grid-row fr-grid-row--gutters">
            <div class="fr-col-12 fr-col-md-6">
              <div class="fr-select-group">
                <label for="filtre-cas-usage" class="fr-label">Cas d'usage :</label>
                <select id="filtre-cas-usage" class="fr-select" data-integratrices-target="casUsage" data-action="integratrices#filter"
                  data-matomo-action="Filtrer par cas d'usage">
                  <option value="">Tous les cas d'usages</option>
                  <% couvertures.values.flat_map(&:keys).uniq.sort_by(&:nom).each do |demarche| %>
                    <option value="<%= demarche.id %>"><%= demarche.nom %></option>
                  <% end %>
                </select>
              </div>
            </div>
            <div class="fr-col-12 fr-col-md-6">
              <div class="fr-select-group">
                <label for="filtre-nb-apis" class="fr-label">API ou jeux de données intégrés :</label>
                <select id="filtre-nb-apis" class="fr-select" data-integratrices-target="nbApis" data-action="integratrices#filter"
                  data-matomo-action="Filtrer par nombre de données intégrées">
                  <option value="0">Tous</option>
                  <% (1..onglets.values.flatten.filter_map { |sol| nb_apis[sol.id] }.max.to_i).each do |nombre| %>
                    <option value="<%= nombre %>">Au moins <%= nombre %></option>
                  <% end %>
                </select>
              </div>
            </div>
          </div>
        </div>
        <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle">
          <div class="fr-col-12 fr-col-md-6">
            <% affichees = onglets.values.sum(&:size) %>
            <p class="fr-text--bold fr-mb-0 fr-ml-2w" role="status" data-integratrices-target="compteur"><%= affichees %> solution<%= 's' if affichees > 1 %> disponible<%= 's' if affichees > 1 %></p>
          </div>
          <div class="fr-col-auto fr-grid-row fr-grid-row--middle fr-ml-auto">
            <div class="fr-select-group fr-grid-row fr-grid-row--middle">
              <label for="tri-integratrices" class="fr-label fr-col-auto fr-m-0 fr-mr-1w">Trier par :</label>
              <select id="tri-integratrices" class="fr-select fr-col" data-integratrices-target="tri" data-action="integratrices#filter"
                data-matomo-action="Trier les solutions">
                <option value="integration">Le plus de données intégrées</option>
                <option value="titre">Titre</option>
              </select>
            </div>
          </div>
        </div>

        <p hidden class="fr-text--sm fr-text--center" data-integratrices-target="vide">
          <i>Aucune solution ne correspond aux filtres sélectionnés.</i>
        </p>
      <% end %>

      <div class="fr-tabs fr-mt-4w">
        <ul class="fr-tabs__list" role="tablist" aria-label="Catégories de solutions intégratrices">
          <% onglets.each_with_index do |(categorie, solutions), index| %>
            <% label = t("public.onglets_integratrices.#{categorie}") %>
            <li role="presentation">
              <button type="button" id="tab-<%= categorie.dasherize %>" class="fr-tabs__tab" tabindex="<%= index.zero? ? 0 : -1 %>" role="tab"
                aria-selected="<%= index.zero? %>" aria-controls="tab-content-<%= categorie.dasherize %>"
                data-integratrices-target="onglet" data-libelle="<%= label %>"
                data-matomo-action="Afficher un onglet" data-matomo-nom="<%= label %>"><%= label %> (<%= solutions.size %>)</button>
            </li>
          <% end %>
        </ul>
        <% onglets.each_with_index do |(categorie, solutions), index| %>
          <div id="tab-content-<%= categorie.dasherize %>" class="fr-tabs__panel fr-tabs__panel--white <%= 'fr-tabs__panel--selected' if index.zero? %>"
            role="tabpanel" aria-labelledby="tab-<%= categorie.dasherize %>" tabindex="0">
            <ul class="fr-grid-row fr-grid-row--gutters list-none" data-integratrices-target="panneau">
              <% solutions.each do |integratrice| %>
                <% couverture = couvertures[integratrice.id] || {} %>
                <li class="fr-col-12 fr-mb-2w" data-integratrices-target="carte"
                  data-demarches="<%= couverture.keys.map(&:id).join(' ') %>"
                  data-apis="<%= nb_apis[integratrice.id] || 0 %>" data-nom="<%= integratrice.nom %>">
                  <%= render "solutions/integratrice", integratrice:, couverture: %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<%= render "bloc_modification", sujet: "cette solution", lien: lien_modification %>
