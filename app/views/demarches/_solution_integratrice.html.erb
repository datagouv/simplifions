<% cible = recommandation.solution %>
<div class="solution-integratrice-card">
  <div class="solution-integratrice-card__header">
    <p class="solution-integratrice-card__title fr-text--lg fr-text--bold"><%= link_to_if solution.page_publique?, solution.nom, solution_path(solution.slug) %></p>
    <%= render "badge_operateur", solution: solution %>
  </div>
  <% if solution.types_solution.any? %>
    <p class="fr-text--sm fr-mb-0"><%= solution.types_solution.join(' • ') %></p>
  <% end %>
  <% if demarche.donnees_utiles.any? %>
    <% modale_id = "#{dom_id(recommandation)}_donnees_integrees_#{solution.id}" %>
    <div class="integration-indicator solution-integratrice-card__couverture fr-p-1w">
      <% if couverture %>
        <% jeu_de_donnees = cible.categorie_base_de_donnees? %>
        <%= render 'compteur', couverture: %>
        <% if couverture == [1, 1] %>
          <span class="fr-text--xs"><%= jeu_de_donnees ? 'Jeu de données intégré' : 'API intégrée' %></span>
        <% else %>
          <span class="fr-text--xs"><%= jeu_de_donnees ? 'jeux de données' : 'API' %> « <%= cible.nom %> »</span>
        <% end %>
      <% end %>
      <button type="button" class="solution-integratrice-card__oeil fr-btn fr-btn--sm fr-btn--tertiary-no-outline fr-icon-eye-line"
        aria-controls="<%= modale_id %>" data-fr-opened="false"
        title="Voir les données intégrées par <%= solution.nom %>">Voir les données intégrées par <%= solution.nom %></button>
      <p class="solution-integratrice-card__total fr-text--xs fr-text-mention--grey">
        <%= render 'compteur', couverture: demarche.couverture(solution), total: true %>
        <span>API ou jeux de données au total pour ce cas d’usage</span>
      </p>
    </div>
    <% content_for :modales_integrations do %>
      <%= render 'demarches/modale_integrations', modale_id:, solution:, recommandation:, couverture:, demarche:, lien_modification: %>
    <% end %>
  <% end %>
  <% if solution.page_publique? %>
    <p class="solution-integratrice-card__fiche fr-mb-0">
      <%= link_to solution_path(solution.slug), class: 'fr-link fr-icon-arrow-right-line fr-link--icon-right' do %>
        Voir la fiche<span class="fr-sr-only"> <%= solution.nom %></span>
      <% end %>
    </p>
  <% end %>
</div>
