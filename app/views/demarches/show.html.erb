<% content_for :titre_seo, @demarche.titre_seo
   content_for :title, "Cas d'usage - #{@demarche.titre}"
   content_for :description, @demarche.chapo
   usagers = @demarche.usagers
   acteurs = @demarche.acteurs
   par_categorie = @demarche.integratrices_par_categorie
   onglets = [['donnees-disponibles', 'Données disponibles et utiles', @demarche.recommandations_publiees.size],
              ['solutions-integratrices', 'Solutions ayant intégré ces données', par_categorie.values.sum(&:size)]]
   sections = [['contexte-et-cadre-juridique', 'Contexte et cadre juridique'],
               *onglets.first(par_categorie.any? ? 2 : 1).map { it.first(2) }]
   lien_modification = contact_path("modifier-cas-usage", demarche: @demarche.slug) %>
<div data-controller="affichage-personnalise" <%= tag.attributes(data: matomo_zone("Cas d'usage", @demarche.nom)) %>>
  <div data-affichage-personnalise-target="haut"></div>
  <div class="affichage-personnalise__entete" data-affichage-personnalise-target="entete">
    <div class="fr-container fr-pt-1v affichage-personnalise__fil">
      <%= render "breadcrumb", id: "breadcrumb-demarche",
            liens: [["Accueil", root_path], ["Cas d'usages", demarches_path], [@demarche.titre, nil]] %>
      <button type="button" class="fr-btn fr-btn--sm fr-btn--tertiary-no-outline fr-btn--icon-left fr-icon-filter-line fr-background-alt--blue-france fr-hidden"
        aria-expanded="true" aria-controls="affichage-personnalise" data-affichage-personnalise-target="bouton"
        data-matomo-action="Rouvrir l'affichage personnalisé">Affichage personnalisé<span data-affichage-personnalise-target="compteur"></span></button>
    </div>
    <div class="fr-collapse fr-collapse--expanded affichage-personnalise__bandeau" id="affichage-personnalise" data-affichage-personnalise-target="bandeau">
      <div class="fr-background-alt--blue-france">
        <div class="fr-container fr-py-2w">
          <p class="fr-text--bold fr-text-title--blue-france fr-mb-1w" id="affichage-personnalise-consigne">Affichez le contenu de cette page selon les solutions que vous recherchez :</p>
          <ul class="fr-tags-group fr-mb-0" aria-labelledby="affichage-personnalise-consigne" data-action="click->affichage-personnalise#afficher"
            <%= tag.attributes(data: matomo_zone("Cas d'usage › Affichage personnalisé")) %>>
            <% [['api', 'API et jeux de données'], ['logiciels', 'Logiciels métiers « clé en main »'], ['sites', 'Sites de consultation des données']].each do |filtre, libelle| %>
              <li><button type="button" class="fr-tag" aria-pressed="false" data-affichage-personnalise-target="tag" data-filtre="<%= filtre %>"
                data-matomo-action="Choisir un affichage" data-matomo-nom="<%= libelle %>"><%= libelle %></button></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="fr-container fr-mt-4w fr-mb-5w fiche-page">
    <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--top">
      <div class="fr-col-12 fr-col-md-8">
        <div class="topic__header fr-mb-4v">
          <h1 class="fr-mb-1v fr-mr-2v"><%= @demarche.titre %></h1>
        </div>
        <p class="fr-text--lead"><%= @demarche.description_courte %></p>

        <%= render "public_vise", usagers:, acteurs: %>
      </div>

      <div class="fr-col-12 fr-col-md-4">
        <%= render "sommaire", sections:, record: @demarche %>
      </div>
    </div>

    <div class="fr-col-12 fr-col-md-8 fr-mt-5w">
      <%= render ArticleSectionComponent.new(id: sections[0][0], label: sections[0][1]) do %>
        <%= render 'demarches/lire_plus', id: 'contexte-texte', titre: 'Contexte', icone: 'fr-icon-map-pin-2-fill',
              texte: @demarche.contexte %>
        <%= render 'demarches/lire_plus', id: 'cadre-juridique-texte', titre: 'Cadre juridique', icone: 'fr-icon-newspaper-fill',
              texte: @demarche.cadre_juridique %>
      <% end %>
    </div>
  </div>

  <div class="fr-tabs onglets-pleine-largeur">
    <ul class="fr-tabs__list" role="tablist" aria-label="Données et solutions de ce cas d'usage"
      <%= tag.attributes(data: matomo_zone("Cas d'usage › Onglets")) %>>
      <% onglets.each_with_index do |(id, label, nombre), index| %>
        <li role="presentation">
          <button type="button" id="onglet-<%= id %>" class="fr-tabs__tab" tabindex="<%= index.zero? ? 0 : -1 %>" role="tab"
            aria-selected="<%= index.zero? %>" aria-controls="<%= id %>" <%= 'disabled' if index.positive? && nombre.zero? %>
            data-matomo-action="Afficher un onglet" data-matomo-nom="<%= label %>"><%= label %> (<%= nombre %>)</button>
        </li>
      <% end %>
    </ul>
    <div id="donnees-disponibles" class="fr-tabs__panel fr-tabs__panel--selected" role="tabpanel"
      aria-labelledby="onglet-donnees-disponibles" tabindex="0">
      <div class="fr-container fiche-page">
        <h2 class="fr-sr-only"><%= onglets[0][1] %></h2>
        <%= render partial: 'demarches/recommandation', collection: @demarche.recommandations_publiees, as: :recommandation,
              locals: { lien_modification:, demarche: @demarche } %>
      </div>
    </div>
    <div id="solutions-integratrices" class="fr-tabs__panel fr-background-alt--blue-france" role="tabpanel"
      aria-labelledby="onglet-solutions-integratrices" tabindex="0">
      <div class="fr-container fiche-page">
        <h2 class="fr-sr-only"><%= onglets[1][1] %></h2>
        <%= render 'demarches/solutions_integratrices', demarche: @demarche, par_categorie:, lien_modification: %>
      </div>
    </div>
  </div>
</div>

<%= yield :modales_integrations %>

<%= render "bloc_modification", sujet: "cette démarche", lien: lien_modification %>
