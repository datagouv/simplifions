<% content_for :title, "Cas d'usage - #{@demarche.titre}"
   content_for :description, @demarche.chapo
   usagers = @demarche.usagers
   acteurs = @demarche.acteurs
   sections = [['contexte-et-cadre-juridique', 'Contexte et cadre juridique'],
               ['donnees-disponibles', 'Données disponibles']] %>
<div class="fr-container fr-mt-1v">
  <%= render "breadcrumb", id: "breadcrumb-demarche",
        liens: [["Accueil", root_path], ["Cas d'usages", demarches_path], [@demarche.titre, nil]] %>
</div>

<div class="fr-container fr-mt-1w fr-mb-8w fiche-page">
  <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--top">
    <div class="fr-col-12 fr-col-md-8">
      <div class="topic__header fr-mb-4v">
        <h1 class="fr-mb-1v fr-mr-2v"><%= @demarche.titre %></h1>
      </div>
      <p class="fr-text--lead"><%= @demarche.description_courte %></p>

      <%= render "public_vise", usagers:, acteurs: %>
    </div>

    <div class="fr-col-12 fr-col-md-4">
      <%= render "sommaire", sections:, record: @demarche %>
    </div>
  </div>

  <div class="fr-col-12 fr-col-md-8 fr-mt-5w">
    <%= render ArticleSectionComponent.new(id: sections[0][0], label: sections[0][1]) do %>
      <h3 class="fr-h6"><span aria-hidden="true" class="fr-icon-map-pin-2-fill"></span> Contexte</h3>
      <%= render 'contenu', texte: @demarche.contexte %>

      <h3 class="fr-h6"><span aria-hidden="true" class="fr-icon-newspaper-fill"></span> Cadre juridique</h3>
      <%= render 'contenu', texte: @demarche.cadre_juridique %>
    <% end %>
  </div>

  <div class="fr-mt-5w">
    <%= render ArticleSectionComponent.new(id: sections[1][0], label: sections[1][1]) do %>
      <%= render partial: 'recommandation',
            collection: @demarche.recommandations.visibles.niveau_2.includes(solution: [:exposees, :organisations]).order(:ordre),
            as: :recommandation %>
    <% end %>
  </div>

  <%= render "bloc_modification", sujet: "ce cas d'usage" %>
</div>
