<% content_for :title, "Cas d'usage - #{@demarche.titre}"
   content_for :description, @demarche.chapo
   usagers = @demarche.usagers
   acteurs = @demarche.acteurs
   par_categorie = @demarche.integratrices_par_categorie
   onglets = [['donnees-disponibles', 'Données disponibles et utiles', @demarche.recommandations_affichees.size],
              ['solutions-integratrices', 'Solutions ayant intégré ces données', par_categorie.values.sum(&:size)]]
   sections = [['contexte-et-cadre-juridique', 'Contexte et cadre juridique'],
               *onglets.first(par_categorie.any? ? 2 : 1).map { it.first(2) }] %>
<div class="affichage-personnalise" data-controller="affichage-personnalise">
  <div data-affichage-personnalise-target="haut"></div>
  <div class="affichage-personnalise__entete">
    <div class="fr-container fr-pt-1v affichage-personnalise__fil">
      <%= render "breadcrumb", id: "breadcrumb-demarche",
            liens: [["Accueil", root_path], ["Cas d'usages", demarches_path], [@demarche.titre, nil]] %>
      <button type="button" class="fr-btn fr-btn--sm fr-btn--tertiary-no-outline fr-btn--icon-left fr-icon-filter-line fr-hidden"
        aria-expanded="true" aria-controls="affichage-personnalise" data-affichage-personnalise-target="bouton">Affichage personnalisé</button>
    </div>
    <div class="fr-collapse fr-collapse--expanded affichage-personnalise__bandeau" id="affichage-personnalise"
      data-affichage-personnalise-target="bandeau">
      <div class="fr-background-alt--blue-france">
        <div class="fr-container fr-py-2w">
          <p class="fr-mb-1w" id="affichage-personnalise-consigne">Affichez le contenu de cette page selon les solutions que vous recherchez</p>
          <ul class="fr-tags-group" aria-labelledby="affichage-personnalise-consigne"
            data-action="click->affichage-personnalise#ouvrirLesAccordeonsApi">
            <% [['api', 'API et jeux de données'], ['logiciels', 'Logiciels métiers'], ['sites', 'Sites de consultation']].each do |filtre, libelle| %>
              <li><button type="button" class="fr-tag" aria-pressed="false" data-filtre-tag="<%= filtre %>"><%= libelle %></button></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="fr-container fr-mt-1w fr-mb-5w fiche-page">
    <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--top">
      <div class="fr-col-12 fr-col-md-8">
        <div class="topic__header fr-mb-4v">
          <h1 class="fr-mb-1v fr-mr-2v"><%= @demarche.titre %></h1>
        </div>
        <p class="fr-text--lead"><%= @demarche.description_courte %></p>

        <%= render "public_vise", usagers:, acteurs: %>
      </div>

      <div class="fr-col-12 fr-col-md-4">
        <%= render "sommaire", sections:, record: @demarche %>
      </div>
    </div>

    <div class="fr-col-12 fr-col-md-8 fr-mt-5w">
      <%= render ArticleSectionComponent.new(id: sections[0][0], label: sections[0][1]) do %>
        <h3 class="fr-h6"><span aria-hidden="true" class="fr-icon-map-pin-2-fill"></span> Contexte</h3>
        <%= render 'contenu', texte: @demarche.contexte %>

        <h3 class="fr-h6"><span aria-hidden="true" class="fr-icon-newspaper-fill"></span> Cadre juridique</h3>
        <%= render 'contenu', texte: @demarche.cadre_juridique %>
      <% end %>
    </div>
  </div>

  <div class="fr-tabs onglets-pleine-largeur">
    <ul class="fr-tabs__list" role="tablist" aria-label="Données et solutions de ce cas d'usage">
      <% onglets.each_with_index do |(id, label, nombre), index| %>
        <li role="presentation">
          <button type="button" id="onglet-<%= id %>" class="fr-tabs__tab" tabindex="<%= index.zero? ? 0 : -1 %>" role="tab"
            aria-selected="<%= index.zero? %>" aria-controls="<%= id %>" <%= 'disabled' if index.positive? && nombre.zero? %>><%= label %> (<%= nombre %>)</button>
        </li>
      <% end %>
    </ul>
    <div id="donnees-disponibles" class="fr-tabs__panel fr-tabs__panel--selected" role="tabpanel"
      aria-labelledby="onglet-donnees-disponibles" tabindex="0">
      <div class="fr-container fiche-page">
        <h2 class="fr-sr-only"><%= onglets[0][1] %></h2>
        <%= render partial: 'demarches/recommandation', collection: @demarche.recommandations_affichees, as: :recommandation %>
      </div>
    </div>
    <div id="solutions-integratrices" class="fr-tabs__panel" role="tabpanel"
      aria-labelledby="onglet-solutions-integratrices" tabindex="0">
      <div class="fr-container fiche-page">
        <h2 class="fr-sr-only"><%= onglets[1][1] %></h2>
        <%= render 'demarches/solutions_integratrices', demarche: @demarche, par_categorie: %>
      </div>
    </div>
  </div>

  <%= render partial: 'demarches/modale_integrations', collection: @demarche.integratrices, as: :solution,
        locals: { demarche: @demarche } %>

  <div class="fr-container fr-mt-5w fr-mb-8w fiche-page">
    <%= render "bloc_modification", sujet: "ce cas d'usage" %>
  </div>
</div>
