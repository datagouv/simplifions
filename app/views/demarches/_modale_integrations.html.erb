<% cible = recommandation&.solution
   jeu_de_donnees = cible&.categorie_base_de_donnees?
   integrees_par_la_solution = demarche.integrees_par(solution) %>
<dialog id="<%= modale_id %>" class="fr-modal" aria-labelledby="<%= modale_id %>_titre">
  <div class="fr-container fr-container--fluid fr-container-md">
    <div class="fr-grid-row fr-grid-row--center">
      <div class="fr-col-12 fr-col-md-8">
        <div class="fr-modal__body">
          <div class="fr-modal__header">
            <button type="button" class="fr-btn--close fr-btn" aria-controls="<%= modale_id %>" title="Fermer">Fermer</button>
          </div>
          <div class="fr-modal__content">
            <h2 id="<%= modale_id %>_titre" class="fr-modal__title fr-mb-1w"><%= link_to_if solution.page_publique?, solution.nom, solution_path(solution.slug),
                  data: matomo_fiche_solution(solution, 'démarche') %></h2>
            <%= render 'badge_operateur', solution: %>
            <div class="integration-indicator fr-p-1w fr-mt-2w">
              <%= render('compteur', couverture:) if couverture %>
              <div class="fr-text--sm">
                <% if couverture == [1, 1] %>
                  <p class="fr-text--sm fr-mb-2w"><b>« <%= cible.nom %> » est <%= jeu_de_donnees ? 'intégré' : 'intégrée' %> par cette solution</b>, utile pour la démarche « <%= titre_demarche(demarche) %> »</p>
                <% elsif couverture %>
                  <p class="fr-text--sm fr-mb-2w"><b><%= jeu_de_donnees ? 'jeux de données' : 'API' %> « <%= cible.nom %> » <%= jeu_de_donnees ? 'intégrés' : 'intégrées' %> par cette solution</b>, utiles pour la démarche « <%= titre_demarche(demarche) %> »</p>
                <% end %>
                <p class="fr-text--sm fr-mb-0">
                  Sur l’ensemble du cas d’usage :
                  <%= render 'compteur', couverture: demarche.couverture(solution), total: true %>
                  API et jeux de données utiles intégrés.
                </p>
              </div>
            </div>
            <% demarche.groupes_donnees_utiles.each do |bouquet, utiles, recommandations| %>
              <% titre = titre_groupe_donnees(bouquet) %>
              <details class="donnees-integrees fr-mt-3w" <%= 'open' if recommandation.nil? || utiles.intersect?(recommandation.donnees_attendues) %>>
                <summary class="fr-text--bold fr-mb-1w">
                  <span aria-hidden="true" class="donnees-integrees__fleche fr-icon-arrow-down-s-fill"></span>
                  <%= titre %>
                  <span class="fr-text--regular fr-text--sm fr-mb-0 fr-text-mention--grey">(<%= demarche.couverture_du_groupe(recommandations, solution).join('/') %>)</span>
                </summary>
                <ul class="fr-raw-list fr-pl-1v">
                  <% utiles.each do |donnee| %>
                    <% integree = integrees_par_la_solution.include?(donnee.id) %>
                    <% badge = DataserviceCardComponent.badge(donnee)
                       producteur = donnee.producteur
                       ligne = capture do %>
                      <span aria-hidden="true" class="fr-icon--sm <%= integree ? 'fr-icon-checkbox-circle-fill icon-green' : 'fr-icon-close-line' %>"></span>
                      <span><%= donnee.nom.delete_suffix(" | #{titre}") %><span class="fr-sr-only"><%= integree ? ' : intégrée' : ' : non intégrée' %></span></span>
                    <% end %>
                    <li class="fr-mb-1v <%= 'fr-text-mention--grey' unless integree %>">
                      <% if badge || producteur || donnee.uid_datagouv.present? %>
                        <details class="donnees-integrees">
                          <summary>
                            <%= ligne %>
                            <span aria-hidden="true" class="donnees-integrees__fleche fr-icon-arrow-down-s-line fr-icon--sm"></span>
                          </summary>
                          <div class="fr-ml-3w fr-mt-1v fr-mb-1w">
                            <% if badge || producteur %>
                              <p class="fr-text--xs fr-mb-1v">
                                <% if badge %><span class="fr-badge fr-badge--sm fr-badge--no-icon fr-mr-1w <%= badge[:classe] %>"><%= badge[:label] %></span><% end %>
                                <% if producteur %>Producteur : <%= producteur %><% end %>
                              </p>
                            <% end %>
                            <% if donnee.uid_datagouv.present? %>
                              <%= link_to donnee.lien_datagouv, class: 'fr-link fr-link--sm', target: '_blank', rel: 'noopener external',
                                    data: matomo_sortie_datagouv(donnee.nom, donnee, 'démarche', 'modale liste api par solution') do %>
                                Voir sur data.gouv.fr<span class="fr-sr-only"> <%= donnee.nom %> - nouvelle fenêtre</span>
                              <% end %>
                            <% end %>
                          </div>
                        </details>
                      <% else %>
                        <%= ligne %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </details>
            <% end %>
            <p class="fr-text--sm fr-mt-3w fr-mb-0">
              <span aria-hidden="true">✒️</span> Une information manque ou est erronée ? Vous pouvez
              <%= link_to lien_modification, target: '_blank', rel: 'noopener', title: 'proposer une modification du contenu - nouvelle fenêtre' do %>proposer une modification du contenu<span class="fr-sr-only"> - nouvelle fenêtre</span><% end %>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</dialog>
