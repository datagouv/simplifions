<% utiles = demarche.donnees_utiles %>
<div class="fr-table fr-table--bordered fr-table--multiline fr-table--no-caption fr-mt-1w vue-tableau">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table data-controller="tri-tableau">
          <caption><%= titre %></caption>
          <thead>
            <tr>
              <% [['nom', 'Solution', 'ascending', nil], ['integrees', 'Données intégrées', 'descending', 'descending']].each do |cle, libelle, ordre, tri| %>
                <th scope="col" <%= tag.attributes(aria: { sort: tri }) %>>
                  <div class="fr-cell--sort">
                    <span class="fr-cell__title"><%= libelle %></span>
                    <button type="button" class="fr-btn--sort fr-btn fr-btn--sm <%= 'fr-btn--sort-desc' if tri %>"
                      data-action="tri-tableau#trier" data-tri-tableau-cle-param="<%= cle %>" data-tri-tableau-ordre-param="<%= ordre %>"
                      title="Trier par <%= libelle.downcase %>">Trier par <%= libelle.downcase %></button>
                  </div>
                </th>
              <% end %>
              <% utiles.each do |utile| %>
                <th scope="col"><%= utile.solution.nom %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% solutions.each do |solution| %>
              <% integrees = demarche.donnees_integrees_par(solution) %>
              <tr data-nom="<%= solution.nom %>" data-integrees="<%= integrees.size %>">
                <th scope="row"><%= link_to_if solution.slug.present?, solution.nom, solution_path(solution.slug) %></th>
                <td><%= integrees.size %>/<%= utiles.size %></td>
                <% utiles.each do |utile| %>
                  <td class="fr-cell--center">
                    <% if utile.in?(integrees) %>
                      <span aria-hidden="true" class="fr-icon-checkbox-circle-fill fr-icon--sm icon-green"></span>
                      <span class="fr-sr-only">Intégrée</span>
                    <% else %>
                      <span aria-hidden="true" class="fr-icon-close-line fr-icon--sm fr-text-mention--grey"></span>
                      <span class="fr-sr-only">Non intégrée</span>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
