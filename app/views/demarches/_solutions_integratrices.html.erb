<% filtres = { logiciel_metier_cle_en_main: %w[logiciels fr-icon-mac-fill],
                brique_logicielle: %w[api fr-icon-code-box-fill],
                site_de_consultation: %w[sites fr-icon-seo-fill] } %>
<div data-controller="tri-solutions">
  <div class="fr-grid-row fr-grid-row--middle fr-mb-2w choix-affichage">
    <fieldset class="fr-segmented fr-segmented--sm fr-mr-2w">
      <legend class="fr-segmented__legend fr-sr-only">Affichage des solutions</legend>
      <div class="fr-segmented__elements">
        <% [%w[cartes Cartes fr-icon-layout-grid-line], ['tableau', 'Tableau comparatif', 'fr-icon-table-line']].each do |valeur, libelle, icone| %>
          <div class="fr-segmented__element">
            <input type="radio" id="affichage-solutions-<%= valeur %>" name="affichage-solutions" value="<%= valeur %>" autocomplete="off" <%= 'checked' if valeur == 'cartes' %>>
            <label class="fr-label <%= icone %>" for="affichage-solutions-<%= valeur %>"><%= libelle %></label>
          </div>
        <% end %>
      </div>
    </fieldset>
    <div class="fr-select-group fr-mb-0 tri-solutions">
      <label class="fr-label" for="tri-solutions-integratrices">Trier par :</label>
      <select class="fr-select" id="tri-solutions-integratrices" autocomplete="off" data-action="tri-solutions#trier">
        <option value="integrees" selected>Le plus de données intégrées</option>
        <option value="titre">Titre</option>
      </select>
    </div>
  </div>
  <% par_categorie.each do |categorie, solutions| %>
    <% filtre, icone = filtres.fetch(categorie)
       titre = t("public.solutions_integratrices.#{categorie}.titre") %>
    <section class="fr-mb-4w" data-filtre="<%= filtre %>" data-controller="section-depliable"
      data-action="affichage-personnalise:deplier->section-depliable#appliquer">
      <h3 class="fr-h5 fr-mb-1w">
        <button type="button" class="section-depliable__bouton" aria-expanded="true"
          aria-controls="solutions-integratrices-<%= categorie.to_s.dasherize %>"
          data-section-depliable-target="bouton" data-action="section-depliable#basculer">
          <span aria-hidden="true" class="section-depliable__fleche fr-icon-arrow-down-s-fill fr-icon--md"></span>
          <span class="section-depliable__libelle">
            <span class="section-depliable__titre"><%= titre %></span>
            <span class="fr-badge fr-badge--sm fr-badge--icon-left fr-background-contrast--info fr-text-default--info <%= icone %>">
              <%= t("public.moyens_acces.#{categorie}.nombre", count: solutions.size) %>
            </span>
            <% unless categorie == :brique_logicielle %>
              <span class="fr-badge fr-badge--sm fr-badge--new">Sans développement</span>
            <% end %>
          </span>
        </button>
      </h3>
      <div id="solutions-integratrices-<%= categorie.to_s.dasherize %>" data-section-depliable-target="contenu">
        <p class="fr-text--sm"><%= t("public.solutions_integratrices.#{categorie}.description") %></p>
        <ul class="fr-grid-row fr-grid-row--gutters fr-mt-1w list-none vue-cartes" data-tri-solutions-target="liste">
          <% solutions.each_with_index do |solution, ordre| %>
            <li class="fr-col-12 fr-col-sm-6 fr-col-lg-4 fr-col-xl-3" data-nom="<%= solution.nom %>" data-ordre="<%= ordre %>">
              <%= render 'solution_integratrice', solution:, recommandation: nil, couverture: nil, demarche:, lien_modification: %>
            </li>
          <% end %>
        </ul>
        <%= render 'tableau_integratrices', solutions:, demarche:, categorie:, titre: %>
      </div>
    </section>
  <% end %>
</div>
