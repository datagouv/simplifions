<%= render "entete_page", titre: "Organisations" %>

<div class="<%= conteneur_de_page %> fr-mb-6w">
  <h1>Organisations</h1>
  <%= link_to "Ajouter", new_admin_organisation_path, class: "fr-btn fr-mb-3w" %>
  <%= render layout: "recherche", locals: { total: @organisations.length } do %>
    <div class="fr-table">
      <table>
        <thead>
          <tr>
            <th>Id</th>
            <th>Nom court</th>
            <th>Nom long</th>
          </tr>
        </thead>
        <tbody>
          <% @organisations.each do |ligne| %>
            <tr>
              <td><%= ligne.id %></td>
              <td><%= link_to ligne.nom, edit_admin_organisation_path(ligne) %></td>
              <td><%= ligne.nom_long %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
