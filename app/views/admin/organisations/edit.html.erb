<%= render "entete_page", titre: "Modifier — Organisation" %>

<div class="fr-container fr-mb-6w">
  <h1>Organisation n°<%= @organisation.id %></h1>
  <%= render "form", organisation: @organisation %>
  <% en_base = Organisation.find(@organisation.id) %>
  <% privees = en_base.solutions_rendues_privees.order(:nom).pluck(:nom) %>
  <%= render "admin/supprimer", url: admin_organisation_path(en_base), nom: en_base.nom,
  consequences: [t("admin.suppression.solutions_privees", count: privees.size, noms: privees.join(", "))] %>
</div>
