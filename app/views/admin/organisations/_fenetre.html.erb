<%# locals: (organisation:) -%>
<%= render layout: "admin/dialogue", locals: { id: "nouvelle-organisation", titre: "Ajouter une organisation", ouverte: organisation.errors.any?, formulaire: "formulaire-nouvelle-organisation" } do %>
  <%= form_with model: [:admin, organisation], id: "formulaire-nouvelle-organisation", namespace: "nouvelle-organisation", html: { novalidate: true }, data: { enregistre_sur_place: true } do |f| %>
    <%= hidden_field_tag :sur_place, 1, id: nil %>
    <%= render "admin/organisations/champs", f: %>
  <% end %>
<% end %>
