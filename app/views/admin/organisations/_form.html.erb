<%= form_with model: [:admin, organisation], html: { novalidate: true }, class: "fr-mt-4w", data: surveille_les_modifications(organisation) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <%= groupe_de_champ(f, :nom) do |aria| %>
    <%= libelle_obligatoire(f, :nom) %>
    <%= f.text_field :nom, class: "fr-input", required: true, **aria %>
  <% end %>
  <div class="fr-input-group">
    <%= f.label :nom_long, class: "fr-label" %>
    <%= f.text_field :nom_long, class: "fr-input" %>
  </div>
  <fieldset class="fr-fieldset">
    <legend class="fr-fieldset__legend fr-fieldset__legend--regular">Public ou privé</legend>
    <% ["", *Organisation::PUBLIC_OU_PRIVE].each do |valeur| %>
      <div class="fr-fieldset__element fr-fieldset__element--inline">
        <div class="fr-radio-group">
          <%= f.radio_button :public_ou_prive, valeur %>
          <%= f.label :public_ou_prive, valeur.presence || "Non renseigné", value: valeur, class: "fr-label" %>
        </div>
      </div>
    <% end %>
  </fieldset>
  <div class="fr-input-group">
    <%= f.label :type_organisation_privee, class: "fr-label" %>
    <%= f.text_field :type_organisation_privee, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :site_internet, class: "fr-label" %>
    <%= f.text_field :site_internet, class: "fr-input" %>
  </div>
  <%= render "admin/identifiant_grist", grist_id: organisation.grist_id %>
  <fieldset class="fr-fieldset">
    <legend class="fr-fieldset__legend">Solutions</legend>
    <%= f.collection_check_boxes :solution_ids, Solution.order(:nom), :id, :nom do |b| %>
      <div class="fr-fieldset__element">
        <div class="fr-checkbox-group">
          <%= b.check_box %>
          <%= b.label(class: "fr-label") %>
        </div>
      </div>
    <% end %>
  </fieldset>
  <ul class="fr-btns-group fr-btns-group--inline">
    <li><button type="submit" class="fr-btn">Enregistrer</button></li>
    <li><%= link_to "Annuler", admin_organisations_path, class: "fr-btn fr-btn--secondary" %></li>
  </ul>
<% end %>
