<%= render "entete_page", titre: "Vocabulaire" %>

<div class="fr-container fr-mb-6w">
  <h1><%= nom_en_base %></h1>
  <dl class="fr-pl-0">
    <% {
      "Slug" => @vocabulaire.slug,
      "Catégorie" => Vocabulaire.human_attribute_name("categorie.#{@vocabulaire.categorie}"),
      "Démarches" => @vocabulaire.demarches.order(:nom).pluck(:nom).join(", "),
      "Solutions" => @vocabulaire.solutions.par_libelle_admin.map(&:libelle_admin).join(", ")
    }.each do |terme, valeur| %>
      <dt class="fr-text--bold fr-mb-0"><%= terme %></dt>
      <dd class="fr-ml-0 fr-pl-0 fr-mb-2w"><%= valeur.presence || "Non renseigné" %></dd>
    <% end %>
  </dl>
  <%= link_to "Modifier", edit_admin_vocabulaire_path(@vocabulaire), class: "fr-btn" %>
</div>
