<%= render "entete_page", titre: "Vocabulaires" %>

<div class="<%= conteneur_de_page %> fr-mb-6w">
  <h1>Vocabulaires</h1>
  <%= link_to "Ajouter", new_admin_vocabulaire_path, class: "fr-btn fr-mb-3w" %>
  <%= render layout: "recherche", locals: { total: @vocabulaires.total_count } do %>
    <div class="fr-table">
      <table>
        <thead>
          <tr>
            <th>Id</th>
            <th>Nom</th>
          </tr>
        </thead>
        <tbody>
          <% @vocabulaires.each do |ligne| %>
            <tr>
              <td><%= ligne.id %></td>
              <td><%= link_to ligne.nom, admin_vocabulaire_path(ligne) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <%= pagination @vocabulaires, %w[q] %>
</div>
