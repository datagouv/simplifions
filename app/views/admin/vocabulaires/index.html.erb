<%= render "entete_page", titre: "Vocabulaires" %>

<div class="fr-container fr-mb-6w">
  <h1>Vocabulaires</h1>
  <%= link_to "Ajouter", new_admin_vocabulaire_path, class: "fr-btn fr-mb-3w" %>
  <div class="fr-table">
    <table>
      <thead>
        <tr>
          <th>Id</th>
          <th>Nom</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @vocabulaires.each do |ligne| %>
          <tr>
            <td><%= ligne.id %></td>
            <td><%= ligne.nom %></td>
            <td>
              <%= link_to "Modifier", edit_admin_vocabulaire_path(ligne), class: "fr-link fr-mr-2w" %>
              <%= button_to "Supprimer", admin_vocabulaire_path(ligne), method: :delete, class: "fr-btn fr-btn--tertiary fr-btn--sm",
                form: { data: { turbo_confirm: "Supprimer la ligne #{ligne.id} ?" }, class: "fr-inline" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
