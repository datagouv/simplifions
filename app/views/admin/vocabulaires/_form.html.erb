<%= form_with model: [:admin, vocabulaire], html: { novalidate: true }, class: "fr-mt-4w", data: surveille_les_modifications(vocabulaire) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <%= f.dsfr_text_field :nom %>
  <%= f.dsfr_text_field :slug %>
  <%= f.dsfr_select :categorie, options_traduites(Vocabulaire, :categorie) %>
  <%= render "admin/identifiant_grist", grist_id: vocabulaire.grist_id %>
  <%= render "admin/cases_filtrables", f: f, attribut: :demarche_ids, collection: Demarche.order(:nom), libelle: :nom, legende: "Démarches" %>
  <%= render "admin/cases_filtrables", f: f, attribut: :solution_ids, collection: Solution.par_libelle_admin, libelle: :libelle_admin, legende: "Solutions" %>
  <ul class="fr-btns-group fr-btns-group--inline">
    <li><button type="submit" class="fr-btn">Enregistrer</button></li>
    <li><%= link_to "Annuler", admin_vocabulaires_path, class: "fr-btn fr-btn--secondary" %></li>
  </ul>
<% end %>
