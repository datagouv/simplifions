<%= form_with model: [:admin, vocabulaire], class: "fr-mt-4w", data: surveille_les_modifications(vocabulaire) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <%= groupe_de_champ(f, :nom) do |aria| %>
    <%= f.label :nom, class: "fr-label" %>
    <%= f.text_field :nom, class: "fr-input", **aria %>
  <% end %>
  <%= groupe_de_champ(f, :slug) do |aria| %>
    <%= f.label :slug, class: "fr-label" %>
    <%= f.text_field :slug, class: "fr-input", **aria %>
  <% end %>
  <%= groupe_de_champ(f, :categorie, "fr-select-group") do |aria| %>
    <%= f.label :categorie, class: "fr-label" %>
    <%= f.select :categorie, options_traduites(Vocabulaire, :categorie), { include_blank: true }, class: "fr-select", **aria %>
  <% end %>
  <%= render "admin/identifiant_grist", grist_id: vocabulaire.grist_id %>
  <fieldset class="fr-fieldset">
    <legend class="fr-fieldset__legend">Démarches</legend>
    <%= f.collection_check_boxes :demarche_ids, Demarche.order(:nom), :id, :nom do |b| %>
      <div class="fr-fieldset__element">
        <div class="fr-checkbox-group">
          <%= b.check_box %>
          <%= b.label(class: "fr-label") %>
        </div>
      </div>
    <% end %>
  </fieldset>
  <fieldset class="fr-fieldset">
    <legend class="fr-fieldset__legend">Solutions</legend>
    <%= f.collection_check_boxes :solution_ids, Solution.order(:nom), :id, :nom do |b| %>
      <div class="fr-fieldset__element">
        <div class="fr-checkbox-group">
          <%= b.check_box %>
          <%= b.label(class: "fr-label") %>
        </div>
      </div>
    <% end %>
  </fieldset>
  <ul class="fr-btns-group fr-btns-group--inline">
    <li><button type="submit" class="fr-btn">Enregistrer</button></li>
    <li><%= link_to "Annuler", admin_vocabulaires_path, class: "fr-btn fr-btn--secondary" %></li>
  </ul>
<% end %>
