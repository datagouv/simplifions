<%# locals: (lignes:) -%>
<% une = modele.model_name.human.downcase %>
<% des = modele.model_name.human(count: 2).downcase %>
<div class="<%= conteneur_de_page %> fr-mb-6w">
  <div class="fr-grid-row fr-grid-row--gutters fr-mt-1w">
    <nav class="fr-col-12 fr-col-md-4 fr-col-lg-3" aria-label="Liste des <%= des %>">
      <%= form_with url: url_for(action: :index), method: :get do |f| %>
        <div class="fr-search-bar" role="search">
          <%= f.label :q, "Rechercher une #{une}", class: "fr-label" %>
          <%= f.search_field :q, value: params[:q], class: "fr-input", placeholder: "Rechercher une #{une}" %>
          <button type="submit" class="fr-btn">Rechercher</button>
        </div>
        <div class="fr-select-group fr-mt-2w fr-mb-1w">
          <%= f.label :etat, "État", class: "fr-label" %>
          <%= f.select :etat, options_for_select([["Toutes", ""], %w[Publiées publiees], %w[Masquées masquees], ["En brouillon", "brouillons"]], params[:etat]), {}, class: "fr-select" %>
        </div>
        <button type="submit" class="fr-btn fr-btn--secondary fr-btn--sm fr-mb-2w">Filtrer</button>
      <% end %>
      <% if lignes.empty? && params[:q].present? %>
        <p class="fr-mb-1w" role="status"><%= t("admin.aucun_resultat.#{modele.model_name.i18n_key}", q: params[:q]) %></p>
        <%= link_to "Effacer la recherche", url_for(filtres_de_la_liste.except(:q)), class: "fr-link" %>
      <% else %>
        <p class="fr-text--sm fr-mb-1w" role="status"><%= lignes.size %> <%= lignes.size > 1 ? des : une %></p>
        <div class="liste-defilante">
          <ul>
            <% lignes.each do |ligne| %>
              <li><%= link_to render(ligne), polymorphic_path([:edit, :admin, ligne], **filtres_de_la_liste), aria: { current: ("page" if ligne == en_base) } %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <%= link_to "Ajouter une #{une}", url_for(action: :new, **filtres_de_la_liste), class: "fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-add-line fr-mt-2w" %>
    </nav>
    <div class="fr-col-12 fr-col-md-8 fr-col-lg-9">
      <% filtres_de_la_liste.each do |nom, valeur| %>
        <%= hidden_field_tag nom, valeur, id: nil, form: "formulaire-fiche" %>
      <% end %>
      <%= yield %>
    </div>
  </div>
</div>
