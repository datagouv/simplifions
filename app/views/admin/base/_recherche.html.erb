<%= form_with url: request.path, method: :get, class: "fr-mb-3w" do |f| %>
  <div class="fr-search-bar" role="search">
    <%= f.label :q, "Rechercher", class: "fr-label" %>
    <%= f.search_field :q, value: params[:q], class: "fr-input", placeholder: "Rechercher" %>
    <button type="submit" class="fr-btn">Rechercher</button>
  </div>
<% end %>
<% if total.zero? && params[:q].present? %>
  <p class="fr-mb-1w" role="status"><%= t("admin.aucun_resultat.#{modele.model_name.i18n_key}", q: params[:q]) %></p>
  <%= link_to "Effacer la recherche", request.path, class: "fr-link" %>
<% else %>
  <p class="fr-text--sm fr-mb-1w" role="status"><%= total %> ligne<%= "s" if total > 1 %></p>
  <%= yield %>
<% end %>
