<%# locals: (page_publique: nil, adresse: nil, previsualisation: nil, consequences: [], en_brouillon: nil, brouillon: en_base.try(:brouillon?), abandon: brouillon, badge_du_brouillon: nil) -%>
<div class="fr-grid-row fr-grid-row--gutters fr-mt-2w">
  <aside class="fr-col-12 fr-col-md-4 admin-panneau" aria-labelledby="etat-et-actions">
    <button type="submit" form="formulaire-fiche" hidden data-enregistrer>Enregistrer</button>
    <div class="fr-p-3w fr-background-alt--grey">
      <h2 id="etat-et-actions" class="fr-h6">État et actions</h2>
      <% if en_base.nil? && !modele.has_attribute?(:brouillon) %>
        <p class="fr-text--sm"><%= t("admin.sans_brouillon") %></p>
      <% end %>
      <% if en_base %>
        <% historique = admin_historique_path(modele.model_name.route_key, en_base) %>
        <% champ_visible = "#{modele.model_name.param_key}[visible]" %>
        <% if modele.has_attribute?(:visible) %>
          <div class="fr-grid-row fr-grid-row--middle fr-mb-1w">
            <p class="fr-badge fr-badge--no-icon fr-mr-1w <%= "fr-badge--success" if en_base.visible? %>"><%= en_base.visible? ? "Publiée" : "Masquée" %></p>
            <button type="submit" form="formulaire-fiche" name="<%= champ_visible %>" value="<%= en_base.visible? ? 0 : 1 %>" class="fr-btn fr-btn--sm fr-btn--secondary"><%= en_base.visible? ? "Masquer" : "Publier" %></button>
          </div>
        <% end %>
        <% if page_publique %>
          <%= render "admin/lien_nouvelle_fenetre", texte: "Voir la page publique", chemin: page_publique, titre: "Voir la page publique de #{nom_en_base}" %>
        <% elsif adresse %>
          <p class="fr-text--sm fr-mb-2w"><%= adresse %></p>
        <% end %>
        <%= tag.section class: "bloc-modifiable fr-p-2w", aria: { label: brouillon ? "Brouillon" : "Modifications" }, data: { cache_sans_modification: (true unless brouillon) } do %>
          <% if brouillon %>
            <div class="fr-grid-row fr-grid-row--middle fr-mb-1w">
              <%= badge_du_brouillon || tag.p(en_base.passe_par_un_brouillon? ? t("admin.badge_brouillon.#{modele.model_name.i18n_key}", default: "Brouillon non publié") : "Brouillon non publié", class: "fr-badge fr-badge--no-icon fr-badge--new fr-mr-1w") %>
              <% if (date = en_base.date_du_brouillon) %>
                <span class="fr-text--sm">depuis le <time datetime="<%= date.iso8601 %>"><%= l date, format: :court %></time></span>
              <% end %>
            </div>
            <% if previsualisation %>
              <%= render "admin/lien_nouvelle_fenetre", texte: "Prévisualiser le brouillon", chemin: previsualisation, titre: "Prévisualiser le brouillon de #{nom_en_base}" %>
            <% end %>
            <% if date && (import = en_base.import_grist_depuis_le_brouillon) %>
              <div class="fr-alert fr-alert--warning fr-alert--sm fr-mb-2w">
                <p>Le Grist a modifié cette fiche le <time datetime="<%= import.created_at.iso8601 %>"><%= l import.created_at, format: :court %></time> : publier remplacera ces changements.
                  <%= link_to "Voir l’historique", historique, class: "fr-link fr-link--sm" %></p>
              </div>
            <% end %>
            <% if en_brouillon.present? %>
              <p class="fr-text--sm fr-mb-1w"><%= en_brouillon %></p>
            <% end %>
          <% else %>
            <p class="fr-text--sm fr-mb-2w"><%= texte_sans_brouillon(en_base) %></p>
          <% end %>
          <ul class="fr-btns-group fr-btns-group--sm fr-mb-n2w">
            <li><button type="submit" form="formulaire-fiche" class="fr-btn" data-enregistrer>Enregistrer</button></li>
            <% if brouillon && modele.has_attribute?(:visible) && en_base.visible? %>
              <li><button type="submit" form="formulaire-fiche" name="<%= champ_visible %>" value="1" class="fr-btn fr-btn--secondary">Publier le brouillon</button></li>
            <% end %>
            <% if abandon %>
              <li><%= button_to "Abandonner le brouillon", [:abandonner_brouillon, :admin, en_base], method: :patch, class: "fr-btn fr-btn--tertiary bouton-destructif",
                  form: { data: { turbo_confirm: "Abandonner le brouillon de « #{nom_en_base} » ? Les modifications non publiées seront perdues." } } %></li>
            <% end %>
          </ul>
        <% end %>
        <%= render "admin/historique", ligne: en_base, chemin: historique,
              cree_le: modele.has_attribute?(:cree_le) ? en_base.cree_le : en_base.created_at,
              modifie_le: modele.has_attribute?(:modifie_le) ? en_base.modifie_le : en_base.updated_at %>
        <ul class="fr-btns-group fr-btns-group--sm fr-mt-3w">
          <li><%= button_to t("admin.supprimer_la_fiche.#{modele.model_name.i18n_key}"), [:admin, en_base], method: :delete, class: "fr-btn fr-btn--tertiary bouton-destructif",
              form: { data: { turbo_confirm: ["Supprimer « #{nom_en_base} » ?", *consequences.compact_blank].join(" ") } } %></li>
        </ul>
      <% else %>
        <ul class="fr-btns-group fr-btns-group--sm">
          <li><button type="submit" form="formulaire-fiche" class="fr-btn" data-enregistrer>Enregistrer</button></li>
          <% if modele.has_attribute?(:visible) %>
            <li><button type="submit" form="formulaire-fiche" name="<%= modele.model_name.param_key %>[visible]" value="1" class="fr-btn fr-btn--secondary">Publier</button></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </aside>
  <div class="fr-col-12 fr-col-md-8">
    <%= yield %>
  </div>
</div>
