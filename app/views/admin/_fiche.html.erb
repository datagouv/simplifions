<%# locals: (page_publique: nil, previsualisation: nil, consequences: [], en_brouillon: nil) -%>
<div class="fr-grid-row fr-grid-row--gutters fr-mt-2w">
  <aside class="fr-col-12 fr-col-md-4 admin-panneau" aria-labelledby="etat-et-actions">
    <div class="fr-p-3w fr-background-alt--grey">
      <h2 id="etat-et-actions" class="fr-h6">État et actions</h2>
      <% if en_base %>
        <% historique = admin_historique_path(modele.model_name.route_key, en_base) %>
        <% if modele.has_attribute?(:visible) %>
          <p class="fr-badge fr-badge--no-icon <%= "fr-badge--success" if en_base.visible? %>"><%= en_base.visible? ? "Publiée" : "Masquée" %></p>
        <% end %>
        <% if en_base.try(:brouillon?) %>
          <p class="fr-badge fr-badge--no-icon fr-badge--new"><%= en_base.passe_par_un_brouillon? ? t("admin.badge_brouillon.#{modele.model_name.i18n_key}", default: "Brouillon non publié") : "Brouillon non publié" %></p>
          <% if (date = en_base.date_du_brouillon) %>
            <p class="fr-text--sm fr-mt-1w fr-mb-0">Brouillon du <time datetime="<%= date.iso8601 %>"><%= l date, format: :court %></time></p>
            <% if (import = en_base.import_grist_depuis_le_brouillon) %>
              <div class="fr-alert fr-alert--warning fr-alert--sm fr-mt-1w">
                <p>Le Grist a modifié cette fiche le <time datetime="<%= import.created_at.iso8601 %>"><%= l import.created_at, format: :court %></time> : publier remplacera ces changements.
                  <%= link_to "Voir l’historique", historique, class: "fr-link fr-link--sm" %></p>
              </div>
            <% end %>
          <% end %>
        <% end %>
        <% if en_brouillon.present? %>
          <p class="fr-text--sm fr-mt-1w fr-mb-0"><%= en_brouillon %></p>
        <% end %>
        <dl class="fr-pl-0 fr-mt-2w fr-text--sm">
          <% { "Création" => modele.has_attribute?(:cree_le) ? en_base.cree_le : en_base.created_at,
               "Dernière modification" => modele.has_attribute?(:modifie_le) ? en_base.modifie_le : en_base.updated_at }.compact.each do |terme, date| %>
            <dt class="fr-text--bold fr-mb-0"><%= terme %></dt>
            <dd class="fr-ml-0 fr-pl-0 fr-mb-1w"><time datetime="<%= date.iso8601 %>"><%= l date.to_date %></time></dd>
          <% end %>
        </dl>
        <% if (version = en_base.versions.last) %>
          <p class="fr-text--sm fr-mb-1w"><%= titre_de_version(version, version.event == "create" ? "Créée" : "Modifiée") %></p>
          <p class="fr-text--sm"><%= link_to "Historique", historique, class: "fr-link fr-link--sm" %></p>
        <% end %>
        <% if en_base.grist_id.present? %>
          <p class="fr-text--sm">Identifiant Grist : <%= en_base.grist_id %></p>
        <% end %>
      <% end %>
      <ul class="fr-btns-group fr-btns-group--sm">
        <li><button type="submit" form="formulaire-fiche" class="fr-btn" data-enregistrer>Enregistrer</button></li>
        <% if modele.has_attribute?(:visible) %>
          <% publiee = en_base&.visible? %>
          <% if !publiee || modele.has_attribute?(:brouillon) %>
            <li><button type="submit" form="formulaire-fiche" name="<%= modele.model_name.param_key %>[visible]" value="1" class="fr-btn fr-btn--secondary">Publier</button></li>
          <% end %>
          <% if publiee %>
            <li><button type="submit" form="formulaire-fiche" name="<%= modele.model_name.param_key %>[visible]" value="0" class="fr-btn fr-btn--secondary">Masquer</button></li>
          <% end %>
        <% end %>
        <li><%= link_to "Annuler", url_for(action: :index), class: "fr-btn fr-btn--tertiary" %></li>
        <% if en_base.try(:brouillon?) %>
          <li><%= button_to "Abandonner le brouillon", [:abandonner_brouillon, :admin, en_base], method: :patch, class: "fr-btn fr-btn--tertiary",
              form: { data: { turbo_confirm: "Abandonner le brouillon de « #{nom_en_base} » ? Les modifications non publiées seront perdues." } } %></li>
        <% end %>
        <% if en_base %>
          <li><%= button_to "Supprimer", [:admin, en_base], method: :delete, class: "fr-btn fr-btn--tertiary",
              form: { data: { turbo_confirm: ["Supprimer « #{nom_en_base} » ?", *consequences.compact_blank].join(" ") } } %></li>
        <% end %>
      </ul>
      <% if page_publique %>
        <p class="fr-mb-0"><%= link_to page_publique, class: "fr-link", target: "_blank", rel: "noopener", title: "Voir la page publique de #{nom_en_base} - nouvelle fenêtre" do %>Voir la page publique<span class="fr-sr-only"> - nouvelle fenêtre</span><% end %></p>
      <% end %>
      <% if previsualisation %>
        <p class="fr-mb-0"><%= link_to previsualisation, class: "fr-link", target: "_blank", rel: "noopener", title: "Prévisualiser le brouillon de #{nom_en_base} - nouvelle fenêtre" do %>Prévisualiser<span class="fr-sr-only"> le brouillon - nouvelle fenêtre</span><% end %></p>
      <% end %>
    </div>
  </aside>
  <div class="fr-col-12 fr-col-md-8">
    <%= yield %>
  </div>
</div>
