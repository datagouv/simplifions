<%# locals: (f:, categories: Vocabulaire.categories.keys, legende: "Vocabulaires") -%>
<fieldset class="fr-fieldset">
  <legend class="fr-fieldset__legend"><%= legende %></legend>
  <% options_traduites(Vocabulaire, :categorie).each do |legende_de_categorie, categorie| %>
    <% next unless categorie.in?(categories) %>
    <div class="fr-fieldset__element">
      <fieldset class="fr-fieldset">
        <legend class="fr-fieldset__legend fr-text--regular"><%= legende_de_categorie %></legend>
        <%= f.collection_check_boxes :vocabulaire_ids, Vocabulaire.where(categorie:).order(:id), :id, :nom do |b| %>
          <div class="fr-fieldset__element fr-col-12 fr-col-sm-6 fr-col-lg-4 fr-grid-row fr-grid-row--middle case-avec-aide">
            <div class="fr-checkbox-group">
              <%= b.check_box %>
              <%= b.label(class: "fr-label") %>
            </div>
            <%= lien_d_aide(b.object, b.text) %>
          </div>
        <% end %>
      </fieldset>
    </div>
  <% end %>
</fieldset>
