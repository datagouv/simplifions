<%# locals: (ligne:, cote:) -%>
<% id = ligne.persisted? ? dom_id(ligne) : dom_id(Integration, cote) %>
<%= form_with model: [:admin, ligne], id: "formulaire_#{id}", data: { enregistre_sur_place: true } do |f| %>
  <%= hidden_field_tag :ligne, 1, id: nil %>
  <%= hidden_field_tag :cote, cote, id: nil %>
  <%= f.hidden_field cote == :integree ? :integratrice_id : :integree_id, id: nil if ligne.new_record? %>
<% end %>
<% if ligne.persisted? %>
  <%= form_with model: [:admin, ligne], method: :delete, id: "suppression_#{id}", data: { enregistre_sur_place: true } do %>
    <%= hidden_field_tag :ligne, 1, id: nil %>
  <% end %>
<% end %>
