<%# locals: (ligne:, liste:) -%>
<% id = ligne.persisted? ? dom_id(ligne) : dom_id(Integration, liste) %>
<%= form_with model: [:admin, ligne], id: "formulaire_#{id}", data: { enregistre_sur_place: true } do |f| %>
  <%= hidden_field_tag :ligne, 1, id: nil %>
  <%= hidden_field_tag :liste, liste, id: nil %>
  <%= f.hidden_field :"#{colonne_fixe_de_la_liste(liste)}_id", id: nil if ligne.new_record? %>
<% end %>
<% if ligne.persisted? %>
  <%= form_with model: [:admin, ligne], method: :delete, id: "suppression_#{id}", data: { enregistre_sur_place: true } do %>
    <%= hidden_field_tag :ligne, 1, id: nil %>
  <% end %>
<% end %>
