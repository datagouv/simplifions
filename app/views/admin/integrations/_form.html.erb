<% solutions = Solution.par_libelle_admin.map { |solution| [solution.libelle_admin, solution.id] } %>
<%= form_with model: [:admin, integration], id: "formulaire-fiche", html: { novalidate: true }, data: surveille_les_modifications(integration) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <%= f.dsfr_select :integree_id, solutions do %>
    <%= lien_vers_la_fiche(integration.integree, integration.integree.libelle_admin) if integration.integree %>
  <% end %>
  <%= f.dsfr_select :integratrice_id, solutions do %>
    <%= lien_vers_la_fiche(integration.integratrice, integration.integratrice.libelle_admin) if integration.integratrice %>
  <% end %>
  <%= f.dsfr_select :type_integration, options_traduites(Integration, :type_integration) %>
  <%= f.dsfr_select :statut, Integration::STATUTS %>
  <% demarches = integration.demarches_proposees.order(:nom).load %>
  <% autorisees = integration.demarches_autorisees.ids %>
  <% if demarches.any? %>
    <%= render "admin/cases_filtrables", f: f, attribut: :demarche_ids, collection: demarches, libelle: ->(demarche) { libelle_hors_regle(demarche.nom, autorisees.include?(demarche.id)) }, legende: "Démarches" %>
  <% else %>
    <%= hidden_field_tag "integration[demarche_ids][]", "" %>
    <p class="fr-hint-text">Démarches : à cocher une fois l’API ou le jeu de données enregistré, parmi les démarches qui le recommandent.</p>
  <% end %>
<% end %>
