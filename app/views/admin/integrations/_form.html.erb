<% solutions = Solution.par_libelle_admin %>
<%= form_with model: [:admin, integration], html: { novalidate: true }, class: "fr-mt-4w", data: surveille_les_modifications(integration) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <%= groupe_de_champ(f, :integree_id, "fr-select-group") do |aria| %>
    <%= libelle_obligatoire(f, :integree_id) %>
    <%= f.collection_select :integree_id, solutions, :id, :libelle_admin, { include_blank: true }, class: "fr-select", required: true, **aria %>
    <%= lien_vers_la_fiche(integration.integree, integration.integree.libelle_admin) if integration.integree %>
  <% end %>
  <%= groupe_de_champ(f, :integratrice_id, "fr-select-group") do |aria| %>
    <%= libelle_obligatoire(f, :integratrice_id) %>
    <%= f.collection_select :integratrice_id, solutions, :id, :libelle_admin, { include_blank: true }, class: "fr-select", required: true, **aria %>
    <%= lien_vers_la_fiche(integration.integratrice, integration.integratrice.libelle_admin) if integration.integratrice %>
  <% end %>
  <%= groupe_de_champ(f, :type_integration, "fr-select-group") do |aria| %>
    <%= libelle_avec_aide(f, :type_integration, "Fournie : la solution met l’API ou le jeu de données à disposition. Intégrée : la solution l’utilise.", obligatoire: true) %>
    <%= f.select :type_integration, options_traduites(Integration, :type_integration), { include_blank: true }, class: "fr-select", required: true, **aria %>
  <% end %>
  <%= groupe_de_champ(f, :statut, "fr-select-group") do |aria| %>
    <%= f.label :statut, class: "fr-label" %>
    <%= f.select :statut, Integration::STATUTS, { include_blank: true }, class: "fr-select", **aria %>
  <% end %>
  <%= render "admin/identifiant_grist", grist_id: integration.grist_id %>
  <%= render "admin/cases_filtrables", f: f, attribut: :demarche_ids, collection: Demarche.order(:nom), libelle: :nom, legende: "Démarches" %>
  <ul class="fr-btns-group fr-btns-group--inline">
    <li><button type="submit" class="fr-btn">Enregistrer</button></li>
    <li><%= link_to "Annuler", admin_integrations_path, class: "fr-btn fr-btn--secondary" %></li>
  </ul>
<% end %>
