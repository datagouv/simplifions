<%= render "entete_page", titre: "Intégrations" %>

<div class="fr-container fr-mb-6w">
  <h1>Intégrations</h1>
  <%= link_to "Ajouter", new_admin_integration_path, class: "fr-btn fr-mb-3w" %>
  <%= render "recherche", total: @integrations.total_count %>
  <div class="fr-table">
    <table>
      <thead>
        <tr>
          <th>Id</th>
          <th>Intégratrice</th>
          <th>Intégrée</th>
          <th>Type</th>
          <th>Statut</th>
        </tr>
      </thead>
      <tbody>
        <% @integrations.each do |ligne| %>
          <tr>
            <td><%= ligne.id %></td>
            <td><%= link_to ligne.integratrice.libelle_admin, edit_admin_integration_path(ligne), aria: { label: ligne.libelle } %></td>
            <td><%= ligne.integree.libelle_admin %></td>
            <td><%= ligne.type_libelle %></td>
            <td><%= ligne.statut %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= pagination @integrations, %w[q] %>
</div>
