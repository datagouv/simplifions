<%# locals: (objet:, onglets:, onglet_des_erreurs: {}) -%>
<% actif = onglet_ouvert(objet, onglets.keys, onglet_des_erreurs) %>
<div class="fr-tabs fr-mt-2w" data-controller="onglets" data-action="dsfr.disclose->onglets#choisir">
  <%= hidden_field_tag :onglet, actif, id: nil, data: { onglets_target: "champ" } %>
  <ul class="fr-tabs__list" role="tablist" aria-label="Rubriques de la fiche">
    <% onglets.each do |cle, (libelle, _)| %>
      <li role="presentation">
        <button type="button" id="onglet-<%= cle %>" class="fr-tabs__tab" tabindex="<%= cle == actif ? 0 : -1 %>" role="tab" aria-selected="<%= cle == actif %>" aria-controls="onglet-<%= cle %>-panneau"><%= libelle %></button>
      </li>
    <% end %>
  </ul>
  <% onglets.each do |cle, (_, contenu)| %>
    <div id="onglet-<%= cle %>-panneau" class="fr-tabs__panel<%= " fr-tabs__panel--selected" if cle == actif %>" role="tabpanel" aria-labelledby="onglet-<%= cle %>" tabindex="0" data-onglet="<%= cle %>">
      <%= contenu %>
    </div>
  <% end %>
</div>
