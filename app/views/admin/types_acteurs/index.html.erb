<%= render "entete_page", titre: "Fournisseurs de services" %>

<div class="fr-container fr-mb-6w">
  <h1>Fournisseurs de services</h1>
  <%= link_to "Ajouter", new_admin_type_acteur_path, class: "fr-btn fr-mb-3w" %>
  <%= render "recherche" %>
  <div class="fr-table">
    <table>
      <thead>
        <tr>
          <th>Id</th>
          <th>Nom</th>
        </tr>
      </thead>
      <tbody>
        <% @types_acteurs.each do |ligne| %>
          <tr>
            <td><%= ligne.id %></td>
            <td><%= link_to ligne.nom, edit_admin_type_acteur_path(ligne) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "pagination" %>
</div>
