<%= render "entete_page", titre: "Types d'acteurs" %>

<div class="fr-container fr-mb-6w">
  <h1>Types d'acteurs</h1>
  <%= link_to "Ajouter", new_admin_type_acteur_path, class: "fr-btn fr-mb-3w" %>
  <div class="fr-table">
    <table>
      <thead>
        <tr>
          <th>Id</th>
          <th>Nom</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @types_acteurs.each do |ligne| %>
          <tr>
            <td><%= ligne.id %></td>
            <td><%= ligne.nom %></td>
            <td><%= link_to "Modifier", edit_admin_type_acteur_path(ligne), class: "fr-link" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
