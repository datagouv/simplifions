<%= form_with model: [:admin, type_acteur], html: { novalidate: true }, class: "fr-mt-4w", data: surveille_les_modifications(type_acteur) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <%= groupe_de_champ(f, :nom) do |aria| %>
    <%= libelle_obligatoire(f, :nom) %>
    <%= f.text_field :nom, class: "fr-input", required: true, **aria %>
  <% end %>
  <div class="fr-input-group">
    <%= libelle_avec_aide(f, :slugs, "Une valeur par ligne : les filtres « Démarches gérées par » du site qui retiennent ce type d’acteur, ex. : communes, tout-acteurs-publics") %>
    <%= f.text_area :slugs, value: type_acteur.slugs.join("\n"), class: "fr-input", rows: 4 %>
  </div>
  <div class="fr-input-group">
    <%= f.label :description, class: "fr-label" %>
    <%= f.text_area :description, class: "fr-input", rows: 6 %>
  </div>
  <div class="fr-input-group">
    <%= f.label :codes_juridiques, class: "fr-label" %>
    <%= f.text_area :codes_juridiques, class: "fr-input", rows: 6 %>
  </div>
  <%= render "admin/identifiant_grist", grist_id: type_acteur.grist_id %>
  <%= render "admin/cases_filtrables", f: f, attribut: :demarche_ids, collection: Demarche.order(:nom), libelle: :nom, legende: "Démarches" %>
  <%= render "admin/cases_filtrables", f: f, attribut: :solution_ids, collection: Solution.par_libelle_admin, libelle: :libelle_admin, legende: "Solutions" %>
  <ul class="fr-btns-group fr-btns-group--inline">
    <li><button type="submit" class="fr-btn">Enregistrer</button></li>
    <li><%= link_to "Annuler", admin_types_acteurs_path, class: "fr-btn fr-btn--secondary" %></li>
  </ul>
<% end %>
