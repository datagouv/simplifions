<%= form_with model: [:admin, type_acteur], id: "formulaire-fiche", html: { novalidate: true }, data: surveille_les_modifications(type_acteur) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <%= f.dsfr_text_field :nom %>
  <fieldset class="fr-fieldset">
    <legend class="fr-fieldset__legend">
      Regroupements
      <span class="fr-hint-text">Les filtres « Démarches gérées par » du site qui retiennent ce fournisseur de services</span>
    </legend>
    <%= f.collection_check_boxes :slugs, TypeActeur::FILTRES, :last, :first do |b| %>
      <div class="fr-fieldset__element">
        <div class="fr-checkbox-group">
          <%= b.check_box %>
          <%= b.label(class: "fr-label") %>
        </div>
      </div>
    <% end %>
  </fieldset>
  <%= f.dsfr_text_area :description %>
  <%= f.dsfr_text_area :codes_juridiques %>
  <%= render "admin/cases_filtrables", f: f, attribut: :demarche_ids, collection: Demarche.order(:nom), libelle: :nom, legende: "Démarches" %>
  <%= render "admin/cases_filtrables", f: f, attribut: :solution_ids, collection: Solution.par_libelle_admin, libelle: :libelle_admin, legende: "Solutions" %>
<% end %>
