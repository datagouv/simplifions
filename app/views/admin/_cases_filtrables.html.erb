<% collection = collection.to_a %>
<% courte = collection.size <= 10 %>
<% filtre = local_assigns[:filtre] || f.field_id(attribut, :filtre) %>
<% elements = local_assigns[:elements] || legende.downcase %>
<% cochees = f.object.public_send(attribut) %>
<%= tag.fieldset id: local_assigns[:id], class: "fr-fieldset", tabindex: (-1 unless courte), data: ({ controller: "liste-filtrable", action: "focusout->liste-filtrable#quitter" } unless courte) do %>
  <legend class="<%= courte ? "fr-fieldset__legend" : "fr-sr-only" %>"><%= legende %></legend>
  <% unless courte %>
    <div class="fr-fieldset__element fr-mb-0">
      <div class="fr-input-group fr-mb-0">
        <label class="fr-label fr-text--bold" for="<%= filtre %>">
          <%= legende %>
          <span class="fr-hint-text fr-text--regular">Sans filtre, seuls les éléments cochés sont affichés ; cliquer dans le champ ou y appuyer sur flèche bas affiche tous les choix.</span>
        </label>
        <div class="fr-input-wrap fr-input-wrap--addon">
          <input type="text" id="<%= filtre %>" class="fr-input" autocomplete="off" data-liste-filtrable-target="filtre"
                 data-action="click->liste-filtrable#ouvrir keydown.down->liste-filtrable#ouvrir input->liste-filtrable#filtrer keydown.enter->liste-filtrable#filtrer:prevent">
          <button type="button" class="fr-btn fr-btn--tertiary fr-icon-close-line" title="Effacer le filtre des <%= elements %>" data-action="liste-filtrable#effacer">Effacer le filtre des <%= elements %></button>
        </div>
      </div>
    </div>
  <% end %>
  <%= tag.div class: "fr-fieldset__element fr-pt-1w fr-pb-1w", data: ({ liste_filtrable_target: "resultats" } unless courte) do %>
    <% unless courte %>
      <p class="fr-text--sm fr-mb-1w" aria-live="polite" data-liste-filtrable-target="compte"></p>
    <% end %>
    <div class="fr-grid-row">
      <%= f.collection_check_boxes attribut, collection, :id, libelle, include_hidden: local_assigns.fetch(:champ_vide, true) do |b| %>
        <% mots_cles = b.object.public_send(local_assigns[:mots_cles]).join(" ") if local_assigns[:mots_cles] %>
        <%= tag.div class: class_names("fr-fieldset__element", "#{local_assigns.fetch(:largeur, "fr-col-12 fr-col-sm-6 fr-col-lg-4")} fr-grid-row fr-grid-row--middle case-avec-aide" => local_assigns[:referentiel]), data: ({ liste_filtrable_target: "element", liste_filtrable_mots_cles: mots_cles } unless courte) do %>
          <div class="fr-checkbox-group">
            <%= b.check_box data: ({ action: "change->liste-filtrable#compter" } unless courte) %>
            <%= b.label(class: "fr-label") %>
          </div>
          <% if local_assigns[:referentiel] %>
            <%= lien_d_aide(b.object, b.text) %>
          <% elsif cochees.include?(b.value) %>
            <%= lien_vers_la_fiche(b.object, b.text) %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
