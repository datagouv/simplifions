<% filtre = f.field_id(attribut, :filtre) %>
<% cochees = f.object.public_send(attribut) %>
<fieldset class="fr-fieldset" data-controller="liste-filtrable">
  <legend class="fr-fieldset__legend"><%= legende %></legend>
  <div class="fr-fieldset__element">
    <div class="fr-input-group fr-mb-1w">
      <label class="fr-label" for="<%= filtre %>">
        Filtrer les <%= legende.downcase %>
        <span class="fr-hint-text">Sans filtre, seuls les éléments cochés sont affichés.</span>
      </label>
      <input type="search" id="<%= filtre %>" class="fr-input" autocomplete="off" data-liste-filtrable-target="filtre"
             data-action="input->liste-filtrable#filtrer keydown.enter->liste-filtrable#filtrer:prevent">
    </div>
    <p class="fr-text--sm fr-mb-0" aria-live="polite" data-liste-filtrable-target="compte"></p>
  </div>
  <%= f.collection_check_boxes attribut, collection, :id, libelle do |b| %>
    <div class="fr-fieldset__element" data-liste-filtrable-target="element">
      <div class="fr-checkbox-group">
        <%= b.check_box data: { action: "change->liste-filtrable#compter" } %>
        <%= b.label(class: "fr-label") %>
      </div>
      <%= lien_vers_la_fiche(b.object, b.text) if cochees.include?(b.value) %>
    </div>
  <% end %>
</fieldset>
