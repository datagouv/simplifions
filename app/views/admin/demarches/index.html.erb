<%= render "entete_page", titre: "Démarches" %>

<div class="fr-container fr-mb-6w">
  <h1>Démarches</h1>
  <%= link_to "Ajouter", new_admin_demarche_path, class: "fr-btn fr-mb-3w" %>
  <div class="fr-table">
    <table>
      <thead>
        <tr>
          <th>Id</th>
          <th>Nom</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @demarches.each do |ligne| %>
          <tr>
            <td><%= ligne.id %></td>
            <td><%= ligne.nom %></td>
            <td>
              <ul class="fr-btns-group fr-btns-group--inline-sm fr-btns-group--sm">
                <li><%= link_to "Modifier", edit_admin_demarche_path(ligne), class: "fr-btn fr-btn--secondary" %></li>
                <li><%= button_to "Supprimer", admin_demarche_path(ligne), method: :delete, class: "fr-btn fr-btn--tertiary",
                  form: { data: { turbo_confirm: "Supprimer la ligne #{ligne.id} ?" } } %></li>
              </ul>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
