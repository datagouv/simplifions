<%# locals: (recommandations:) -%>
<% donnees = recommandations.select(&:niveau_1?) %>
<section class="bloc-modifiable" aria-labelledby="bloc-donnees-disponibles">
  <div class="bloc-modifiable__entete">
    <h2 id="bloc-donnees-disponibles" class="fr-h4">Données disponibles <span id="compte-des-donnees-disponibles" class="fr-text-mention--grey">(<%= donnees.size %>)</span></h2>
    <button type="button" class="fr-btn fr-btn--sm fr-btn--secondary fr-icon-edit-line fr-btn--icon-left" aria-controls="fenetre-donnees-utiles" data-fr-opened="false">Modifier les données utiles</button>
  </div>
  <div id="liste-des-donnees-disponibles">
    <%= render "admin/demarches/liste_des_donnees_disponibles", donnees: %>
  </div>
</section>
