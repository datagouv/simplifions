<%# locals: (changements:) -%>
<section class="fr-mb-2w" aria-labelledby="a-la-publication">
  <p id="a-la-publication" class="fr-text--bold fr-mb-1w"><%= t("admin.a_la_publication.titre", count: changements.size) %></p>
  <ul class="fr-text--sm">
    <% changements.each do |libelle, ancre| %>
      <li><%= link_to libelle, "##{ancre}", class: "fr-link fr-link--sm" %></li>
    <% end %>
  </ul>
</section>
