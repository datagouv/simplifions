<%# locals: (id:, titre:, attributs:) -%>
<% ouverte = @demarche.errors.attribute_names.intersect?(attributs) %>
<button type="button" class="fr-btn fr-btn--sm fr-btn--secondary fr-icon-edit-line fr-btn--icon-left" aria-controls="fenetre-<%= id %>" data-fr-opened="false"><%= titre %></button>
<% content_for :fenetres do %>
  <dialog id="fenetre-<%= id %>" class="fr-modal" aria-labelledby="fenetre-<%= id %>-titre" data-action="dsfr.conceal->formulaire-modifie#annuler"<%= ' data-controller="fenetre-rouverte"'.html_safe if ouverte %>>
    <div class="fr-container fr-container--fluid fr-container-md">
      <div class="fr-grid-row fr-grid-row--center">
        <div class="fr-col-12 fr-col-md-10 fr-col-lg-8">
          <div class="fr-modal__body">
            <div class="fr-modal__header">
              <button type="button" class="fr-btn--close fr-btn" aria-controls="fenetre-<%= id %>">Fermer</button>
            </div>
            <div class="fr-modal__content">
              <h2 id="fenetre-<%= id %>-titre" class="fr-modal__title"><%= titre %></h2>
              <%= yield %>
            </div>
            <div class="fr-modal__footer">
              <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-lg">
                <li><button type="button" class="fr-btn fr-btn--secondary" aria-controls="fenetre-<%= id %>">Annuler</button></li>
                <li><button type="submit" class="fr-btn" name="onglet" value="fiche">Enregistrer</button></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </dialog>
<% end %>
