<%# locals: (donnees:) -%>
<h4 class="fr-text--md fr-text--bold fr-mb-1w">Données utiles (<%= donnees.size %>)</h4>
<% if donnees.any? %>
  <ul class="donnees-disponibles">
    <% donnees.each do |donnee| %>
      <% nom = donnee.solution&.libelle_admin %>
      <%= tag.li class: ("retiree" if donnee.retiree?) do %>
        <span><%= nom_de_la_recommandation(donnee, nom) %></span>
        <% if donnee.retiree? %>
          <%= render "admin/recommandations/badge", recommandation: donnee %>
          <%= render "admin/recommandations/bouton_remettre", recommandation: donnee, nom: %>
        <% end %>
        <span class="fr-text--xs fr-text-mention--grey"><% if donnee.ordre %><span class="fr-sr-only">Position </span><%= donnee.ordre %><% else %><span aria-hidden="true">—</span><span class="fr-sr-only">Sans position</span><% end %></span>
      <% end %>
    <% end %>
  </ul>
<% else %>
  <p class="fr-text-mention--grey fr-mb-0">Aucune.</p>
<% end %>
