<%= render "entete_page", titre: "Modifier — Démarche" %>

<%= render layout: "liste_et_fiche", locals: { lignes: @demarches } do %>
  <% affichee = @demarche.errors.any? ? Demarche.find(@demarche.id).appliquer_brouillon : @demarche %>
  <% fiche = en_base.recommandations.sur_la_fiche %>
  <h1><%= titre_demarche(affichee) %></h1>
  <div class="fr-grid-row fr-grid-row--gutters fr-mt-2w">
    <aside class="fr-col-12 fr-col-md-4 admin-panneau" aria-labelledby="etat-et-actions">
      <%= render "barre_d_etat", demarche: en_base %>
    </aside>
    <div class="fr-col-12 fr-col-md-8">
      <%= form_with model: [:admin, @demarche], id: "formulaire-fiche", html: { novalidate: true }, data: surveille_les_modifications(@demarche).merge(formulaire_modifie_fiche_value: (edit_admin_demarche_path(en_base) if @demarche.errors.any?)) do |f| %>
        <%= render "admin/erreurs", f: f %>
        <%= render "champs", f: %>
        <div id="message-recommandations" role="status"></div>
        <%= render "solutions_recommandees", demarche: affichee, recommandations: fiche %>
        <%= render "fenetres_des_integrations", f:, cartes: fiche.select(&:niveau_2?) %>
      <% end %>
      <%= render "admin/recommandations/formulaires", demarche: en_base, lignes: fiche, nouvelle_carte: Recommandation.new(demarche: en_base, niveau: :niveau_2) %>
      <%= render "admin/recommandations/fenetres_des_donnees_utiles", cartes: fiche.select(&:niveau_2?), donnees: donnees_par_carte(fiche) %>
    </div>
  </div>
<% end %>
