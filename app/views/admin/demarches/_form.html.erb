<%= form_with model: [:admin, demarche], class: "fr-mt-4w" do |f| %>
  <div class="fr-input-group">
    <%= f.label :nom, class: "fr-label" %>
    <%= f.text_field :nom, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :icone, class: "fr-label" %>
    <%= f.text_field :icone, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :slug, class: "fr-label" %>
    <%= f.text_field :slug, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :description_courte, class: "fr-label" %>
    <%= f.text_area :description_courte, class: "fr-input", rows: 6 %>
  </div>
  <div class="fr-input-group">
    <%= f.label :contexte, class: "fr-label" %>
    <%= f.text_area :contexte, class: "fr-input", rows: 6 %>
  </div>
  <div class="fr-input-group">
    <%= f.label :cadre_juridique, class: "fr-label" %>
    <%= f.text_area :cadre_juridique, class: "fr-input", rows: 6 %>
  </div>
  <div class="fr-checkbox-group">
    <%= f.check_box :visible %>
    <%= f.label :visible, class: "fr-label" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :cree_le, class: "fr-label" %>
    <%= f.datetime_field :cree_le, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :modifie_le, class: "fr-label" %>
    <%= f.datetime_field :modifie_le, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :grist_id, class: "fr-label" %>
    <%= f.text_field :grist_id, class: "fr-input" %>
  </div>
  <ul class="fr-btns-group fr-btns-group--inline">
    <li><button type="submit" class="fr-btn">Enregistrer</button></li>
    <li><%= link_to "Annuler", admin_demarches_path, class: "fr-btn fr-btn--secondary" %></li>
  </ul>
<% end %>
