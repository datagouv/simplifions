<%= form_with model: [:admin, demarche], id: "formulaire-fiche", html: { novalidate: true }, data: surveille_les_modifications(demarche) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <%= f.dsfr_text_field :icone %>
  <%= f.dsfr_text_field :nom %>
  <%= f.dsfr_text_field :slug %>
  <%= f.dsfr_text_area :description_courte %>
  <%= f.dsfr_text_area :contexte %>
  <%= f.dsfr_text_area :cadre_juridique %>
  <%= render "admin/cases_filtrables", f: f, attribut: :type_acteur_ids, collection: TypeActeur.order(:nom), libelle: :nom, legende: "Fournisseurs de services", referentiel: true %>
  <%= f.dsfr_text_area :mots_clefs %>
  <%= render "admin/vocabulaires", f: f %>
  <% integrations = demarche.integrations_proposees.includes(:integratrice, :integree).order(:id).load %>
  <% autorisees = demarche.integrations_autorisees.ids %>
  <% if integrations.any? %>
    <%= render "admin/cases_filtrables", f: f, attribut: :integration_ids, collection: integrations, libelle: ->(integration) { libelle_hors_regle(integration.libelle, autorisees.include?(integration.id)) }, legende: "Intégrations" %>
  <% else %>
    <%= hidden_field_tag "demarche[integration_ids][]", "" %>
    <p class="fr-hint-text">Intégrations : à cocher une fois que la démarche recommande l’API ou le jeu de données intégré.</p>
  <% end %>
<% end %>
