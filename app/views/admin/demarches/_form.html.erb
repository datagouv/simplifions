<%= form_with model: [:admin, demarche], html: { novalidate: true }, class: "fr-mt-4w", data: surveille_les_modifications(demarche) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <div class="fr-checkbox-group fr-mb-3w">
    <%= f.check_box :visible %>
    <%= f.label :visible, class: "fr-label" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :icone, class: "fr-label" %>
    <%= f.text_field :icone, class: "fr-input" %>
  </div>
  <%= groupe_de_champ(f, :nom) do |aria| %>
    <%= libelle_obligatoire(f, :nom) %>
    <%= f.text_field :nom, class: "fr-input", required: true, **aria %>
  <% end %>
  <%= groupe_de_champ(f, :slug) do |aria| %>
    <%= libelle_avec_aide(f, :slug, "Obligatoire si la démarche est visible sur simplifions. Minuscules sans accent, chiffres et tirets, ex. : cantine-scolaire") %>
    <%= f.text_field :slug, class: "fr-input", **aria %>
  <% end %>
  <div class="fr-input-group">
    <%= f.label :description_courte, class: "fr-label" %>
    <%= f.text_area :description_courte, class: "fr-input", rows: lignes_pour(f.object.description_courte) %>
  </div>
  <div class="fr-input-group">
    <%= libelle_avec_aide(f, :contexte, "Markdown accepté") %>
    <%= f.text_area :contexte, class: "fr-input", rows: lignes_pour(f.object.contexte) %>
  </div>
  <div class="fr-input-group">
    <%= libelle_avec_aide(f, :cadre_juridique, "Markdown accepté") %>
    <%= f.text_area :cadre_juridique, class: "fr-input", rows: lignes_pour(f.object.cadre_juridique) %>
  </div>
  <%= render "admin/cases_filtrables", f: f, attribut: :type_acteur_ids, collection: TypeActeur.order(:nom), libelle: :nom, legende: "Types d'acteurs" %>
  <div class="fr-input-group">
    <%= libelle_avec_aide(f, :mots_clefs, "Une valeur par ligne, utilisés pour la recherche et le référencement") %>
    <%= f.text_area :mots_clefs, value: demarche.mots_clefs.join("\n"), class: "fr-input", rows: lignes_pour(f.object.mots_clefs) %>
  </div>
  <fieldset class="fr-fieldset">
    <legend class="fr-fieldset__legend">Vocabulaires</legend>
    <% vocabulaires_coches = f.object.vocabulaire_ids %>
    <% options_traduites(Vocabulaire, :categorie).each do |legende, categorie| %>
      <div class="fr-fieldset__element">
        <fieldset class="fr-fieldset">
          <legend class="fr-fieldset__legend fr-text--regular"><%= legende %></legend>
          <%= f.collection_check_boxes :vocabulaire_ids, Vocabulaire.where(categorie:).order(:id), :id, :nom do |b| %>
            <div class="fr-fieldset__element">
              <div class="fr-checkbox-group">
                <%= b.check_box %>
                <%= b.label(class: "fr-label") %>
              </div>
              <%= lien_vers_la_fiche(b.object, b.text) if vocabulaires_coches.include?(b.value) %>
            </div>
          <% end %>
        </fieldset>
      </div>
    <% end %>
  </fieldset>
  <%= render "admin/cases_filtrables", f: f, attribut: :integration_ids, collection: Integration.includes(:integratrice, :integree).order(:id), libelle: :libelle, legende: "Intégrations" %>
  <%= render "admin/identifiant_grist", grist_id: demarche.grist_id %>
  <ul class="fr-btns-group fr-btns-group--inline">
    <li><button type="submit" class="fr-btn">Enregistrer</button></li>
    <li><%= link_to "Annuler", admin_demarches_path, class: "fr-btn fr-btn--secondary" %></li>
  </ul>
<% end %>
