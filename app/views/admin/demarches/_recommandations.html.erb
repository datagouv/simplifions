<%# locals: (lignes:) -%>
<div id="message-recommandations" role="status"></div>
<div class="fr-table"><div class="fr-table__wrapper"><div class="fr-table__container"><div class="fr-table__content">
  <table class="lignes-modifiables" aria-labelledby="onglet-recommandations">
    <thead>
      <tr>
        <th scope="col">Solution (obligatoire)</th>
        <th scope="col"><%= Recommandation.human_attribute_name(:niveau) %> (obligatoire)</th>
        <th scope="col"><%= Recommandation.human_attribute_name(:ordre) %></th>
        <th scope="col">État</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "admin/recommandations/ligne", collection: lignes %>
    </tbody>
  </table>
</div></div></div></div>
