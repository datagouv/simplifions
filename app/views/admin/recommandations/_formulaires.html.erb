<%# locals: (demarche:, lignes:, nouvelle_carte:) -%>
<div id="formulaires-recommandations">
  <% lignes.select(&:niveau_2?).each do |carte| %>
    <%= render "admin/recommandations/fenetre", recommandation: carte %>
  <% end %>
  <%= render "admin/recommandations/fenetre", recommandation: nouvelle_carte %>
  <% lignes.each do |ligne| %>
    <%= form_with model: [:admin, ligne], method: :delete, id: dom_id(ligne, :suppression), data: { enregistre_sur_place: true } do %>
      <%= hidden_field_tag :ligne, 1, id: nil %>
    <% end %>
  <% end %>
</div>
