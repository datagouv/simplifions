<%= turbo_stream.update "message-recommandations" do %>
  <% if @recommandation.errors.none? %>
    <p class="fr-valid-text fr-mb-2w"><%= message_d_enregistrement(@recommandation) %></p>
  <% else %>
    <p class="fr-error-text fr-mb-2w">Recommandation non enregistrée : <%= @recommandation.errors.full_messages.to_sentence %></p>
  <% end %>
<% end %>
<% if @recommandation.previously_new_record? %>
  <%= turbo_stream.before dom_id(Recommandation), partial: "ligne", locals: { ligne: @recommandation } %>
  <%= turbo_stream.append "formulaires-recommandations", partial: "formulaire_de_ligne", locals: { ligne: @recommandation } %>
  <%= turbo_stream.replace dom_id(Recommandation), partial: "ligne", locals: { ligne: Recommandation.new(demarche: @recommandation.demarche) }, method: :morph %>
<% else %>
  <%= turbo_stream.replace dom_id(@recommandation), partial: "ligne", locals: { ligne: @recommandation }, method: :morph %>
<% end %>
