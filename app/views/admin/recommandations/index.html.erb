<%= render "entete_page", titre: "Recommandations" %>

<div class="fr-container fr-mb-6w">
  <h1>Recommandations</h1>
  <%= link_to "Ajouter", new_admin_recommandation_path, class: "fr-btn fr-mb-3w" %>
  <%= render "recherche", total: @recommandations.total_count %>
  <div class="fr-table">
    <table>
      <thead>
        <tr>
          <th>Id</th>
          <th>Ligne</th>
          <th>Visible</th>
          <th>Modifié le</th>
        </tr>
      </thead>
      <tbody>
        <% @recommandations.each do |ligne| %>
          <tr>
            <td><%= ligne.id %></td>
            <td><%= link_to ligne.libelle, edit_admin_recommandation_path(ligne) %></td>
            <%= render "visible_et_modifie_le", ligne: %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= pagination @recommandations, %w[q] %>
</div>
