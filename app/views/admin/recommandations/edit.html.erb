<%= render "entete_page", titre: "Modifier — Recommandation" %>

<div class="fr-container fr-mb-6w">
  <h1><%= nom_en_base %></h1>
  <%= render layout: "admin/fiche", locals: { consequences: [(t("admin.suppression.immediate") if en_base.retrait_sans_retour_a_annoncer?)],
      badge_du_brouillon: (tag.p("Retirée · à publier", class: "fr-badge fr-badge--no-icon fr-badge--warning") if en_base.retrait_en_attente?) } do %>
    <%= render "form", recommandation: @recommandation %>
  <% end %>
</div>
