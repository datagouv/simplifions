<%# locals: (carte:, donnees:, recommandees:) -%>
<% fenetre = fenetre_des_donnees_utiles(carte) %>
<% titre = carte ? "Données utiles : #{carte.solution.libelle_admin}" : "Données utiles rattachées à aucune solution recommandée" %>
<%= render layout: "admin/dialogue", locals: { id: fenetre, titre:, ouverte: false, hors_fiche: true, pied: false } do %>
  <p class="fr-hint-text">Chaque ligne s’enregistre seule. La position range les données utiles : plus le nombre est petit, plus la donnée apparaît haut.</p>
  <div id="message-<%= fenetre %>" role="status"></div>
  <div id="lignes-<%= fenetre %>">
    <%= render "admin/recommandations/lignes_des_donnees_utiles", carte:, donnees:, recommandees: %>
  </div>
<% end %>
