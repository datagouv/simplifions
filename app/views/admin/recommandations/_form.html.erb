<%= form_with model: [:admin, recommandation], html: { novalidate: true }, class: "fr-mt-4w", data: surveille_les_modifications(recommandation) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <div class="fr-checkbox-group fr-mb-3w">
    <%= f.check_box :visible %>
    <%= f.label :visible, class: "fr-label" %>
  </div>
  <%= groupe_de_champ(f, :solution_id, "fr-select-group") do |aria| %>
    <%= libelle_obligatoire(f, :solution_id) %>
    <%= f.collection_select :solution_id, Solution.par_libelle_admin, :id, :libelle_admin, { include_blank: true }, class: "fr-select", required: true, **aria %>
  <% end %>
  <div class="fr-input-group">
    <%= f.label :url_demande_acces, class: "fr-label" %>
    <%= f.text_field :url_demande_acces, class: "fr-input" %>
  </div>
  <%= groupe_de_champ(f, :demarche_id, "fr-select-group") do |aria| %>
    <%= libelle_obligatoire(f, :demarche_id) %>
    <%= f.collection_select :demarche_id, Demarche.order(:nom), :id, :nom, { include_blank: true }, class: "fr-select", required: true, **aria %>
  <% end %>
  <%= groupe_de_champ(f, :niveau, "fr-select-group") do |aria| %>
    <%= libelle_avec_aide(f, :niveau, "Donnée utile : API ou jeu de données listé sous « Données disponibles » dans les cartes des solutions recommandées. Solution recommandée : carte sur la page du cas d’usage.", obligatoire: true) %>
    <%= f.select :niveau, options_traduites(Recommandation, :niveau), { include_blank: true }, class: "fr-select", required: true, **aria %>
  <% end %>
  <div class="fr-input-group">
    <%= libelle_avec_aide(f, :ordre, "Plus le nombre est petit, plus l’élément apparaît haut sur la page du cas d’usage.") %>
    <%= f.number_field :ordre, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= libelle_avec_aide(f, :donnees_utiles, "Markdown accepté") %>
    <%= f.text_area :donnees_utiles, class: "fr-input", rows: lignes_pour(f.object.donnees_utiles) %>
  </div>
  <div class="fr-input-group">
    <%= libelle_avec_aide(f, :parametres_a_saisir, "Markdown accepté") %>
    <%= f.text_area :parametres_a_saisir, class: "fr-input", rows: lignes_pour(f.object.parametres_a_saisir) %>
  </div>
  <div class="fr-input-group">
    <%= libelle_avec_aide(f, :description, "Markdown accepté") %>
    <%= f.text_area :description, class: "fr-input", rows: lignes_pour(f.object.description) %>
  </div>
  <%= render "admin/identifiant_grist", grist_id: recommandation.grist_id %>
  <ul class="fr-btns-group fr-btns-group--inline">
    <li><button type="submit" class="fr-btn">Enregistrer</button></li>
    <li><%= link_to "Annuler", admin_recommandations_path, class: "fr-btn fr-btn--secondary" %></li>
  </ul>
<% end %>
