<% if (demarche = recommandation.demarche) %>
  <aside class="fr-callout" aria-labelledby="demarche-de-la-recommandation">
    <h2 id="demarche-de-la-recommandation" class="fr-callout__title">Démarche : <%= demarche.nom %></h2>
    <%= simple_format(demarche.description_courte, class: "fr-callout__text") if demarche.description_courte.present? %>
    <p><%= lien_vers_la_fiche(demarche, demarche.nom) %></p>
    <% autres = demarche.recommandations.where.not(id: recommandation.id) %>
    <section class="fr-accordion">
      <h3 id="autres-recommandations" class="fr-accordion__title">
        <button type="button" class="fr-accordion__btn" aria-expanded="false" aria-controls="tableau-autres-recommandations">Autres recommandations de la démarche (<%= autres.count %>)</button>
      </h3>
      <div class="fr-collapse" id="tableau-autres-recommandations">
        <%= render "tableau", recommandations: autres, titre_id: "autres-recommandations" %>
      </div>
    </section>
  </aside>
<% end %>
<%= form_with model: [:admin, recommandation], id: "formulaire-fiche", html: { novalidate: true }, data: surveille_les_modifications(recommandation) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <%= f.dsfr_select :solution_id, choix_de_solutions do %>
    <%= lien_vers_la_fiche(recommandation.solution, recommandation.solution.libelle_admin) if recommandation.solution %>
  <% end %>
  <%= f.dsfr_text_field :url_demande_acces %>
  <%= f.dsfr_select :demarche_id, Demarche.order(:nom).pluck(:nom, :id) %>
  <%= f.dsfr_select :niveau, options_traduites(Recommandation, :niveau) %>
  <%= f.dsfr_number_field :ordre %>
  <%= f.dsfr_text_area :donnees_utiles %>
  <%= f.dsfr_text_area :parametres_a_saisir %>
  <%= f.dsfr_text_area :description %>
<% end %>
