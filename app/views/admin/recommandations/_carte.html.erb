<%# locals: (carte:, donnees:) -%>
<% nom = carte.solution&.libelle_admin %>
<%= tag.li id: dom_id(carte), class: ["fr-col-12", ("retiree" if carte.retiree?)], data: { deplacement: dom_id(carte, :deplacement) } do %>
  <div class="carte-recommandee">
    <p class="fr-text--xs fr-text-mention--grey fr-mb-1w">
      <span class="poignee fr-icon-drag-move-2-line" aria-hidden="true" title="Glisser pour déplacer" data-poignee></span>
      <%= carte.ordre ? "Position #{carte.ordre}" : "Sans position" %>
    </p>
    <h3 class="fr-text--md fr-text--bold fr-mb-1w"><%= nom_de_la_recommandation(carte, nom) %></h3>
    <%= render "admin/recommandations/badge", recommandation: carte %>
    <ul class="fr-btns-group fr-btns-group--inline fr-btns-group--sm fr-mt-1w">
      <% if carte.retiree? %>
        <li><%= render "admin/recommandations/bouton_remettre", recommandation: carte, nom: %></li>
      <% else %>
        <li><button type="button" id="<%= dom_id(carte, :modifier) %>" class="fr-btn fr-btn--secondary" aria-controls="fenetre-<%= dom_id(carte) %>" data-fr-opened="false">Modifier<span class="fr-sr-only"> <%= nom %></span></button></li>
        <li><%= render "admin/recommandations/bouton_retirer", recommandation: carte, nom: %></li>
      <% end %>
    </ul>
    <% if carte.solution.exposees.any? %>
      <h4 class="fr-text--md fr-text--bold fr-mt-2w fr-mb-1w">Données utiles (<%= donnees.size %>)</h4>
      <%= render "admin/demarches/liste_des_donnees_disponibles", donnees: %>
    <% end %>
  </div>
<% end %>
