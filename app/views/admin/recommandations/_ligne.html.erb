<%# locals: (ligne:) -%>
<% enregistree = ligne.solution_id_changed? ? Solution.find_by(id: ligne.solution_id_in_database) : ligne.solution %>
<% nom = ligne.new_record? ? "la nouvelle recommandation" : "la recommandation #{enregistree&.libelle_admin}" %>
<% ligne.appliquer_brouillon(ligne.brouillon.to_h.slice("solution_id", "niveau", "ordre")) %>
<% formulaire = dom_id(ligne, :formulaire) %>
<% erreurs = dom_id(ligne, :erreurs) %>
<% invalide = ligne.errors.any? ? { invalid: true, describedby: erreurs } : {} %>
<tr id="<%= dom_id(ligne) %>">
  <%= fields model: ligne, namespace: dom_id(ligne) do |f| %>
    <td>
      <%= f.label :solution_id, "Solution de #{nom} (obligatoire)", class: "fr-sr-only" %>
      <%= f.select :solution_id, choix_de_solutions, { include_blank: true }, class: "fr-select", form: formulaire, aria: { required: true, **invalide } %>
    </td>
    <td>
      <%= f.label :niveau, "#{Recommandation.human_attribute_name(:niveau)} de #{nom} (obligatoire)", class: "fr-sr-only" %>
      <%= f.select :niveau, options_traduites(Recommandation, :niveau), { include_blank: true }, class: "fr-select", form: formulaire, aria: { required: true, **invalide } %>
    </td>
    <td>
      <%= f.label :ordre, "#{Recommandation.human_attribute_name(:ordre)} de #{nom}", class: "fr-sr-only" %>
      <%= f.number_field :ordre, class: "fr-input", form: formulaire, aria: invalide %>
    </td>
  <% end %>
  <td>
    <% if ligne.persisted? %>
      <p class="fr-badge fr-badge--sm fr-badge--no-icon <%= "fr-badge--success" if ligne.visible? %>"><%= ligne.visible? ? "Publiée" : "Masquée" %></p>
      <% if ligne.modifie_le %>
        <br><time datetime="<%= ligne.modifie_le.iso8601 %>"><%= l ligne.modifie_le.to_date %></time>
      <% end %>
    <% end %>
  </td>
  <td>
    <% if ligne.persisted? && ligne.brouillon? %>
      <p class="fr-badge fr-badge--sm fr-badge--no-icon fr-badge--new fr-mb-1w">Brouillon</p>
    <% end %>
    <%= tag.button type: "submit", form: formulaire, id: dom_id(ligne, :enregistrer), class: "fr-btn fr-btn--sm", aria: { describedby: invalide[:describedby] } do %><%= ligne.new_record? ? "Ajouter" : "Enregistrer" %><span class="fr-sr-only"> <%= nom %></span><% end %>
    <% if ligne.persisted? %>
      <%= link_to edit_admin_recommandation_path(ligne), class: "fr-link fr-link--sm" do %>Modifier<span class="fr-sr-only"> <%= nom %></span><% end %>
      <% supprimer = "Supprimer #{nom}" %>
      <%= tag.button supprimer, type: "submit", form: dom_id(ligne, :suppression), title: supprimer, class: "fr-btn fr-btn--sm fr-btn--tertiary-no-outline fr-icon-delete-line", data: { turbo_confirm: "#{supprimer} ?" } %>
    <% end %>
    <% if ligne.errors.any? %>
      <p id="<%= erreurs %>" class="fr-error-text"><%= ligne.errors.full_messages.to_sentence %></p>
    <% end %>
  </td>
</tr>
