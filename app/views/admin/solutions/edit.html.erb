<%= render "entete_page", titre: "Modifier — Solution" %>

<div class="fr-container fr-mb-6w">
  <h1><%= nom_en_base %></h1>
  <% if en_base.privee? %>
    <p class="fr-badge fr-badge--sm fr-badge--no-icon">Privée</p>
  <% end %>
  <% if en_base.visible? && en_base.slug.present? %>
    <p><%= link_to solution_path(en_base.slug), class: "fr-link", target: "_blank", rel: "noopener", title: "Voir la page publique de #{nom_en_base} - nouvelle fenêtre" do %>Voir la page publique<span class="fr-sr-only"> - nouvelle fenêtre</span><% end %></p>
  <% end %>
  <% lies = { "Démarches qui la recommandent" => en_base.demarches_recommandantes.order(:nom),
              "Solutions qui l’intègrent" => en_base.integratrices.par_libelle_admin,
              "Ce qu’elle intègre" => en_base.integrees.par_libelle_admin }.compact_blank %>
  <% if lies.any? %>
    <section id="elements-lies" class="fr-mb-4w" aria-labelledby="elements-lies-titre">
      <h2 id="elements-lies-titre" class="fr-h6">Éléments liés</h2>
      <% lies.each do |titre, lignes| %>
        <h3 class="fr-text--md fr-text--bold fr-mb-1v"><%= titre %></h3>
        <ul>
          <% lignes.each do |ligne| %>
            <li><%= link_to ligne.try(:libelle_admin) || ligne.nom, fiche_admin(ligne), class: "fr-link" %></li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
  <%= render "form", solution: @solution %>
  <%= render "admin/supprimer", url: admin_solution_path(en_base), nom: nom_en_base,
  consequences: [t("admin.suppression.recommandations", count: en_base.recommandations.count),
    t("admin.suppression.integrations", count: en_base.integrations_comme_integratrice.count + en_base.integrations_comme_integree.count)] %>
</div>
