<%= form_with model: [:admin, solution], html: { novalidate: true }, class: "fr-mt-4w", data: surveille_les_modifications(solution) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <div class="fr-checkbox-group fr-mb-3w">
    <%= f.check_box :visible %>
    <%= f.label :visible, class: "fr-label" %>
  </div>
  <%= groupe_de_champ(f, :nom) do |aria| %>
    <%= libelle_obligatoire(f, :nom) %>
    <%= f.text_field :nom, class: "fr-input", required: true, **aria %>
  <% end %>
  <%= champ_de_fiche(f, :slug) do |aria| %>
    <%= libelle_avec_aide(f, :slug, "Obligatoire si la solution est visible sur simplifions, sauf pour une API ou un jeu de données. Minuscules sans accent, chiffres et tirets, ex. : cantine-scolaire") %>
    <%= f.text_field :slug, class: "fr-input", **aria %>
  <% end %>
  <%= champ_de_fiche(f, :site_internet) do |aria| %>
    <%= f.label :site_internet, class: "fr-label" %>
    <%= f.text_field :site_internet, class: "fr-input", **aria %>
  <% end %>
  <%= champ_de_fiche(f, :url_demande_acces) do |aria| %>
    <%= f.label :url_demande_acces, class: "fr-label" %>
    <%= f.text_field :url_demande_acces, class: "fr-input", **aria %>
  <% end %>
  <%= render "admin/cases_filtrables", f: f, attribut: :organisation_ids, collection: Organisation.order(:nom), libelle: :nom, legende: "Organisations" %>
  <%= champ_de_fiche(f, :image, "fr-upload-group") do |aria| %>
    <%= libelle_avec_aide(f, :image, "Formats acceptés : png, jpg, webp") %>
    <%= f.file_field :image, class: "fr-upload", accept: "image/png,image/jpeg,image/webp", **aria %>
    <% if en_base&.image&.attached? %>
      <%= image_tag en_base.image, alt: en_base.legende_image.presence || "Image actuelle de #{en_base.nom}", width: 320, class: "fr-mt-2w" %>
      <div class="fr-checkbox-group fr-mt-1w">
        <%= check_box_tag "solution[retirer_image]", "1", params.dig(:solution, :retirer_image) == "1" %>
        <%= label_tag "solution_retirer_image", "Retirer l’image", class: "fr-label" %>
      </div>
    <% end %>
  <% end %>
  <%= champ_de_fiche(f, :legende_image) do |aria| %>
    <%= f.label :legende_image, class: "fr-label" %>
    <%= f.text_area :legende_image, class: "fr-input", rows: lignes_pour(f.object.legende_image), **aria %>
  <% end %>
  <%= champ_de_fiche(f, :description_courte) do |aria| %>
    <%= f.label :description_courte, class: "fr-label" %>
    <%= f.text_area :description_courte, class: "fr-input", rows: lignes_pour(f.object.description_courte), **aria %>
  <% end %>
  <div class="fr-input-group">
    <%= libelle_avec_aide(f, :types_solution, "Une valeur par ligne, affichées sous le nom de la solution, ex. : Portail agent") %>
    <%= f.text_area :types_solution, value: solution.types_solution.join("\n"), class: "fr-input", rows: lignes_pour(f.object.types_solution) %>
  </div>
  <div class="fr-select-group">
    <%= libelle_avec_aide(f, :categorie, "Une API ou un jeu de données n’a pas de fiche sur le site : slug, site internet, URL de demande d’accès, image, légende, description courte, « permet » et « ne permet pas » restent vides.") %>
    <%= f.select :categorie, options_traduites(Solution, :categorie), { include_blank: true }, class: "fr-select", data: { controller: "champs-fiche", action: "champs-fiche#basculer", champs_fiche_hors_fiches_value: Solution::HORS_FICHES } %>
  </div>
  <fieldset class="fr-fieldset">
    <legend class="fr-fieldset__legend">Vocabulaires</legend>
    <% vocabulaires_coches = f.object.vocabulaire_ids %>
    <% options_traduites(Vocabulaire, :categorie).each do |legende, categorie| %>
      <div class="fr-fieldset__element">
        <fieldset class="fr-fieldset">
          <legend class="fr-fieldset__legend fr-text--regular"><%= legende %></legend>
          <%= f.collection_check_boxes :vocabulaire_ids, Vocabulaire.where(categorie:).order(:id), :id, :nom do |b| %>
            <div class="fr-fieldset__element">
              <div class="fr-checkbox-group">
                <%= b.check_box %>
                <%= b.label(class: "fr-label") %>
              </div>
              <%= lien_vers_la_fiche(b.object, b.text) if vocabulaires_coches.include?(b.value) %>
            </div>
          <% end %>
        </fieldset>
      </div>
    <% end %>
  </fieldset>
  <%= render "admin/cases_filtrables", f: f, attribut: :type_acteur_ids, collection: TypeActeur.order(:nom), libelle: :nom, legende: "Fournisseurs de services" %>
  <%= champ_de_fiche(f, :permet) do |aria| %>
    <%= libelle_avec_aide(f, :permet, "Markdown accepté") %>
    <%= f.text_area :permet, class: "fr-input", rows: lignes_pour(f.object.permet), **aria %>
  <% end %>
  <%= champ_de_fiche(f, :ne_permet_pas) do |aria| %>
    <%= libelle_avec_aide(f, :ne_permet_pas, "Markdown accepté") %>
    <%= f.text_area :ne_permet_pas, class: "fr-input", rows: lignes_pour(f.object.ne_permet_pas), **aria %>
  <% end %>
  <div class="fr-input-group">
    <%= libelle_avec_aide(f, :uid_datagouv, "Pour une API ou un jeu de données : identifiant de sa fiche data.gouv.fr, d’où sont repris son titre, son organisation et son accès.") %>
    <%= f.text_field :uid_datagouv, class: "fr-input" %>
  </div>
  <div class="fr-checkbox-group fr-mb-3w">
    <%= f.check_box :france_connectee %>
    <%= libelle_avec_aide(f, :france_connectee, "L’API est accessible avec FranceConnect : elle figure dans l’article sur les API FranceConnectées.") %>
  </div>
  <% if solution.uid_datagouv_in_database.present? %>
    <div class="fr-mb-3w">
      <h2 class="fr-h6 fr-mb-1w">Repris de data.gouv.fr</h2>
      <ul>
        <li>Titre : <%= solution.datagouv_titre %></li>
        <li>Organisation : <%= solution.datagouv_organisation %></li>
        <li>Logo : <%= solution.datagouv_logo %></li>
        <li>Accès : <%= solution.datagouv_acces %></li>
        <li>Accès des acteurs publics : <%= solution.datagouv_acces_acteurs_publics %></li>
        <li>Badges de l’organisation : <%= solution.datagouv_organisation_badges.join(", ") %></li>
      </ul>
    </div>
  <% end %>
  <%= render "admin/identifiant_grist", grist_id: solution.grist_id %>
  <ul class="fr-btns-group fr-btns-group--inline">
    <li><button type="submit" class="fr-btn">Enregistrer</button></li>
    <li><%= link_to "Annuler", admin_solutions_path, class: "fr-btn fr-btn--secondary" %></li>
  </ul>
<% end %>
