<% if en_base %>
  <% listes = %i[fournies integrees integratrices].index_with { |liste| lignes_d_integrations(en_base, liste) } %>
  <% integrations_de_ses_api = Integration.where(id: en_base.integrations_de_ses_api.select(:id)).par_libelle_admin_de(:integratrice).preload(:integratrice, :integree).load %>
<% end %>
<%= form_with model: [:admin, solution], id: "formulaire-fiche", html: { novalidate: true }, data: surveille_les_modifications(solution) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <% fiche = capture do %>
    <%= render "categorie", f: %>
    <%= tag.div data: { controller: "datagouv",
          datagouv_url_value: apercu_datagouv_admin_solutions_path, datagouv_attente_value: "Recherche de cet identifiant sur data.gouv.fr…",
          datagouv_sans_identifiant_value: "Saisissez d’abord l’identifiant data.gouv.", datagouv_repris_value: "repris de data.gouv.fr : enregistrez la fiche pour les garder." } do %>
      <% recuperable = !solution.fiche? %>
      <%= f.dsfr_text_field :uid_datagouv, **champ_de_la_categorie(f, :uid_datagouv), data: ({ action: "keydown.enter->datagouv#recuperer:prevent" } if recuperable),
            bouton_accole: (button_tag("Récupérer les infos data.gouv", type: "button", class: "fr-btn", data: { action: "datagouv#recuperer" }) if recuperable) %>
      <p class="fr-hint-text fr-mb-3w" role="status" data-datagouv-target="attente"></p>
      <%= render "repris_datagouv", solution:, a_recharger: solution.uid_datagouv.present? && solution.uid_datagouv_changed? %>
      <%= render "admin/cases_filtrables", f: f, attribut: :organisation_ids, collection: Organisation.order(:nom), libelle: :nom, legende: "Organisations" %>
    <% end %>
    <%= f.dsfr_text_field :nom %>
    <%= f.dsfr_text_field :titre_seo, **champ_de_la_categorie(f, :titre_seo) %>
    <%= render "admin/slug", f:, **champ_de_la_categorie(f, :slug) %>
    <%= f.dsfr_text_field :site_internet, **champ_de_la_categorie(f, :site_internet) %>
    <%= f.dsfr_text_field :url_demande_acces, **champ_de_la_categorie(f, :url_demande_acces) %>
    <%= f.dsfr_check_box :france_connectee, disabled: !solution.categorie_api?, class: ("fr-hidden" unless solution.categorie_api?) %>
    <%= f.dsfr_file_field :image, accept: "image/png,image/jpeg,image/webp", **champ_de_la_categorie(f, :image) do %>
      <% image = en_base&.brouillon.to_h.key?("image") ? solution.image : en_base&.image %>
      <% if image&.attached? && image.blob.persisted? %>
        <%= image_tag image, alt: solution.legende_image.presence || "Image actuelle de #{en_base.nom}", width: 320, class: "fr-mt-2w" %>
        <div class="fr-checkbox-group fr-mt-1w">
          <%= check_box_tag "solution[retirer_image]", "1", params.dig(:solution, :retirer_image) == "1" %>
          <%= label_tag "solution_retirer_image", class: "fr-label" do %>
            Retirer l’image
            <span class="fr-hint-text">L’image sera retirée à l’enregistrement.</span>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <%= f.dsfr_text_field :legende_image, **champ_de_la_categorie(f, :legende_image) %>
    <%= f.dsfr_text_area :description_courte, **champ_de_la_categorie(f, :description_courte) %>
    <div class="fr-grid-row fr-grid-row--gutters">
      <div class="fr-col-12 fr-col-md-6">
        <%= render "admin/cases_filtrables", f: f, attribut: :type_acteur_ids, collection: TypeActeur.order(:nom), libelle: :nom, legende: "Solution à destination de :", elements: "fournisseurs de services", referentiel: true, largeur: "fr-col-12" %>
      </div>
      <div class="fr-col-12 fr-col-md-6">
        <%= render "admin/vocabulaires", f:, categories: %w[usager], legende: nil, legendes: { "usager" => "Pour simplifier les démarches de :" }, id: nil, largeur: "fr-col-12" %>
      </div>
    </div>
    <%= render "admin/vocabulaires", f:, categories: %w[solution], legende: nil %>
    <fieldset class="fr-fieldset" id="<%= f.field_id(:types_solution) %>">
      <legend class="fr-fieldset__legend">
        <%= Solution.human_attribute_name(:types_solution) %>
        <span class="fr-hint-text fr-text--regular"><%= t("activerecord.hints.solution.types_solution") %></span>
      </legend>
      <%= f.collection_check_boxes :types_solution, Solution::TYPES_SOLUTION, :itself, :itself do |b| %>
        <div class="fr-fieldset__element fr-col-12 fr-col-md-4">
          <div class="fr-checkbox-group">
            <%= b.check_box %>
            <%= b.label(class: "fr-label") %>
          </div>
        </div>
      <% end %>
    </fieldset>
    <%= render "admin/vocabulaires", f:, categories: %w[type_simplification], legende: nil, id: nil %>
    <%= f.dsfr_text_area :permet, **champ_de_la_categorie(f, :permet) %>
    <%= f.dsfr_text_area :ne_permet_pas, **champ_de_la_categorie(f, :ne_permet_pas) %>
  <% end %>
  <% if en_base %>
    <% integratrices = capture do %>
      <%= render "integrations", liste: :integratrices, lignes: listes[:integratrices] %>
      <% if integrations_de_ses_api.any? %>
        <ul>
          <% integrations_de_ses_api.each do |integration| %>
            <li><%= integration.integratrice.libelle_admin %> — via <%= integration.integree.libelle_admin %> <%= lien_vers_la_fiche(integration.integree, integration.integree.libelle_admin) %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
    <% libelles = libelles_des_onglets_d_integrations(en_base) %>
    <% demarches = en_base.demarches_recommandantes.order(:nom).load %>
    <div id="message-integrations" role="status"></div>
    <%= render "admin/onglets", objet: solution, onglets: {
          "fiche" => ["Fiche", fiche],
          "api-fournies" => [libelles["api-fournies"], render("integrations", liste: :fournies, lignes: listes[:fournies])],
          "api-integrees" => [libelles["api-integrees"], render("integrations", liste: :integrees, lignes: listes[:integrees])],
          "integratrices" => [libelles["integratrices"], integratrices],
          "recommandee-dans" => ["Recommandée dans (#{demarches.size})", render("admin/liens_vers_les_fiches", lignes: demarches, vide: "Aucune démarche ne la recommande.")],
          "historique" => ["Historique", render("admin/historiques/versions", ligne: en_base)]
        } %>
  <% else %>
    <%= fiche %>
  <% end %>
<% end %>
<% if listes %>
  <div id="formulaires-integrations">
    <% listes.each do |liste, lignes| %>
      <%= render partial: "admin/integrations/formulaire_de_ligne", collection: lignes, as: :ligne, locals: { liste: } %>
    <% end %>
  </div>
<% end %>
