<%= form_with model: [:admin, solution], html: { novalidate: true }, class: "fr-mt-4w", data: surveille_les_modifications(solution) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <%= f.dsfr_check_box :visible %>
  <%= f.dsfr_text_field :nom %>
  <%= f.dsfr_text_field :slug, **champ_de_fiche(f, :slug) %>
  <%= f.dsfr_text_field :site_internet, **champ_de_fiche(f, :site_internet) %>
  <%= f.dsfr_text_field :url_demande_acces, **champ_de_fiche(f, :url_demande_acces) %>
  <%= render "admin/cases_filtrables", f: f, attribut: :organisation_ids, collection: Organisation.order(:nom), libelle: :nom, legende: "Organisations" %>
  <%= f.dsfr_file_field :image, accept: "image/png,image/jpeg,image/webp", **champ_de_fiche(f, :image) do %>
    <% if en_base&.image&.attached? %>
      <%= image_tag en_base.image, alt: en_base.legende_image.presence || "Image actuelle de #{en_base.nom}", width: 320, class: "fr-mt-2w" %>
      <div class="fr-checkbox-group fr-mt-1w">
        <%= check_box_tag "solution[retirer_image]", "1", params.dig(:solution, :retirer_image) == "1" %>
        <%= label_tag "solution_retirer_image", "Retirer l’image", class: "fr-label" %>
      </div>
    <% end %>
  <% end %>
  <%= f.dsfr_text_area :legende_image, **champ_de_fiche(f, :legende_image) %>
  <%= f.dsfr_text_area :description_courte, **champ_de_fiche(f, :description_courte) %>
  <%= f.dsfr_text_area :types_solution %>
  <%= f.dsfr_select :categorie, options_traduites(Solution, :categorie),
        data: { controller: "champs-fiche", action: "champs-fiche#basculer", champs_fiche_hors_fiches_value: Solution::HORS_FICHES } %>
  <%= render "admin/vocabulaires", f: f %>
  <%= render "admin/cases_filtrables", f: f, attribut: :type_acteur_ids, collection: TypeActeur.order(:nom), libelle: :nom, legende: "Fournisseurs de services" %>
  <%= f.dsfr_text_area :permet, **champ_de_fiche(f, :permet) %>
  <%= f.dsfr_text_area :ne_permet_pas, **champ_de_fiche(f, :ne_permet_pas) %>
  <%= f.dsfr_text_field :uid_datagouv %>
  <%= f.dsfr_check_box :france_connectee %>
  <% if solution.uid_datagouv_in_database.present? %>
    <div class="fr-mb-3w">
      <h2 class="fr-h6 fr-mb-1w">Repris de data.gouv.fr</h2>
      <ul>
        <li>Titre : <%= solution.datagouv_titre %></li>
        <li>Organisation : <%= solution.datagouv_organisation %></li>
        <li>Logo : <%= solution.datagouv_logo %></li>
        <li>Accès : <%= solution.datagouv_acces %></li>
        <li>Accès des acteurs publics : <%= solution.datagouv_acces_acteurs_publics %></li>
        <li>Badges de l’organisation : <%= solution.datagouv_organisation_badges.join(", ") %></li>
      </ul>
    </div>
  <% end %>
  <%= render "admin/identifiant_grist", grist_id: solution.grist_id %>
  <ul class="fr-btns-group fr-btns-group--inline">
    <li><button type="submit" class="fr-btn">Enregistrer</button></li>
    <li><%= link_to "Annuler", admin_solutions_path, class: "fr-btn fr-btn--secondary" %></li>
  </ul>
<% end %>
