<% if en_base %>
  <% listes = %i[fournies integrees integratrices].index_with { |liste| lignes_d_integrations(en_base, liste) } %>
  <% integrations_de_ses_api = Integration.where(id: en_base.integrations_de_ses_api.select(:id)).par_libelle_admin_de(:integratrice).preload(:integratrice, :integree).load %>
<% end %>
<%= form_with model: [:admin, solution], id: "formulaire-fiche", html: { novalidate: true }, data: surveille_les_modifications(solution) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <% fiche = capture do %>
    <%= f.dsfr_text_field :nom %>
    <%= f.dsfr_text_field :titre_seo, **champ_de_fiche(f, :titre_seo) %>
    <%= f.dsfr_text_field :slug, **champ_de_fiche(f, :slug) %>
    <%= f.dsfr_text_field :site_internet, **champ_de_fiche(f, :site_internet) %>
    <%= f.dsfr_text_field :url_demande_acces, **champ_de_fiche(f, :url_demande_acces) %>
    <%= render "admin/cases_filtrables", f: f, attribut: :organisation_ids, collection: Organisation.order(:nom), libelle: :nom, legende: "Organisations" %>
    <%= f.dsfr_file_field :image, accept: "image/png,image/jpeg,image/webp", **champ_de_fiche(f, :image) do %>
      <% image = en_base&.brouillon.to_h.key?("image") ? solution.image : en_base&.image %>
      <% if image&.attached? && image.blob.persisted? %>
        <%= image_tag image, alt: solution.legende_image.presence || "Image actuelle de #{en_base.nom}", width: 320, class: "fr-mt-2w" %>
        <div class="fr-checkbox-group fr-mt-1w">
          <%= check_box_tag "solution[retirer_image]", "1", params.dig(:solution, :retirer_image) == "1" %>
          <%= label_tag "solution_retirer_image", class: "fr-label" do %>
            Retirer l’image
            <span class="fr-hint-text">L’image sera retirée à l’enregistrement.</span>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <%= f.dsfr_text_field :legende_image, **champ_de_fiche(f, :legende_image) %>
    <%= f.dsfr_text_area :description_courte, **champ_de_fiche(f, :description_courte) %>
    <fieldset class="fr-fieldset" id="<%= f.field_id(:types_solution) %>">
      <legend class="fr-fieldset__legend">
        <%= Solution.human_attribute_name(:types_solution) %>
        <span class="fr-hint-text"><%= t("activerecord.hints.solution.types_solution") %></span>
      </legend>
      <%= f.collection_check_boxes :types_solution, Solution::TYPES_SOLUTION, :itself, :itself do |b| %>
        <div class="fr-fieldset__element">
          <div class="fr-checkbox-group">
            <%= b.check_box %>
            <%= b.label(class: "fr-label") %>
          </div>
        </div>
      <% end %>
    </fieldset>
    <%= f.dsfr_select :categorie, options_traduites(Solution, :categorie),
          data: { controller: "champs-fiche", action: "champs-fiche#basculer", champs_fiche_hors_fiches_value: Solution::HORS_FICHES } %>
    <%= render "admin/vocabulaires", f: f %>
    <%= render "admin/cases_filtrables", f: f, attribut: :type_acteur_ids, collection: TypeActeur.order(:nom), libelle: :nom, legende: "Fournisseurs de services", referentiel: true %>
    <%= f.dsfr_text_area :permet, **champ_de_fiche(f, :permet) %>
    <%= f.dsfr_text_area :ne_permet_pas, **champ_de_fiche(f, :ne_permet_pas) %>
    <%= f.dsfr_text_field :uid_datagouv %>
    <%= f.dsfr_check_box :france_connectee %>
    <% if solution.uid_datagouv_in_database.present? %>
      <div class="fr-mb-3w">
        <h2 class="fr-h6 fr-mb-1w">Repris de data.gouv.fr</h2>
        <% if solution.datagouv_titre.blank? %>
          <div class="fr-alert fr-alert--info fr-alert--sm fr-mb-1w">
            <p>Rien n’a été repris de data.gouv.fr pour cet identifiant : data.gouv.fr ne le connaît pas ou n’a pas répondu. Nouvel essai chaque nuit.</p>
          </div>
        <% end %>
        <ul>
          <li>Titre : <%= solution.datagouv_titre %></li>
          <li>Organisation : <%= solution.datagouv_organisation %></li>
          <li>Logo : <%= solution.datagouv_logo %></li>
          <li>Accès : <%= solution.datagouv_acces %></li>
          <li>Accès des acteurs publics : <%= solution.datagouv_acces_acteurs_publics %></li>
          <li>Badges de l’organisation : <%= solution.datagouv_organisation_badges.join(", ") %></li>
        </ul>
      </div>
    <% end %>
  <% end %>
  <% if en_base %>
    <% integratrices = capture do %>
      <%= render "integrations", liste: :integratrices, lignes: listes[:integratrices] %>
      <% if integrations_de_ses_api.any? %>
        <ul>
          <% integrations_de_ses_api.each do |integration| %>
            <li><%= integration.integratrice.libelle_admin %> — via <%= integration.integree.libelle_admin %> <%= lien_vers_la_fiche(integration.integree, integration.integree.libelle_admin) %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
    <% libelles = libelles_des_onglets_d_integrations(en_base) %>
    <% demarches = en_base.demarches_recommandantes.order(:nom).load %>
    <div id="message-integrations" role="status"></div>
    <%= render "admin/onglets", objet: solution, onglets: {
          "fiche" => ["Fiche", fiche],
          "api-fournies" => [libelles["api-fournies"], render("integrations", liste: :fournies, lignes: listes[:fournies])],
          "api-integrees" => [libelles["api-integrees"], render("integrations", liste: :integrees, lignes: listes[:integrees])],
          "integratrices" => [libelles["integratrices"], integratrices],
          "recommandee-dans" => ["Recommandée dans (#{demarches.size})", render("admin/liens_vers_les_fiches", lignes: demarches, vide: "Aucune démarche ne la recommande.")],
          "historique" => ["Historique", render("admin/historiques/versions", ligne: en_base)]
        } %>
  <% else %>
    <%= fiche %>
  <% end %>
<% end %>
<% if listes %>
  <div id="formulaires-integrations">
    <% listes.each do |liste, lignes| %>
      <%= render partial: "admin/integrations/formulaire_de_ligne", collection: lignes, as: :ligne, locals: { liste: } %>
    <% end %>
  </div>
<% end %>
