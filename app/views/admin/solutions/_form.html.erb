<%= form_with model: [:admin, solution], class: "fr-mt-4w", data: surveille_les_modifications(solution) do |f| %>
  <%= render "admin/erreurs", f: f %>
  <div class="fr-checkbox-group fr-mb-3w">
    <%= f.check_box :visible %>
    <%= f.label :visible, class: "fr-label" %>
  </div>
  <%= groupe_de_champ(f, :nom) do |aria| %>
    <%= f.label :nom, class: "fr-label" %>
    <%= f.text_field :nom, class: "fr-input", **aria %>
  <% end %>
  <%= groupe_de_champ(f, :slug) do |aria| %>
    <%= libelle_avec_aide(f, :slug, "Minuscules sans accent, chiffres et tirets, ex. : cantine-scolaire") %>
    <%= f.text_field :slug, class: "fr-input", **aria %>
  <% end %>
  <%= groupe_de_champ(f, :site_internet) do |aria| %>
    <%= f.label :site_internet, class: "fr-label" %>
    <%= f.text_field :site_internet, class: "fr-input", **aria %>
  <% end %>
  <%= groupe_de_champ(f, :url_demande_acces) do |aria| %>
    <%= f.label :url_demande_acces, class: "fr-label" %>
    <%= f.text_field :url_demande_acces, class: "fr-input", **aria %>
  <% end %>
  <fieldset class="fr-fieldset">
    <legend class="fr-fieldset__legend">Organisations</legend>
    <%= f.collection_check_boxes :organisation_ids, Organisation.order(:nom), :id, :nom do |b| %>
      <div class="fr-fieldset__element">
        <div class="fr-checkbox-group">
          <%= b.check_box %>
          <%= b.label(class: "fr-label") %>
        </div>
      </div>
    <% end %>
  </fieldset>
  <%= groupe_de_champ(f, :image, "fr-upload-group") do |aria| %>
    <%= f.label :image, class: "fr-label" %>
    <%= f.file_field :image, class: "fr-upload", accept: "image/*", **aria %>
  <% end %>
  <%= groupe_de_champ(f, :legende_image) do |aria| %>
    <%= f.label :legende_image, class: "fr-label" %>
    <%= f.text_area :legende_image, class: "fr-input", rows: 6, **aria %>
  <% end %>
  <%= groupe_de_champ(f, :description_courte) do |aria| %>
    <%= f.label :description_courte, class: "fr-label" %>
    <%= f.text_area :description_courte, class: "fr-input", rows: 6, **aria %>
  <% end %>
  <div class="fr-input-group">
    <%= libelle_avec_aide(f, :types_solution, "Une valeur par ligne, affichées sous le nom de la solution, ex. : Portail agent") %>
    <%= f.text_area :types_solution, value: solution.types_solution.join("\n"), class: "fr-input", rows: 4 %>
  </div>
  <div class="fr-select-group">
    <%= f.label :categorie, class: "fr-label" %>
    <%= f.select :categorie, options_traduites(Solution, :categorie), { include_blank: true }, class: "fr-select" %>
  </div>
  <fieldset class="fr-fieldset">
    <legend class="fr-fieldset__legend">Vocabulaires</legend>
    <%= f.collection_check_boxes :vocabulaire_ids, Vocabulaire.order(:nom), :id, :nom do |b| %>
      <div class="fr-fieldset__element">
        <div class="fr-checkbox-group">
          <%= b.check_box %>
          <%= b.label(class: "fr-label") %>
        </div>
      </div>
    <% end %>
  </fieldset>
  <fieldset class="fr-fieldset">
    <legend class="fr-fieldset__legend">Types d'acteurs</legend>
    <%= f.collection_check_boxes :type_acteur_ids, TypeActeur.order(:nom), :id, :nom do |b| %>
      <div class="fr-fieldset__element">
        <div class="fr-checkbox-group">
          <%= b.check_box %>
          <%= b.label(class: "fr-label") %>
        </div>
      </div>
    <% end %>
  </fieldset>
  <%= groupe_de_champ(f, :permet) do |aria| %>
    <%= f.label :permet, class: "fr-label" %>
    <%= f.text_area :permet, class: "fr-input", rows: 6, **aria %>
  <% end %>
  <%= groupe_de_champ(f, :ne_permet_pas) do |aria| %>
    <%= f.label :ne_permet_pas, class: "fr-label" %>
    <%= f.text_area :ne_permet_pas, class: "fr-input", rows: 6, **aria %>
  <% end %>
  <div class="fr-input-group">
    <%= libelle_avec_aide(f, :uid_datagouv, "Pour une API ou un jeu de données : identifiant de sa fiche data.gouv.fr, d’où sont repris son titre, son organisation et son accès.") %>
    <%= f.text_field :uid_datagouv, class: "fr-input" %>
  </div>
  <div class="fr-checkbox-group fr-mb-3w">
    <%= f.check_box :france_connectee %>
    <%= libelle_avec_aide(f, :france_connectee, "L’API est accessible avec FranceConnect : elle figure dans l’article sur les API FranceConnectées.") %>
  </div>
  <% if solution.uid_datagouv_in_database.present? %>
    <div class="fr-mb-3w">
      <h2 class="fr-h6 fr-mb-1w">Repris de data.gouv.fr</h2>
      <ul>
        <li>Titre : <%= solution.datagouv_titre %></li>
        <li>Organisation : <%= solution.datagouv_organisation %></li>
        <li>Logo : <%= solution.datagouv_logo %></li>
        <li>Accès : <%= solution.datagouv_acces %></li>
        <li>Accès des acteurs publics : <%= solution.datagouv_acces_acteurs_publics %></li>
        <li>Badges de l’organisation : <%= solution.datagouv_organisation_badges.join(", ") %></li>
      </ul>
    </div>
  <% end %>
  <%= render "admin/identifiant_grist", grist_id: solution.grist_id %>
  <ul class="fr-btns-group fr-btns-group--inline">
    <li><button type="submit" class="fr-btn">Enregistrer</button></li>
    <li><%= link_to "Annuler", admin_solutions_path, class: "fr-btn fr-btn--secondary" %></li>
  </ul>
<% end %>
