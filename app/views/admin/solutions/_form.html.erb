<%= form_with model: [:admin, solution], class: "fr-mt-4w" do |f| %>
  <% if solution.errors.any? %>
    <div class="fr-alert fr-alert--error">
      <ul>
        <% solution.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="fr-input-group">
    <%= f.label :nom, class: "fr-label" %>
    <%= f.text_field :nom, class: "fr-input" %>
  </div>
  <div class="fr-select-group">
    <%= f.label :categorie, class: "fr-label" %>
    <%= f.select :categorie, Solution.categories.keys, { include_blank: true }, class: "fr-select" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :slug, class: "fr-label" %>
    <%= f.text_field :slug, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :description_courte, class: "fr-label" %>
    <%= f.text_area :description_courte, class: "fr-input", rows: 6 %>
  </div>
  <div class="fr-input-group">
    <%= f.label :permet, class: "fr-label" %>
    <%= f.text_area :permet, class: "fr-input", rows: 6 %>
  </div>
  <div class="fr-input-group">
    <%= f.label :ne_permet_pas, class: "fr-label" %>
    <%= f.text_area :ne_permet_pas, class: "fr-input", rows: 6 %>
  </div>
  <div class="fr-upload-group">
    <%= f.label :image, class: "fr-label" %>
    <%= f.file_field :image, class: "fr-upload", accept: "image/*" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :legende_image, class: "fr-label" %>
    <%= f.text_area :legende_image, class: "fr-input", rows: 6 %>
  </div>
  <div class="fr-input-group">
    <%= f.label :site_internet, class: "fr-label" %>
    <%= f.text_field :site_internet, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :url_demande_acces, class: "fr-label" %>
    <%= f.text_field :url_demande_acces, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :uid_datagouv, class: "fr-label" %>
    <%= f.text_field :uid_datagouv, class: "fr-input" %>
  </div>
  <div class="fr-checkbox-group">
    <%= f.check_box :france_connectee %>
    <%= f.label :france_connectee, class: "fr-label" %>
  </div>
  <div class="fr-checkbox-group">
    <%= f.check_box :visible %>
    <%= f.label :visible, class: "fr-label" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :cree_le, class: "fr-label" %>
    <%= f.datetime_field :cree_le, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :modifie_le, class: "fr-label" %>
    <%= f.datetime_field :modifie_le, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :grist_id, class: "fr-label" %>
    <%= f.text_field :grist_id, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :datagouv_titre, class: "fr-label" %>
    <%= f.text_field :datagouv_titre, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :datagouv_organisation, class: "fr-label" %>
    <%= f.text_field :datagouv_organisation, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :datagouv_logo, class: "fr-label" %>
    <%= f.text_field :datagouv_logo, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :datagouv_acces, class: "fr-label" %>
    <%= f.text_field :datagouv_acces, class: "fr-input" %>
  </div>
  <div class="fr-input-group">
    <%= f.label :datagouv_acces_acteurs_publics, class: "fr-label" %>
    <%= f.text_field :datagouv_acces_acteurs_publics, class: "fr-input" %>
  </div>
  <ul class="fr-btns-group fr-btns-group--inline">
    <li><button type="submit" class="fr-btn">Enregistrer</button></li>
    <li><%= link_to "Annuler", admin_solutions_path, class: "fr-btn fr-btn--secondary" %></li>
  </ul>
<% end %>
