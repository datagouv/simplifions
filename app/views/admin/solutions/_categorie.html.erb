<%# locals: (f:) -%>
<% solution = f.object %>
<% libelle = solution.categorie ? Solution.human_attribute_name("categorie.#{solution.categorie}") : "non renseignée" %>
<% bouton = solution.categorie ? "Changer de catégorie" : "Choisir la catégorie" %>
<div class="fr-mb-3w">
  <p class="fr-mb-1w"><strong><%= Solution.human_attribute_name(:categorie) %> :</strong> <%= libelle %></p>
  <p class="fr-hint-text fr-mb-1w"><%= t("activerecord.hints.solution.categorie") %></p>
  <button type="button" class="fr-btn fr-btn--sm fr-btn--secondary" aria-controls="fenetre-categorie" data-fr-opened="false"><%= bouton %></button>
</div>
<%= f.hidden_field :categorie %>
<%= render layout: "admin/dialogue", locals: { id: "categorie", titre: bouton, ouverte: false, pied: false } do %>
  <%= render "choix_de_categorie", nom: "nouvelle_categorie", legende: "Nouvelle catégorie", aide: ->(categorie) { effet_du_changement_de_categorie(solution, categorie) }, choisie: solution.categorie,
        refusee: ->(categorie) { !solution.categorie_possible?(categorie) } %>
  <p>Les champs communs restent remplis.</p>
  <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-lg">
    <li><button type="button" class="fr-btn fr-btn--secondary" aria-controls="fenetre-categorie">Annuler</button></li>
    <li><button type="submit" form="formulaire-fiche" name="changer_de_categorie" value="1" class="fr-btn">Changer et enregistrer</button></li>
  </ul>
<% end %>
