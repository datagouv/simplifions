<%= render "entete_page", titre: "Solutions" %>

<div class="fr-container fr-mb-6w">
  <h1>Solutions</h1>
  <%= link_to "Ajouter", new_admin_solution_path, class: "fr-btn fr-mb-3w" %>
  <%= render "recherche", total: @solutions.total_count %>
  <div class="fr-table">
    <table>
      <thead>
        <tr>
          <th>Id</th>
          <th>Nom</th>
          <th>Privée</th>
          <th>Visible</th>
          <th>Modifié le</th>
          <th>Intégrée par</th>
        </tr>
      </thead>
      <tbody>
        <% @solutions.each do |ligne| %>
          <tr>
            <td><%= ligne.id %></td>
            <td><%= link_to ligne.libelle_admin, edit_admin_solution_path(ligne) %></td>
            <td><p class="fr-badge fr-badge--sm fr-badge--no-icon"><%= ligne.privee? ? "Oui" : "Non" %></p></td>
            <%= render "visible_et_modifie_le", ligne: %>
            <td><%= safe_join(ligne.integratrices.sort_by { |integratrice| integratrice.libelle_admin.downcase }.map { |integratrice| link_to integratrice.libelle_admin, edit_admin_solution_path(integratrice) }, ", ") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= pagination @solutions, %w[q] %>
</div>
