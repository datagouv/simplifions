<%= render "entete_page", titre: "Solutions" %>

<div class="fr-container fr-mb-6w">
  <h1>Solutions</h1>
  <%= link_to "Ajouter", new_admin_solution_path, class: "fr-btn fr-mb-3w" %>
  <%= render "recherche" %>
  <div class="fr-table">
    <table>
      <thead>
        <tr>
          <th>Id</th>
          <th>Nom</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @solutions.each do |ligne| %>
          <tr>
            <td><%= ligne.id %></td>
            <td><%= ligne.nom %></td>
            <td>
              <%= link_to "Modifier", edit_admin_solution_path(ligne), class: "fr-btn fr-btn--secondary fr-btn--sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "pagination" %>
</div>
