<%# locals: (liste:, lignes:) -%>
<p class="fr-text--sm"><%= t("admin.sans_brouillon") %></p>
<h2 id="integrations-<%= liste %>" class="fr-h6 fr-mb-1w"><%= t("admin.integrations_de_la_solution.#{liste}") %></h2>
<div class="fr-table"><div class="fr-table__wrapper"><div class="fr-table__container"><div class="fr-table__content">
  <table class="lignes-modifiables lignes-integrations" aria-labelledby="integrations-<%= liste %>">
    <thead>
      <tr>
        <th scope="col"><%= Integration.human_attribute_name(:"#{colonne_de_la_liste(liste)}_id") %> (obligatoire)</th>
        <th scope="col"><%= liste == :integratrices ? "#{Integration.human_attribute_name(:type_integration)} (obligatoire) et statut" : "Statut" %></th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <%= tag.tbody id: "lignes-#{liste}", data: ({ controller: "rangement" } if liste == :fournies) do %>
      <%= render partial: "admin/integrations/ligne", collection: lignes, locals: { liste: } %>
    <% end %>
  </table>
</div></div></div></div>
