<% operateur = solution.organisations.first %>
<div class="solution-integratrice-card fr-enlarge-link">
  <div class="solution-integratrice-card__header">
    <p class="solution-integratrice-card__title fr-text--lg"><%= link_to_if solution.slug.present?, solution.nom, solution_path(solution.slug) %></p>
    <% if operateur %>
      <p class="fr-badge fr-badge--sm fr-badge--no-icon <%= solution.privee? ? 'fr-badge--green-tilleul-verveine' : 'fr-badge--blue-ecume' %>">
        <span class="font-weight-normal"><%= solution.privee? ? 'Solution privée' : 'Solution publique' %> | <b><%= operateur.nom %></b></span>
      </p>
    <% end %>
  </div>
  <% if local_assigns[:couverture] %>
    <% tags = solution.vocabulaires.categorie_type_simplification.map(&:nom) %>
    <% if tags.any? %>
      <ul class="fr-tags-group fr-mt-2v">
        <% tags.each do |tag| %>
          <li><p class="fr-tag fr-tag--sm"><%= tag %></p></li>
        <% end %>
      </ul>
    <% end %>
    <% if couverture.any? %>
      <p class="fr-text--sm fr-text--bold fr-mb-1v">Cas d'usages :</p>
      <div class="cas-usages-grid">
        <% couverture.each do |demarche, (integrees, utiles)| %>
          <% pourcentage = integrees * 100 / utiles %>
          <div class="cas-usage-card fr-p-2v">
            <span class="fr-text--xs fr-text--bold fr-mb-1v"><%= "#{demarche.icone} #{demarche.nom}".strip %></span>
            <div class="integration-indicator fr-p-1w">
              <span class="fr-text--sm fr-text--bold integration-indicator__count <%= pourcentage >= 75 ? 'indicator--green' : pourcentage >= 50 ? 'indicator--yellow' : pourcentage >= 25 ? 'indicator--orange' : 'indicator--red' %>"><%= integrees %>/<%= utiles %></span>
              <span class="fr-text--xs integration-indicator__label">API ou jeux de données intégrés</span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <div class="solution-integratrice-card__arrow">
    <span aria-hidden="true" class="fr-icon-arrow-right-line fr-icon--lg"></span>
  </div>
</div>
