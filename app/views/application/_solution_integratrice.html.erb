<% modale_id = "modale-#{contexte}-#{solution.id}" %>
<div class="solution-integratrice-card">
  <div class="solution-integratrice-card__header">
    <p class="solution-integratrice-card__title fr-text--lg fr-text--bold"><%= link_to_if solution.slug.present?, solution.nom, solution_path(solution.slug) %></p>
    <%= render "badge_operateur", solution: solution %>
  </div>
  <% if solution.types_solution.any? %>
    <p class="fr-text--sm fr-mb-0"><%= solution.types_solution.join(' • ') %></p>
  <% end %>
  <% if couverture %>
    <% nombre_integrees, nombre_utiles = couverture
       couleur = couleur_integration(nombre_integrees, nombre_utiles)
       donnee_unique_integree = local_assigns[:libelle_unique] && couverture == [1, 1]
       couleur_libelle = local_assigns[:libelle_unique] ? 'fr-text-default--grey' : 'fr-text-mention--grey' %>
    <div class="integration-indicator fr-p-1w">
      <% if donnee_unique_integree %>
        <span class="fr-text--sm integration-indicator__count indicator--green fr-icon-check-line fr-icon--sm" aria-hidden="true"></span>
        <span class="fr-text--xs <%= couleur_libelle %>"><%= libelle_unique %></span>
      <% else %>
        <span class="fr-text--sm fr-text--bold integration-indicator__count indicator--<%= couleur %>"><%= nombre_integrees %>/<%= nombre_utiles %></span>
        <span class="fr-text--xs <%= couleur_libelle %>"><%= libelle %></span>
      <% end %>
      <button type="button" class="integration-indicator__oeil fr-btn fr-btn--sm fr-btn--tertiary-no-outline fr-icon-eye-line"
        aria-controls="<%= modale_id %>" data-fr-opened="false" title="Voir les données intégrées par <%= solution.nom %>">
        Voir les données intégrées par <%= solution.nom %>
      </button>
      <% if local_assigns[:couverture_globale] %>
        <% total_integrees, total_utiles = couverture_globale %>
        <p class="integration-indicator__total fr-text-mention--grey">
          <span class="fr-text--bold integration-indicator__count integration-indicator__count--attenue indicator--<%= couleur_integration(total_integrees, total_utiles) %>"><%= total_integrees %>/<%= total_utiles %></span>
          <span>API ou jeux de données au total pour ce cas d’usage</span>
        </p>
      <% end %>
    </div>
    <% content_for :modales do %>
      <%= render 'modale_integrations', modale_id:, solution:, groupes:, integrees:,
            nombre_integrees:, nombre_utiles:, nom_demarche:, donnee_courante: local_assigns[:donnee_courante],
            couverture_globale: local_assigns[:couverture_globale] %>
    <% end %>
  <% end %>
  <% if solution.slug.present? %>
    <p class="solution-integratrice-card__fiche fr-mb-0">
      <%= link_to solution_path(solution.slug), class: 'fr-link fr-icon-arrow-right-line fr-link--icon-right' do %>
        Voir la fiche<span class="fr-sr-only"> <%= solution.nom %></span>
      <% end %>
    </p>
  <% end %>
</div>
