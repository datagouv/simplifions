<div class="solution-integratrice-card">
  <div class="solution-integratrice-card__header">
    <p class="solution-integratrice-card__title fr-text--lg fr-text--bold"><%= link_to_if solution.slug.present?, solution.nom, solution_path(solution.slug) %></p>
    <%= render "badge_operateur", solution: solution %>
  </div>
  <% if solution.types_solution.any? %>
    <p class="fr-text--sm fr-mb-0"><%= solution.types_solution.join(' • ') %></p>
  <% end %>
  <% if couverture == [1, 1] %>
    <p class="integration-indicator fr-p-1w">
      <span aria-hidden="true" class="fr-text--sm integration-indicator__count indicator--green fr-icon-check-line fr-icon--sm"></span>
      <span class="fr-text--xs">Donnée utile de « <%= cible.nom %> » intégrée</span>
    </p>
  <% elsif couverture %>
    <% integrees, utiles = couverture
       type = cible.categorie_api? ? 'API' : cible.categorie_base_de_donnees? ? 'jeu de données' : 'API ou jeu de données' %>
    <%= render 'integration_indicator', integrees:, utiles:, label: "#{type} utiles #{cible.nom}",
          description: "#{type} « #{cible.nom} » sur les #{utiles} utiles pour ce cas d'usage ont été intégrées par cette solution." %>
  <% end %>
  <% if solution.slug.present? %>
    <p class="solution-integratrice-card__fiche fr-mb-0">
      <%= link_to solution_path(solution.slug), class: 'fr-link fr-icon-arrow-right-line fr-link--icon-right' do %>
        Voir la fiche<span class="fr-sr-only"> <%= solution.nom %></span>
      <% end %>
    </p>
  <% end %>
</div>
