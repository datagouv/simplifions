<% types = { Demarche => ["Cas d'usages", DemarcheCardComponent, :demarches_path],
             Solution => ['Solutions', SolutionCardComponent, :solutions_path] }
   titre, carte, chemin = types.fetch(@catalogue.klass)
   total = @catalogue.count
   pages = [(total / 20.0).ceil, 1].max
   page = @filtres[:page].to_i.clamp(1, pages)
   resultats = @catalogue.offset((page - 1) * 20).limit(20)
   requete = @filtres.to_h.except('page').compact_blank
   facettes = [['fournisseurs-de-service', 'Démarches gérées par :', "Tous les types d'acteurs", TypeActeur::FILTRES.to_a],
               ['target-users', 'Démarches à destination des :', 'Tous les usagers', Vocabulaire.categorie_usager.choix],
               ['categorie-de-solution', 'Catégorie de solution :', 'Toutes les catégories', Vocabulaire.categorie_solution.choix],
               ['types-de-simplification', 'Type de simplification des démarches :', 'Tous les types de simplification', Vocabulaire.categorie_type_simplification.choix]] %>
<div class="fr-container">
  <%= render "breadcrumb", id: "breadcrumb-catalogue", liens: [["Accueil", root_path], [titre, nil]] %>
</div>

<div class="fr-container fr-my-2v">
  <div class="fr-grid-row fr-grid-row--middle fr-mb-3w">
    <h1 class="fr-mb-0"><%= titre %></h1>
  </div>
</div>

<section class="fr-container fr-mb-4w">
  <h2 class="fr-mb-2w">Filtrer les <%= titre.downcase %></h2>
  <%= form_with url: send(chemin), method: :get, class: "catalogue", data: { controller: "form" } do |f| %>
    <div class="fr-search-bar fr-search-bar--lg" role="search">
      <%= f.label :q, "Recherche", class: "fr-label" %>
      <%= f.search_field :q, value: @filtres[:q], class: "fr-input", placeholder: "Recherche" %>
      <button type="submit" class="fr-btn">Recherche</button>
    </div>

    <div class="fr-grid-row fr-grid-row--gutters fr-mt-2w">
      <div class="fr-col-12 fr-col-md-4 fr-col-lg-3">
        <p class="fr-text--sm fr-text--bold fr-mb-2w">Type</p>
        <ul class="catalogue-types list-none fr-p-0 fr-mb-4w">
          <% types.each do |klass, (nom, _, chemin_type)| %>
            <li class="<%= 'catalogue-types__actif' if klass == @catalogue.klass %>">
              <%= link_to send(chemin_type, requete), class: "fr-grid-row fr-grid-row--middle fr-text--sm fr-p-1v" do %>
                <span class="fr-icon-book-2-line fr-icon--sm fr-mr-1w" aria-hidden="true"></span>
                <span class="fr-col"><%= nom %></span>
                <span class="fr-badge fr-badge--sm fr-badge--no-icon"><%= klass == @catalogue.klass ? total : klass.catalogue(@filtres).count %></span>
              <% end %>
            </li>
          <% end %>
        </ul>

        <p class="fr-text--sm fr-text--bold fr-mb-2w">Filtres</p>
        <% facettes.each do |nom, label, tous, options| %>
          <div class="fr-select-group">
            <%= f.label nom, label, class: "fr-label" %>
            <%= f.select nom, options, { include_blank: tous, selected: @filtres[nom] },
                  class: "fr-select", data: { action: "change->form#submit" } %>
          </div>
        <% end %>
      </div>

      <section class="fr-col-12 fr-col-md-8 fr-col-lg-9">
        <div class="fr-grid-row fr-grid-row--middle fr-grid-row--gutters" style="justify-content: space-between">
          <p class="fr-col-auto fr-my-0" role="status"><%= total %> résultat<%= 's' if total > 1 %></p>
          <div class="fr-col-auto fr-grid-row fr-grid-row--middle">
            <%= f.label :sort, "Trier par :", class: "fr-col-auto fr-text--sm fr-m-0 fr-mr-1w" %>
            <%= f.select :sort, [["Pertinence", ""], ["Date de création", "-created"], ["Dernière mise à jour", "-last_modified"]],
                  { selected: @filtres[:sort] }, class: "fr-select fr-col", data: { action: "change->form#submit" } %>
          </div>
        </div>

        <ul class="list-none fr-p-0 fr-mt-1w">
          <% resultats.each do |resultat| %>
            <li class="fr-mb-2w"><%= render carte.pour(resultat) %></li>
          <% end %>
        </ul>
        <%= render "pagination", page:, pages:, chemin:, requete: %>
      </section>
    </div>
  <% end %>
</section>
