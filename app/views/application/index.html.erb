<% types = { Demarche => ["Cas d'usages", DemarcheCardComponent, :demarches_path],
             Solution => ['Solutions', SolutionCardComponent, :solutions_path] }
   titre, carte, chemin = types.fetch(@catalogue.klass)
   content_for :title, titre
   total = @catalogue.total_count
   requete = @filtres.to_h.compact_blank
   tout = @catalogue.klass.catalogue({}).count
   facettes = [['target-users', 'Démarches à destination des', Vocabulaire.categorie_usager.choix],
               ['fournisseurs-de-service', 'Démarches gérées par', TypeActeur::FILTRES.to_a],
               ['categorie-de-solution', 'Solution recherchée', Vocabulaire.categorie_solution.choix],
               ['types-de-simplification', 'Type de simplification des démarches', Vocabulaire.categorie_type_simplification.choix]] %>
<div class="fr-container">
  <%= render "breadcrumb", id: "breadcrumb-catalogue", liens: [["Accueil", root_path], [titre, nil]] %>
</div>

<div class="fr-container fr-my-2v">
  <div class="fr-grid-row fr-grid-row--middle fr-mb-3w">
    <h1 class="fr-mb-0"><%= titre %></h1>
  </div>
</div>

<section class="fr-container fr-mb-4w">
  <h2 class="fr-sr-only">Filtrer les <%= titre.downcase %></h2>
  <%= form_with url: send(chemin, anchor: 'resultats'), method: :get, class: "catalogue",
        data: { controller: "filtres-catalogue", action: "submit->filtres-catalogue#retenir formdata->filtres-catalogue#nettoyer turbo:before-fetch-request->filtres-catalogue#nettoyer", matomo_recherche: @filtres[:q]&.downcase,matomo_catalogue: titre, matomo_resultats: total } do |f| %>
    <div class="fr-search-bar fr-search-bar--lg" role="search">
      <%= f.label :q, "Rechercher", class: "fr-label" %>
      <%= f.search_field :q, value: @filtres[:q], class: "fr-input", placeholder: "Rechercher" %>
      <button type="submit" class="fr-btn">Rechercher</button>
    </div>

    <div class="fr-grid-row fr-grid-row--gutters fr-mt-2w">
      <div class="fr-col-12 fr-col-md-4 fr-col-lg-3" <%= tag.attributes(data: matomo_zone("Catalogue #{titre.downcase} › Filtres")) %>>
        <p class="fr-text--sm fr-text--bold fr-mb-2w">Type</p>
        <ul class="catalogue-types list-none fr-p-0 fr-mb-4w" <%= tag.attributes(data: matomo_zone("Catalogue #{titre.downcase} › Type")) %>>
          <% types.each do |klass, (nom, _, chemin_type)| %>
            <li class="<%= 'catalogue-types__actif' if klass == @catalogue.klass %>">
              <%= link_to send(chemin_type, requete), class: "fr-grid-row fr-grid-row--middle fr-text--sm fr-p-1v",
                    data: { matomo_action: "Changer de catalogue", matomo_nom: nom } do %>
                <span class="fr-icon-book-2-line fr-icon--sm fr-mr-1w" aria-hidden="true"></span>
                <span class="fr-col"><%= nom %></span>
                <span class="fr-badge fr-badge--sm fr-badge--no-icon"><%= klass == @catalogue.klass ? total : klass.catalogue(@filtres).count %></span>
              <% end %>
            </li>
          <% end %>
        </ul>

        <p class="fr-text--sm fr-text--bold fr-mb-2w">Filtres</p>
        <% *principales, (nom_plus, label_plus, options_plus) = facettes %>
        <% principales.each do |nom, label, options| %>
          <%= render "facette_tags", f:, nom:, label:, options: %>
        <% end %>
        <%= tag.details class: "filtres-depliables", open: @filtres[nom_plus].present? do %>
          <summary class="fr-link fr-icon-arrow-down-s-line fr-link--icon-right fr-mb-2w">Plus de filtres</summary>
          <%= render "facette_tags", f:, nom: nom_plus, label: label_plus, options: options_plus %>
        <% end %>
      </div>

      <section id="list" class="fr-col-12 fr-col-md-8 fr-col-lg-9" <%= tag.attributes(data: matomo_zone("Catalogue #{titre.downcase} › Résultats")) %>>
        <% if total.zero? %>
          <div class="catalogue-vide fr-grid-row fr-grid-row--gutters fr-p-3w fr-mt-2w">
            <div class="fr-col-auto"><%= image_tag "simplifions/magnifying_glass.svg", alt: "", class: "catalogue-vide__loupe" %></div>
            <div class="fr-col">
              <p class="fr-text--bold fr-mb-1w">Vous n'avez pas trouvé ce que vous cherchez ?</p>
              <p class="fr-mb-2w">Essayez de réinitialiser les filtres pour élargir votre recherche.</p>
              <%= link_to "Réinitialiser les filtres", send(chemin), class: "fr-btn fr-btn--secondary fr-btn--sm",
                    data: { matomo_action: "Réinitialiser les filtres" } %>
            </div>
          </div>
        <% else %>
          <div class="fr-grid-row fr-grid-row--middle fr-grid-row--gutters" style="justify-content: space-between">
            <p id="resultats" class="fr-col-auto fr-my-0" tabindex="-1" data-filtres-catalogue-target="compteur" role="status"><%= total %> résultat<%= 's' if total > 1 %><%= " sur #{tout}" if total < tout %></p>
            <div class="fr-col-auto">
              <div class="fr-grid-row fr-grid-row--middle">
                <%= f.label :sort, "Trier par :", class: "fr-col-auto fr-text--sm fr-m-0 fr-mr-1w" %>
                <%= f.select :sort, [["Pertinence", ""], ["Date de création", "-created"], ["Dernière mise à jour", "-last_modified"]],
                      { selected: @filtres[:sort] }, class: "fr-select fr-col", aria: { describedby: "aide-tri" },
                      data: { matomo_action: "Trier les résultats", filtres_catalogue_target: "tri", action: "change->filtres-catalogue#comparerTri" } %>
                <span id="aide-tri" class="fr-sr-only">Le tri s’applique avec le bouton Trier qui suit.</span>
              </div>
              <div class="fr-grid-row fr-grid-row--right fr-mt-1w" data-filtres-catalogue-target="boutonTri">
                <%= f.button "Trier", name: nil, class: "fr-btn fr-btn--secondary fr-btn--sm" %>
              </div>
            </div>
          </div>

          <ul class="list-none fr-p-0 fr-mt-1w">
            <% position_du_guide = [@catalogue.size, 3].min %>
            <% @catalogue.each.with_index(1) do |resultat, position| %>
              <li class="fr-mb-2w"><%= render carte.pour(resultat) %></li>
              <% if @guide && position == position_du_guide %>
                <li class="fr-my-4w">
                  <div class="fr-grid-row">
                    <p class="fr-col-12 fr-col-md-10 fr-col-offset-md-1 fr-text--md fr-text--alt fr-mb-2w"><span class="fr-text--bold">Vous êtes une mairie ou une petite collectivité ?</span> Nous vous recommandons cet article :</p>
                    <div class="fr-col-12 fr-col-md-10 fr-col-offset-md-1">
                      <%= render ArticleCardComponent.new(article: @guide, horizontal: true) %>
                    </div>
                  </div>
                </li>
              <% end %>
            <% end %>
          </ul>
          <%= pagination @catalogue, ApplicationController::FILTRES_CATALOGUE %>
        <% end %>
      </section>
    </div>
  <% end %>
</section>

<% if @catalogue.klass == Demarche %>
  <section class="fond-beige-gris-galet" aria-labelledby="titre-proposer-demarche"
    <%= tag.attributes(data: matomo_zone("Catalogue cas d'usages › Proposer")) %>>
    <div class="fr-container fr-py-3w">
      <h2 id="titre-proposer-demarche" class="fr-h4"><span aria-hidden="true">✒️</span> Proposer une nouvelle démarche</h2>
      <p>
        Une démarche manque ? Écrivez-nous pour
        <%= lien_nouvel_onglet "proposer une nouvelle démarche", contact_path("nouveau-cas-usage"),
            data: { matomo_action: "Proposer une nouvelle démarche" } %>.
      </p>
      <%= link_to "Doctrine de référencement des démarches", doctrine_referencement_cas_usages_path,
            class: "fr-link fr-icon-arrow-right-line fr-link--icon-right", data: { matomo_action: "Lire la doctrine" } %>
    </div>
  </section>
<% end %>
