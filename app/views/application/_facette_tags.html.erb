<% visibles, autres = tags.partition.with_index { |_, index| index < 4 } %>
<p id="titre-<%= id %>" class="fr-text--bold fr-mb-1w"><%= label %></p>
<% if autres.any? %>
  <%= render "tags_de_filtre", f:, id:, tags: visibles, marge: "fr-mb-0" %>
  <%= tag.details class: "filtres-depliables fr-mb-2w", open: autres.any? { it[:choisi] } do %>
    <summary class="fr-link fr-link--sm fr-icon-arrow-down-s-line fr-link--icon-right fr-mb-1w">Afficher les <%= autres.size %> autres</summary>
    <%= render "tags_de_filtre", f:, id:, tags: autres, marge: "fr-mb-0" %>
  <% end %>
<% else %>
  <%= render "tags_de_filtre", f:, id:, tags: visibles %>
<% end %>
