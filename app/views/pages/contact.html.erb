<% etape = render "pages/contact/#{(@besoin || 'besoins').tr('-', '_')}" %>
<% content_for :title, safe_join([content_for(:etape), " - "]) if content_for?(:etape) %>
<%= render "entete_page", titre: "Nous contacter" %>
<% content_for :description, "Proposition de contenu, signalement d’une erreur, question : répondez à quelques questions pour être orienté vers la bonne réponse ou le bon contact." %>
<% content_for :robots, "noindex" if @besoin %>

<div class="fr-container fr-mb-8w">
  <h1>Nous contacter</h1>

  <section class="fr-grid-row" aria-label="Orienter votre demande">
    <div class="fr-col-12 fr-col-lg-8 fr-background-alt--grey fr-p-4w">
      <%= etape %>
    </div>
  </section>
</div>
