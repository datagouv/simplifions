<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<% pages = [root_url, demarches_url, solutions_url, articles_url, about_url, doctrine_referencement_cas_usages_url,
            doctrine_referencement_solutions_url, niveaux_simplification_url, terms_url, accessibility_url, sitemap_url]
   pages += Article.all.map { |article| article_url(article.slug) }
   pages.each do |url| %>
  <url>
    <loc><%= url %></loc>
  </url>
<% end %>
<% { @demarches => :demarche_url, @solutions => :solution_url }.each do |fiches, route| %>
<% fiches.each do |fiche| %>
  <url>
    <loc><%= public_send(route, fiche.slug) %></loc>
    <% if fiche.modifie_le %><lastmod><%= fiche.modifie_le.to_date %></lastmod><% end %>
  </url>
<% end %>
<% end %>
</urlset>
