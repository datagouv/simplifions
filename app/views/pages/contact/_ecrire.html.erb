<% email = Rails.configuration.x.contact_email %>
<% sujet = objet_du_message(objet) %>
<% corps = corps_du_message(informations) %>
<% corps_du_lien = corps_du_message(informations.map { |libelle, _options| libelle }) %>
<h3 class="fr-h6">Informations à nous transmettre :</h3>
<ul class="fr-mb-4w">
  <% informations.each do |libelle, _options| %>
    <li><%= libelle %></li>
  <% end %>
</ul>

<div class="fr-mt-4w">
  <h3 class="fr-h6">Écrire à l'équipe</h3>
  <p class="contact-adresse">Envoyez votre message à <strong><%= email %></strong></p>
  <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-md fr-btns-group--icon-left fr-mb-3w">
    <li>
      <%= mail_to email, "Écrire à l'équipe", subject: sujet, body: corps_du_lien.gsub("\n", "\r\n"),
            class: "fr-btn fr-btn--icon-left fr-icon-mail-line" %>
    </li>
  </ul>
  <div class="fr-input-group">
    <label class="fr-label" for="objet-message">Objet du message</label>
    <input class="fr-input" id="objet-message" type="text" readonly value="<%= sujet %>">
  </div>
  <label class="fr-label" for="modele-message">Modèle de message</label>
  <textarea class="fr-input" id="modele-message" rows="<%= corps.lines.size + 1 %>" readonly><%= corps %></textarea>
</div>
