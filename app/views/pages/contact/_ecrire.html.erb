<% fiche = local_assigns[:fiche] %>
<% email = Rails.configuration.x.contact_email %>
<% sujet = objet_du_message(objet, fiche) %>
<% corps = corps_du_message(informations, fiche) %>
<% corps_du_lien = corps_du_message(informations.map { |libelle, _options| libelle }, fiche) %>


<div class="fr-mt-4w" data-controller="copier">
  <p class="fr-text--lg">Utilisez le modèle d'e-mail ci-dessous pour nous transmettre les informations qui nous seront utiles pour comprendre votre proposition.</p>

  <div class="fr-background-default--grey fr-p-2w">
    <h3 class="fr-text--md fr-mb-1w">Utiliser le mail prêt à l'emploi :</h3>
    <p>Ce bouton ouvre votre messagerie avec l'adresse, l'objet et les rubriques du message déjà remplis.</p>
    <div class="fr-btns-group fr-btns-group--sm fr-btns-group--inline fr-btns-group--right fr-btns-group--icon-left">
      <%= mail_to email, "Ouvrir un e-mail déjà pré-rempli", subject: sujet, body: corps_du_lien.gsub("\n", "\r\n"),
            class: "fr-btn fr-btn--sm fr-btn--tertiary fr-background-default--grey fr-icon-mail-line fr-btn--icon-left fr-mb-0" %>
    </div>
  </div>

  <p class="contact-separateur fr-my-3w">Ou</p>

  <div class="fr-background-default--grey fr-p-2w">
    <h3 class="fr-text--md fr-mb-1w">Copier/coller le modèle pour écrire vous-même le mail :</h3>
    <% [["adresse-message", "E-mail de Simplifions.data :", email, "Copier l'e-mail", "E-mail copié."],
        ["objet-message", "Objet du mail :", sujet, "Copier l'objet", "Objet du mail copié."],
        ["modele-message", "Modèle de mail :", corps, "Copier le modèle", "Modèle de mail copié."]].each do |id, intitule, texte, bouton, confirmation| %>
      <div class="fr-mt-3w">
        <p class="fr-text--sm fr-text--bold fr-mb-1w"><%= intitule %></p>
        <div class="contact-bloc-a-copier fr-background-alt--grey fr-p-2w">
          <button type="button" class="fr-btn fr-btn--sm fr-btn--tertiary fr-background-default--grey fr-icon-clipboard-line fr-btn--icon-left fr-hidden"
            data-copier-target="bouton" data-action="copier#copier"
            data-copier-texte-param="<%= texte %>" data-copier-confirmation-param="<%= confirmation %>"><%= bouton %></button>
          <div id="<%= id %>" class="contact-a-copier"><%= texte %></div>
        </div>
      </div>
    <% end %>
  </div>
  <p class="fr-sr-only" aria-live="polite" data-copier-target="statut"></p>
</div>
