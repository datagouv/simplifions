<h3 class="fr-h6">Informations à nous transmettre :</h3>
<ul class="fr-mb-4w">
  <% if fiche %>
    <li>Fiche concernée : <%= link_to fiche.nom, fiche.url %></li>
  <% end %>
  <% besoin.informations.each do |information| %>
    <%# Les options possibles ne figurent que dans le modèle de message, à ajuster par l'usager. %>
    <li><%= information.libelle %></li>
  <% end %>
</ul>

<% if params[:adresse].blank? %>
  <%# L'adresse n'est jamais dans une page atteinte par un simple lien : il faut soumettre ce formulaire. %>
  <%= form_with url: contact_path(anchor: "ecrire"), method: :get, local: true do %>
    <%= hidden_field_tag :besoin, besoin.cle, id: nil %>
    <% if fiche %>
      <%= hidden_field_tag :page, @page, id: nil %>
    <% end %>
    <%= hidden_field_tag :adresse, 1, id: nil %>
    <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-md fr-btns-group--icon-right">
      <li><button type="submit" class="fr-btn fr-btn--icon-right fr-icon-mail-line">Afficher l'adresse e-mail</button></li>
    </ul>
  <% end %>
<% else %>
  <div id="ecrire" class="fr-mt-4w" data-controller="copier">
    <h3 class="fr-h6">Écrire à l'équipe</h3>
    <% if (email = Rails.configuration.x.contact_email) %>
      <p class="contact-adresse">
        Envoyez votre message à <strong><%= email %></strong>
        <button type="button" class="fr-btn fr-btn--sm fr-btn--tertiary-no-outline fr-icon-clipboard-line" hidden
          title="Copier l'adresse" data-copier-target="bouton" data-action="copier#copier"
          data-copier-texte-param="<%= email %>" data-copier-confirmation-param="Adresse copiée.">Copier l'adresse</button>
      </p>
      <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-md fr-btns-group--icon-left fr-mb-3w">
        <li>
          <button type="button" class="fr-btn fr-btn--secondary fr-icon-clipboard-line fr-btn--icon-left" hidden
            data-copier-target="bouton" data-action="copier#copier"
            data-copier-texte-param="<%= besoin.objet_complet(fiche:) %>" data-copier-confirmation-param="Objet du message copié.">Copier l'objet du message</button>
        </li>
        <li>
          <button type="button" class="fr-btn fr-btn--secondary fr-icon-clipboard-line fr-btn--icon-left" hidden
            data-copier-target="bouton" data-action="copier#copier"
            data-copier-confirmation-param="Modèle de message copié.">Copier le modèle de message</button>
        </li>
        <li>
          <%= mail_to email, "Écrire à l'équipe", subject: besoin.objet_complet(fiche:), body: besoin.corps_mail(fiche:),
                class: "fr-btn fr-btn--icon-left fr-icon-mail-line" %>
        </li>
      </ul>
      <p class="fr-sr-only" aria-live="polite" data-copier-target="statut"></p>
      <div class="fr-input-group">
        <label class="fr-label" for="objet-message">Objet du message</label>
        <input class="fr-input" id="objet-message" type="text" readonly value="<%= besoin.objet_complet(fiche:) %>">
      </div>
      <label class="fr-label" for="modele-message">Modèle de message</label>
      <textarea class="fr-input" id="modele-message" rows="<%= besoin.corps_mail(fiche:).lines.size + 1 %>" readonly
        data-copier-target="source"><%= besoin.corps_mail(fiche:) %></textarea>
    <% else %>
      <p>Adresse de contact indisponible pour le moment. Merci de réessayer plus tard.</p>
    <% end %>
  </div>
<% end %>
