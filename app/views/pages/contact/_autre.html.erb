<%= render "pages/contact/retour", vers: contact_path %>
<%= render "pages/contact/titre", titre: "Autre sujet" %>
<div class="fr-callout fr-callout--beige-gris-galet fr-mb-4w">
  <p class="fr-callout__text fr-text--md">
    Veuillez vérifier que votre demande ne concerne aucun des sujets suivants :
  </p>
  <ul class="fr-callout__text fr-text--md">
    <li><%= link_to "Proposer ou corriger un contenu du site", contact_path("contenu") %></li>
    <li><%= link_to "J'ai une question sur ma propre démarche administrative", contact_path("demarche-personnelle") %></li>
    <li><%= link_to "J'ai une question sur une API ou un jeu de données", contact_path("question-api") %></li>
    <li><%= link_to "Signaler un problème technique ou d'accessibilité sur le site", contact_path("probleme-site") %></li>
  </ul>
</div>
<%= render "pages/contact/ecrire", objet: "Prise de contact - autre sujet", informations: [
      "Votre organisation et votre fonction",
      "L'objet de votre demande"
    ] %>
