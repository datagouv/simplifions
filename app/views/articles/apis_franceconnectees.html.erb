      apis_franceconnectees = [
        { title: "API Quotient familial MSA & CAF | Bouquet API Particulier", url: "https://www.data.gouv.fr/fr/dataservices/672cf982fcc8065be6e66f54", org: "Direction interministérielle du numérique", logo: "https://udata-avatars.s3.rbx.io.cloud.ovh.net/a0/16eb04d7754b989b7dcd21d77699bd-100.png", restricted: true, description: "L'API Quotient familial CAF & MSA | Bouquet API Particulier permet de récupérer le quotient familial CAF ou MSA d'un particulier et d'obtenir les données d'identité de l'allocataire et de…" },
        { title: "API Statut étudiant | Bouquet API Particulier", url: "https://www.data.gouv.fr/fr/dataservices/672cf667c3488a0c533f7092", org: "Ministère de l'Enseignement supérieur, de la Recherche et de l'Espace", logo: "https://udata-avatars.s3.rbx.io.cloud.ovh.net/a9/d7c102fb7e40e4a7506fb1274170ce-100.png", restricted: true, description: "L'API Statut étudiant | Bouquet API Particulier permet de savoir si un particulier est étudiant, de récupérer la liste des inscriptions et admissions d’un étudiant, en précisant les dates…" },
        { title: "API Statut étudiant boursier | Bouquet API Particulier", url: "https://www.data.gouv.fr/fr/dataservices/672cf6900a2a1df94c9cc37c", org: "Direction interministérielle du numérique", logo: "https://udata-avatars.s3.rbx.io.cloud.ovh.net/a0/16eb04d7754b989b7dcd21d77699bd-100.png", restricted: true, description: "L'API Statut étudiant boursier | Bouquet API Particulier permet notamment de savoir si un étudiant est boursier(bourses d'État et quelques bourses régionales) et de connaître son échelon de…" },
        { title: "API Statut revenu de solidarité active (RSA) | Bouquet API Particulier", url: "https://www.data.gouv.fr/fr/dataservices/672cf6acf1ebb86a67488d05", org: "Direction interministérielle du numérique", logo: "https://udata-avatars.s3.rbx.io.cloud.ovh.net/a0/16eb04d7754b989b7dcd21d77699bd-100.png", restricted: true, description: "L'API Statut revenu de solidarité active (RSA) | Bouquet API Particulier permet de savoir si un particulier est bénéficiaire du revenu de solidarité active (RSA), majoré ou non." },
        { title: "API Statut prime d'activité | Bouquet API Particulier", url: "https://www.data.gouv.fr/fr/dataservices/672cf6acc34230c996aab5a5", org: "Direction interministérielle du numérique", logo: "https://udata-avatars.s3.rbx.io.cloud.ovh.net/a0/16eb04d7754b989b7dcd21d77699bd-100.png", restricted: true, description: "L'API Statut prime d'activité | Bouquet API Particulier permet de savoir si un particulier est bénéficiaire de la prime d'activité, majorée ou non." },
        { title: "API Statut allocation adulte handicapé (AAH) | Bouquet API Particulier", url: "https://www.data.gouv.fr/fr/dataservices/672cf6ada37a79f6ff3e3254", org: "Direction interministérielle du numérique", logo: "https://udata-avatars.s3.rbx.io.cloud.ovh.net/a0/16eb04d7754b989b7dcd21d77699bd-100.png", restricted: true, description: "L'API Statut allocation adulte handicapé (AAH) | Bouquet API Particulier permet de savoir si un particulier est bénéficiaire de l'allocation adulte handicapé." },
        { title: "API Statut allocation de soutien familial (ASF) | Bouquet API Particulier", url: "https://www.data.gouv.fr/fr/dataservices/672cf6adce89cb14e31f0fb9", org: "Direction interministérielle du numérique", logo: "https://udata-avatars.s3.rbx.io.cloud.ovh.net/a0/16eb04d7754b989b7dcd21d77699bd-100.png", restricted: true, description: "L'API Statut allocation de soutien familial (ASF) | Bouquet API Particulier permet de savoir si un particulier est bénéficiaire d'allocation de soutien familial." },
        { title: "API Complémentaire santé solidaire | Bouquet API Particulier", url: "https://www.data.gouv.fr/fr/dataservices/672cf65bd5e4c56502e38b6b", org: "Direction interministérielle du numérique", logo: "https://udata-avatars.s3.rbx.io.cloud.ovh.net/a0/16eb04d7754b989b7dcd21d77699bd-100.png", restricted: true, description: "L'API Complémentaire santé solidaire | Bouquet API Particulier permet de savoir si un particulier est bénéficiaire de la complémentaire santé solidaire (C2S)." },
        { title: "API Service national - DSNJ | Bouquet API Particulier", url: "https://www.data.gouv.fr/fr/dataservices/688c7cbf284f92bdeff43a73", org: "Direction interministérielle du numérique", logo: "https://udata-avatars.s3.rbx.io.cloud.ovh.net/a0/16eb04d7754b989b7dcd21d77699bd-100.png", restricted: true, description: "L'API Statut prime d'activité | Bouquet API Particulier permet de savoir si le jeune est en règle vis à vis de ses obligations de Service national." },
        { title: "API Participation familiale EAJE | Bouquet API Particulier", url: "https://www.data.gouv.fr/fr/dataservices/688c833e18a96f3fcd04d82e", org: "Direction interministérielle du numérique", logo: "https://udata-avatars.s3.rbx.io.cloud.ovh.net/a0/16eb04d7754b989b7dcd21d77699bd-100.png", restricted: true, description: "L'API Participation familiale EAJE | Bouquet API Particulier permet de connaître pour un particulier les différents paramètres entant dans le calcul de la participation familiale." },
        { title: "API Impôt particulier", url: "https://www.data.gouv.fr/fr/dataservices/672cf984cbc098058850c092", org: "Ministères économiques et financiers", logo: "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6-100.jpg", restricted: true, description: "L'API Impôt particulier simplifie les démarches des usagers et le processus de gestion de vos téléservices. Elle permet l’échange d’informations fiscales entre la DGFiP et une entité…" },
        { title: "Extrait d'immatriculation véhicule | Bouquet API Particulier", url: "https://www.data.gouv.fr/fr/dataservices/6941379e0923b854aa9bf30d", org: "Direction interministérielle du numérique", logo: "https://udata-avatars.s3.rbx.io.cloud.ovh.net/a0/16eb04d7754b989b7dcd21d77699bd-100.png", restricted: true, description: "L''API Extrait d'immatriculation du véhicule délivre, à destination exclusive des collectivités dans le cadre de la tarification du stationnement résidentiel, l'extrait d'immatriculation du…" },
