<% content_for :title, "Articles" %>
<% content_for :description, "Guides et explications pour comprendre et intégrer les API utiles à la simplification de vos démarches." %>

<div class="fr-container fr-py-8v" data-matomo-zone="Articles › Liste">
  <h1>Articles</h1>

  <div class="fr-grid-row fr-grid-row--gutters" data-controller="filtres-catalogue">
    <aside class="fr-col-12 fr-col-lg-3">
      <%= form_with url: articles_path(anchor: "resultats"), method: :get,
            data: { action: "submit->filtres-catalogue#retenir formdata->filtres-catalogue#nettoyer turbo:before-fetch-request->filtres-catalogue#nettoyer" } do |f| %>
        <% Article::KEYWORD_CATEGORIES.each do |category, category_keywords| %>
          <%= render "facette_tags", f:, id: category.parameterize, label: "#{category} :",
                tags: tags_des_articles(@selected_keywords, category, category_keywords) %>
        <% end %>
      <% end %>
    </aside>

    <div class="fr-col-12 fr-col-lg-9">
      <% if @articles.empty? %>
        <%= render "resultats_vides", chemin: articles_path %>
      <% else %>
        <%= render "compteur_de_resultats", total: @articles.size, tout: Article::ALL.size, mot: "article", classe: "fr-mb-2w" %>
        <div class="fr-grid-row fr-grid-row--gutters">
          <% @articles.each do |article| %>
            <div class="fr-col-12 fr-col-md-6 fr-col-lg-4">
              <%= render ArticleCardComponent.new(article: article) %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
