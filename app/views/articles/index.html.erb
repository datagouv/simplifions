<% content_for :title, "Articles" %>
<% content_for :description, "Guides et explications pour comprendre et intégrer les API utiles à la simplification de vos démarches." %>

<div class="fr-container fr-py-8v" data-matomo-zone="Articles › Liste">
  <h1>Articles</h1>

  <div class="fr-grid-row fr-grid-row--gutters">
    <aside class="fr-col-12 fr-col-lg-3">
      <%= form_with url: articles_path, method: :get,
            data: { controller: "filtres-catalogue",
                    action: "submit->filtres-catalogue#retenir formdata->filtres-catalogue#nettoyer turbo:before-fetch-request->filtres-catalogue#nettoyer" } do |f| %>
      <% Article::KEYWORD_CATEGORIES.each do |category, category_keywords| %>
        <div class="fr-mb-3w">
          <p class="fr-text--bold fr-mb-1w"><%= category %></p>
          <ul class="fr-tags-group fr-mb-0">
            <% category_keywords.each do |keyword| %>
              <%
                selected = @selected_keywords.include?(keyword)
                toggled = selected ? @selected_keywords - [ keyword ] : @selected_keywords + [ keyword ]
                count = Article.all.count { |a| a.matches?(@selected_keywords, except_category: category) && a.keywords.include?(keyword) }
              %>
              <li>
                <% if count.zero? && !selected %>
                  <button type="button" class="fr-tag" disabled><%= keyword %> (0)</button>
                <% else %>
                  <%= f.button "#{keyword} (#{count})", name: "keywords", value: toggled.join(","),
                        class: "fr-tag", aria: { pressed: selected },
                        data: { matomo_action: "Filtrer par mot-clé", matomo_fermeture: "Retirer un mot-clé", matomo_nom: keyword } %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <% end %>
    </aside>

    <div class="fr-col-12 fr-col-lg-9">
      <% if @articles.empty? %>
        <p class="fr-text--lg">Aucun article ne correspond aux tags sélectionnés.</p>
      <% else %>
        <div class="fr-grid-row fr-grid-row--gutters">
          <% @articles.each do |article| %>
            <div class="fr-col-12 fr-col-md-6 fr-col-lg-4">
              <%= render ArticleCardComponent.new(article: article) %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
